# Curated repository-local allowlist. Mutations with secrets, persistence,
# destructive effects, administration, or direct-main risk require review.

# Read-only repository orientation and inspection.
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")
prefix_rule(pattern=["git", "ls-files"], decision="allow")
prefix_rule(pattern=["git", "worktree", "list"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")

# Focused verification.
prefix_rule(pattern=["uv", "run", "pytest"], decision="allow")
prefix_rule(pattern=["python", ".github/scripts/generate_agents_bootstrap.py", "--check"], decision="allow")

# Local PR preparation and GitHub review transport. Pushes remain gated because
# this rules format cannot enforce that an arbitrary ref is not main.
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "pr", "checks"], decision="allow")
prefix_rule(pattern=["gh", "pr", "create", "--draft"], decision="allow")
