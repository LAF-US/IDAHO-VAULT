#!/usr/bin/env bash
#
# Compatibility wrapper for the Python-native SPARKSEED bootstrap.
# The older shell liturgy can stay in the room, but the actual work now lives in
# start_SPARKSEED.py so the launch path matches the rest of the vault.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
elif command -v python >/dev/null 2>&1; then
    PYTHON_BIN="python"
else
    echo "SPARKSEED failed: Python was not found on PATH." >&2
    exit 1
fi

exec "${PYTHON_BIN}" "${SCRIPT_DIR}/start_SPARKSEED.py" "$@"
