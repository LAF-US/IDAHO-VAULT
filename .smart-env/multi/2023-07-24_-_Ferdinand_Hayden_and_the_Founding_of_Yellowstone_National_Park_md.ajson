
"smart_sources:2023-07-24 - Ferdinand Hayden and the Founding of Yellowstone National Park.md": {"path":"2023-07-24 - Ferdinand Hayden and the Founding of Yellowstone National Park.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"ahq40i","at":1785795029163},"class_name":"SmartSource","last_import":{"mtime":1784585484934,"size":8400,"at":1785795029196,"hash":"ahq40i"},"blocks":{"#---frontmatter---":[1,8],"#":[9,41]},"outlinks":[{"title":"Caldera","target":"https://www.usgs.gov/glossary/volcano-hazards-program-glossary","line":9},{"title":"governor of Louisiana Territory described a map drawn on a bison hide by an indigenous American showing a “volcano” on the Yellowstone River","target":"https://www.usgs.gov/news/early-recognition-yellowstones-volcanic-character","line":11},{"title":"first organized expeditions to what is now Yellowstone National Park did not occur until the 1860s–1870s","target":"https://www.usgs.gov/observatories/yvo/news/exploration-yellowstone","line":11},{"title":"land of the burning ground","target":"https://www.usgs.gov/observatories/yvo/news/land-burning-ground-history-and-traditions-indigenous-people-yellowstone","line":11},{"title":"formal portrait of caucasian man with full beard, wearing a 19th century suit and bow tie","target":"https://d9-wret.s3.us-west-2.amazonaws.com/assets/palladium/production/s3fs-public/styles/side_image/public/thumbnails/image/FVHayden%20portrait_1870.jpg?itok=pKQHsgbK","line":13,"embedded":true},{"title":"founding of Yellowstone National Park","target":"https://www.usgs.gov/observatories/yvo/news/benefit-and-enjoyment-people-explorations-led-worlds-first-national-park","line":17},{"title":"Geological Report of the Exploration of the Yellowstone and Missouri Rivers in 1859–1860","target":"https://books.google.com/books?id=urgQAAAAIAAJ&printsec=frontcover&source=gbs_ViewAPI#v=onepage&q&f=false \"(opens in a new window","line":19},{"title":"MA","target":"https://www.usgs.gov/glossary/volcano-hazards-program-glossary","line":19},{"title":"built a boat, *Annie*, to explore islands and take bathymetric measurements","target":"https://www.usgs.gov/observatories/yvo/news/henry-wood-elliott-and-first-map-yellowstone-lake","line":25},{"title":"image related to volcanoes. See description","target":"https://d9-wret.s3.us-west-2.amazonaws.com/assets/palladium/production/s3fs-public/styles/side_image/public/img7909.jpg?itok=zwrcZgcZ","line":27,"embedded":true},{"title":"drainage","target":"https://www.usgs.gov/glossary/volcano-hazards-program-glossary","line":31},{"title":"maps of the region","target":"https://www.usgs.gov/observatories/yvo/news/first-geological-map-yellowstone-national-park","line":37}],"metadata":{"title":"Ferdinand Hayden and the Founding of Yellowstone National Park","source":"https://www.usgs.gov/observatories/yvo/news/ferdinand-hayden-and-founding-yellowstone-national-park","author":null,"published":"2023-07-24","created":"2026-07-20","description":"Geologist Ferdinand Hayden directed the first scientific exploration of Yellowstone in 1871, leading directly to the founding of the world’s first national park in the following year. Hayden’s noteworthy achievements in science and conservation, however, are clouded by his views of indigenous people."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},