
"smart_sources:2026-05-11 - Feds officially cancel conservation rule for public lands, including 13.5M acres in New Mexico • Idaho Capital Sun.md": {"path":"2026-05-11 - Feds officially cancel conservation rule for public lands, including 13.5M acres in New Mexico • Idaho Capital Sun.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1xg5kk","at":1785795032680},"class_name":"SmartSource","last_import":{"mtime":1783543867311,"size":5492,"at":1785795032776,"hash":"1xg5kk"},"blocks":{"#---frontmatter---":[1,8],"##Feds officially cancel conservation rule for public lands, including 13.5M acres in New Mexico":[9,39],"##Feds officially cancel conservation rule for public lands, including 13.5M acres in New Mexico#{1}":[11,39]},"outlinks":[{"title":"The U.S. Bureau of Land Management on May 11, 2026, officially rescinded a federal rule requiring officials to consider conservation in land management decisions in areas such as the Valley of Fires in south-central New Mexico, pictured above in 2021. (Photo courtesy BLM)","target":"https://idahocapitalsun.com/wp-content/uploads/2026/05/52663977775_909548a87d_4k-1024x499-1.jpg","line":13,"embedded":true},{"title":"notice","target":"https://public-inspection.federalregister.gov/2026-09386.pdf","line":21},{"title":"eliminating the rule","target":"https://sourcenm.com/2025/09/16/by-the-s-the-wild-areas-one-advocacy-group-says-face-most-threats-under-public-lands-rule-repeal/","line":21},{"title":"Conservation and Landscape Health Rule","target":"https://www.federalregister.gov/documents/2025/09/11/2025-17537/rescission-of-conservation-and-landscape-health-rule","line":21},{"title":"officials","target":"https://public-inspection.federalregister.gov/2026-09386.pdf","line":25},{"title":"commercial uses of public lands.","target":"https://sourcenm.com/2025/06/23/usda-secretary-in-santa-fe-announces-agency-intends-to-repeal-clinton-era-roadless-rule/","line":25},{"title":"drilling","target":"https://sourcenm.com/2026/04/01/new-mexico-officials-tribes-accuse-feds-of-rushing-efforts-to-reverse-chaco-canyon-drilling-ban/","line":25},{"title":"Source New Mexico","target":"https://sourcenm.com/briefs/feds-officially-cancel-conservation-rule-for-public-lands/","line":39}],"metadata":{"title":"Feds officially cancel conservation rule for public lands, including 13.5M acres in New Mexico • Idaho Capital Sun","source":"https://idahocapitalsun.com/2026/05/11/repub/feds-officially-cancel-conservation-rule-for-public-lands/?emci=b6f5aa16-914d-f111-8ef2-000d3a14b640&emdi=3ccb881a-fa4d-f111-8ef2-000d3a14b640&ceid=110103","author":null,"published":"2026-05-11","created":"2026-07-08","description":"The Bureau of Land Management, which oversees 13.5 million acres in New Mexico, said Monday it was officially nixing the \"Public Land Rule.\""},"task_lines":[],"tasks":{},"codeblock_ranges":[]},