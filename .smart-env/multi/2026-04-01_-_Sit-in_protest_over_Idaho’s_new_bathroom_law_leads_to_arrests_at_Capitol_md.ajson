
"smart_sources:2026-04-01 - Sit-in protest over Idaho’s new bathroom law leads to arrests at Capitol.md": {"path":"2026-04-01 - Sit-in protest over Idaho’s new bathroom law leads to arrests at Capitol.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"eso6ss","at":1785795031880},"class_name":"SmartSource","last_import":{"mtime":1783469781098,"size":5493,"at":1785795031994,"hash":"eso6ss"},"blocks":{"#---frontmatter---":[1,10],"#":[11,51]},"outlinks":[{"title":"Kevin Fixler","target":"Kevin Fixler","line":5},{"title":"Becca Savransky","target":"Becca Savransky","line":6},{"title":"A person flies a transgender pride flag outside of the Idaho Capitol in Boise during a Trans Day of Visibility rally, Tuesday, March 31, 2026.","target":"https://www.idahostatesman.com/public/latest-news/umc0c/picture315257128/alternates/LANDSCAPE_1200/BOI_033104transvisibility.JPG","line":11,"embedded":true},{"title":"House Bill 752","target":"https://legislature.idaho.gov/sessioninfo/2026/legislation/H0752","line":21},{"title":"criminalizes people using public toilets","target":"https://www.idahostatesman.com/news/politics-government/state-politics/article315183268.html","line":21},{"title":"Little signed a bill","target":"https://www.idahostatesman.com/news/politics-government/state-politics/article315257130.html","line":21},{"title":"news release","target":"https://isp.idaho.gov/idaho-state-police-respond-to-trespass-incident-at-idaho-capitol-building","line":23},{"title":"Protesters staged a sit-in demonstration at the office of Gov. Brad Little on Wednesday in the Idaho Capitol. Little’ recently signed a bill passed by the Legislature that criminalizes people using public bathrooms that don’t match their sex assigned at birth.","target":"https://www.idahostatesman.com/public/latest-news/qgamwo/picture315271614/alternates/FREE_1200/Capitol%20Protest_4-1-26%20vertical.jpg","line":27,"embedded":true},{"title":"House Bill 822","target":"https://legislature.idaho.gov/sessioninfo/2026/legislation/H0822","line":45}],"metadata":{"title":"Sit-in protest over Idaho’s new bathroom law leads to arrests at Capitol","source":"https://www.idahostatesman.com/news/politics-government/state-politics/article315271522.html#campaignName=boise_politics_newsletter","author":["[[Kevin Fixler]]","[[Becca Savransky]]"],"published":"2026-04-01","created":"2026-07-07","description":"“ISP supports the public’s fundamental right to express opinions and engage in lawful protest,” Idaho State Police said."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},