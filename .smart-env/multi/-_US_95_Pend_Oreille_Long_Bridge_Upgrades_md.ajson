
"smart_sources:- US 95 Pend Oreille Long Bridge Upgrades.md": {"path":"- US 95 Pend Oreille Long Bridge Upgrades.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1r5tka2","at":1785794996020},"class_name":"SmartSource","last_import":{"mtime":1783983919518,"size":3304,"at":1785794996630,"hash":"1r5tka2"},"blocks":{"#---frontmatter---":[1,8],"#":[9,43]},"outlinks":[],"metadata":{"title":"US 95 Pend Oreille Long Bridge Upgrades","source":"https://www.mcmillen.com/projects/us-95-pend-oreille-bridge-upgrades","author":null,"published":null,"created":"2026-07-13","description":"McMillen provided award-winning upgrades to the US 95 Pend Oreille Long Bridge, a vital lifeline connecting the communities of Sagle and Sandpoint, ID. This revitalization project not only extended the bridge's service life by a century but also brought critical safety enhancements and improved access for pedestrians and the nearly 20,000 vehicles that rely on it daily. Through meticulous planning and execution, McMillen exceeded project schedules, completing the work in just one construction season instead of the anticipated two. Our unwavering commitment to safety, demonstrated by our robust safety program ensured zero recordable accidents or injuries from start to finish."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:- US 95 Pend Oreille Long Bridge Upgrades.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"14i2gbl","at":1785794996020},"key":"- US 95 Pend Oreille Long Bridge Upgrades.md#---frontmatter---","lines":[1,8],"size":873,"outlinks":[],"class_name":"SmartBlock"},
