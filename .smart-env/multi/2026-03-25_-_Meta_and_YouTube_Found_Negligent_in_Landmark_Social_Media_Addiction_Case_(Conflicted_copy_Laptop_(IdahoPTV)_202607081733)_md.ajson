
"smart_sources:2026-03-25 - Meta and YouTube Found Negligent in Landmark Social Media Addiction Case (Conflicted copy Laptop (IdahoPTV) 202607081733).md": {"path":"2026-03-25 - Meta and YouTube Found Negligent in Landmark Social Media Addiction Case (Conflicted copy Laptop (IdahoPTV) 202607081733).md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"5p38kf","at":1785795031789},"class_name":"SmartSource","last_import":{"mtime":1783553594112,"size":11614,"at":1785795031875,"hash":"5p38kf"},"blocks":{"#---frontmatter---":[1,11],"#":[12,96]},"outlinks":[{"title":"Cecilia Kang","target":"Cecilia Kang","line":5},{"title":"Ryan Mac","target":"Ryan Mac","line":6},{"title":"Eli Tan","target":"Eli Tan","line":7},{"title":"Luis Li, the attorney representing YouTube and Google, arrives at the court after the jury reached a verdict in the bellwether case.","target":"https://static01.nyt.com/images/2026/03/25/multimedia/25biz-social-media-verdict-youtube-gjmk/25biz-social-media-verdict-youtube-gjmk-superJumbo.jpg","line":20,"embedded":true},{"title":"ruling this week by a New Mexico jury","target":"https://www.nytimes.com/2026/03/24/technology/meta-new-mexico-child-safety-violations.html","line":28},{"title":"Raúl Torrez, New Mexico attorney general. Wednesday’s verdict follows a ruling by a New Mexico jury in a case brought by Mr. Torrez.","target":"https://static01.nyt.com/images/2026/03/25/multimedia/25biz-social-media-verdict-torrez-gkqb/25biz-social-media-verdict-torrez-gkqb-superJumbo.jpg","line":30,"embedded":true},{"title":"Parents of children whose deaths were related to social media involvement outside Los Angeles Superior Court last month, during Mr. Zuckerberg’s testimony.","target":"https://static01.nyt.com/images/2026/03/25/multimedia/25biz-social-media-verdict-parents-kvwb/25biz-social-media-verdict-parents-kvwb-superJumbo.jpg","line":38,"embedded":true},{"title":"reached a $206 billion master settlement","target":"https://www.nytimes.com/1998/11/14/us/cigarette-makers-and-states-draft-a-206-billion-deal.html","line":48},{"title":"called for adding warning labels","target":"https://www.nytimes.com/2024/06/17/opinion/social-media-health-warning.html","line":54},{"title":"barred children under 16 from using social media","target":"https://www.nytimes.com/2025/12/09/world/asia/australia-social-media-ban-under-16.html","line":54},{"title":"Mark Lanier, one of the attorneys representing K.G.M., the plaintiff in the social media case. ","target":"https://static01.nyt.com/images/2026/03/25/multimedia/25biz-social-media-verdict-atty-vzqk/25biz-social-media-verdict-atty-vzqk-superJumbo.jpg","line":66,"embedded":true}],"metadata":{"title":"Meta and YouTube Found Negligent in Landmark Social Media Addiction Case","source":"https://www.nytimes.com/2026/03/25/technology/social-media-trial-verdict.html?utm_source=Poynter+Institute&utm_campaign=a7bf74ab7a-03262026+-+The+Poynter+Report&utm_medium=email&utm_term=0_-a7bf74ab7a-428559043&mc_cid=a7bf74ab7a&mc_eid=dede88cc59","author":["[[Cecilia Kang]]","[[Ryan Mac]]","[[Eli Tan]]"],"published":"2026-03-25","created":"2026-07-07","description":"A jury found the companies harmed a young user with design features that were addictive and led to her mental health distress."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},