
"smart_sources:2022-01-07 - IDAHO_ A Climbing Guide - A 1940 Unplanned Bivouac on Borah.md": {"path":"2022-01-07 - IDAHO_ A Climbing Guide - A 1940 Unplanned Bivouac on Borah.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"494xym","at":1785795028783},"class_name":"SmartSource","last_import":{"mtime":1784062248469,"size":1037,"at":1785795028817,"hash":"494xym"},"blocks":{"#---frontmatter---":[1,7],"#":[8,12]},"outlinks":[{"title":"Tom Lopez","target":"Tom Lopez","line":4},{"title":"The Northwest Ridge is in the center of the photo. This ridge branches into two separate ridges lower down on the mountain, one into the Rock Creek drainage and the other forms the edge of the West Face. The Southwest (Chicken-Out) Ridge is on the right skyline. Photo by John Platt","target":"https://www.idahoaclimbingguide.com/wp-content/uploads/A9F89DDA-D8B5-487D-AE1A-8CB49B44BB6A-175x175.jpeg","line":8,"embedded":true},{"title":"![","target":"https://www.idahoaclimbingguide.com/wp-content/uploads/F78AED32-256D-41EA-8213-1C9E1AD2257A.jpeg","line":12}],"metadata":{"source":"https://www.idahoaclimbingguide.com/a-1940-unplanned-bivouac-on-borah/","author":["[[Tom Lopez]]"],"published":"2022-01-07","created":"2026-07-14"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},