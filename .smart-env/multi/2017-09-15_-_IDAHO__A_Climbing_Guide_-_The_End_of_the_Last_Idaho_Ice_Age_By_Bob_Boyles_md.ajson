
"smart_sources:2017-09-15 - IDAHO_ A Climbing Guide - The End of the Last Idaho Ice Age By Bob Boyles.md": {"path":"2017-09-15 - IDAHO_ A Climbing Guide - The End of the Last Idaho Ice Age By Bob Boyles.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"ikte45","at":1785795013635},"class_name":"SmartSource","last_import":{"mtime":1784062166764,"size":8695,"at":1785795013699,"hash":"ikte45"},"blocks":{"#---frontmatter---":[1,7],"#":[8,44]},"outlinks":[{"title":"Tom Lopez","target":"Tom Lopez","line":4},{"title":"Bruce’s description of the glacier talks about how it was over 200-feet thick, 1,000-feet wide and 1,200-feet long.","target":"http://scholarworks.boisestate.edu/cgi/viewcontent.cgi?filename=1&article=1024&context=focus&type=additional","line":16},{"title":"![North Face of Mt Borah - Oct, 1976. Photo by Bob Boyles","target":"https://www.idahoaclimbingguide.com/wp-content/uploads/NFace0002e.jpg","line":22},{"title":"![Mike Weber showing off his French technique on the lower ice fields of Mt Borah. If you look closely, you can see the old blue ice showing in places.  Bob BoylesBob Boyles photo","target":"https://www.idahoaclimbingguide.com/wp-content/uploads/NFace0003e.jpg","line":26},{"title":"![The remains of Bruce and Monte’s snow measuring gauge Sept, 2010 Photo by John Platt ","target":"https://www.idahoaclimbingguide.com/wp-content/uploads/otto_stuff_big-1.jpg","line":34},{"title":"![The North Face of Mt Borah Sept, 1990 – Photo by Curt Olson We were in shock when we saw this. The glacier and lower ice fields were almost gone. This was the last photo we got of the old blue ice that was estimated to be over 500 years old or more.","target":"https://www.idahoaclimbingguide.com/wp-content/uploads/NF-Borah0006.jpg","line":38},{"title":"As a result of that study","target":"http://glaciers.research.pdx.edu/Glaciers-Idaho#References","line":42},{"title":"Many high-elevation basins had more than twice the normal snowpack","target":"https://www.wcc.nrcs.usda.gov/ftpref/states/id/webftp/snow-indexes/BigLost_snow_graphs.pdf","line":44}],"metadata":{"source":"https://www.idahoaclimbingguide.com/end-last-idaho-ice-age-bob-boyles/","author":["[[Tom Lopez]]"],"published":"2017-09-15","created":"2026-07-14"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:2017-09-15 - IDAHO_ A Climbing Guide - The End of the Last Idaho Ice Age By Bob Boyles.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"ic0n40","at":1785795013635},"key":"2017-09-15 - IDAHO_ A Climbing Guide - The End of the Last Idaho Ice Age By Bob Boyles.md#---frontmatter---","lines":[1,7],"size":158,"outlinks":[{"title":"Tom Lopez","target":"Tom Lopez","line":4}],"class_name":"SmartBlock"},
