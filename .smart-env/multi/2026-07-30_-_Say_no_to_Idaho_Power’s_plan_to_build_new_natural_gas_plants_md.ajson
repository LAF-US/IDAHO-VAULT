ews.net/articles/want-to-build-a-gas-plant-get-in-line/","line":26},{"title":"air pollution","target":"https://www.selc.org/topic/methane-gas-threatens-southern-people-and-places/","line":26},{"title":"A/C Cool Credit","target":"https://www.idahopower.com/energy-environment/ways-to-save/savings-for-your-home/rebates-and-offers/ac-cool-credit/","line":30},{"title":"bids","target":"https://lf-puc.idaho.gov/WebLink/DocView.aspx?dbid=0&id=156095","line":32},{"title":"coal- and gas-free in less than 20 years","target":"https://lf-puc.idaho.gov/WebLink/DocView.aspx?dbid=0&id=156095","line":32},{"title":"public comment","target":"https://puc.idaho.gov/Form/CaseComment","line":34}],"metadata":{"title":"Say no to Idaho Power’s plan to build new natural gas plants","source":"https://www.idahostatesman.com/opinion/readers-opinion/article316703973.html#campaignName=boise_theidahoway_newsletter","author":["[[Lisa Young]]"],"published":"2026-07-30","created":"2026-07-31","description":"It’s clear that Idaho Power’s new gas plants are not in the public interest. The Public Utilities Commission should deny their approval. | Opinion","tags":["#idaho"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},