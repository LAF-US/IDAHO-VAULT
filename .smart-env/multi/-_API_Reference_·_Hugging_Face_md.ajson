
"smart_sources:- API Reference · Hugging Face.md": {"path":"- API Reference · Hugging Face.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"111fbq3","at":1785792234177},"class_name":"SmartSource","last_import":{"mtime":1778950975139,"size":4169,"at":1785792234361,"hash":"111fbq3"},"blocks":{"#---frontmatter---":[1,8],"##API Reference":[9,10],"##Popular tasks[Chat Completion](https://huggingface.co/docs/inference-providers/tasks/chat-completion)":[11,36],"##Popular tasks[Chat Completion](https://huggingface.co/docs/inference-providers/tasks/chat-completion)#{1}":[13,36],"##Other tasks[Audio Classification](https://huggingface.co/docs/inference-providers/tasks/audio-classification)":[37,129],"##Other tasks[Audio Classification](https://huggingface.co/docs/inference-providers/tasks/audio-classification)#{1}":[39,129]},"outlinks":[{"title":"Chat Completion","target":"https://huggingface.co/docs/inference-providers/tasks/chat-completion","line":11},{"title":"\n\nGenerate a response given a list of messages in a conversational context.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/chat-completion","line":13},{"title":"\n\nFeature Extraction\n\nConverting a text into a vector often called \"embedding\".\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/feature-extraction","line":17},{"title":"\n\nText to Image\n\nGenerate an image based on a given text prompt.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/text-to-image","line":23},{"title":"\n\nText to Video\n\nGenerate an video based on a given text prompt.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/text-to-video","line":29},{"title":"Audio Classification","target":"https://huggingface.co/docs/inference-providers/tasks/audio-classification","line":37},{"title":"\n\nAudio classification is the task of assigning a label or class to a given audio.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/audio-classification","line":39},{"title":"\n\nAutomatic Speech Recognition\n\nAutomatic Speech Recognition (ASR), also known as Speech to Text (STT), is the task of transcribing a given audio to text.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/automatic-speech-recognition","line":43},{"title":"\n\nFill Mask\n\nMask filling is the task of predicting the right word (token to be precise) in the middle of a sequence.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/fill-mask","line":49},{"title":"\n\nImage Classification\n\nImage classification is the task of assigning a label or class to an entire image. Images are expected to have only one class for each image.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/image-classification","line":55},{"title":"\n\nImage Segmentation\n\nImage Segmentation divides an image into segments where each pixel in the image is mapped to an object.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/image-segmentation","line":61},{"title":"\n\nImage to Image\n\nImage-to-image is the task of transforming a source image to match the characteristics of a target image or a target image domain.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/image-to-image","line":67},{"title":"\n\nObject Detection\n\nObject Detection models allow users to identify objects of certain defined classes.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/object-detection","line":73},{"title":"\n\nQuestion Answering\n\nQuestion Answering models can retrieve the answer to a question from a given text, which is useful for searching for an answer in a document.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/question-answering","line":79},{"title":"\n\nSummarization\n\nSummarization is the task of producing a shorter version of a document while preserving its important information.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/summarization","line":85},{"title":"\n\nTable Question Answering\n\nTable Question Answering (Table QA) is the answering a question about an information on a given table.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/table-question-answering","line":91},{"title":"\n\nText Classification\n\nText Classification is the task of assigning a label or class to a given text.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/text-classification","line":97},{"title":"\n\nText Generation\n\nGenerate text based on a prompt.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/text-generation","line":103},{"title":"\n\nToken Classification\n\nToken classification is a task in which a label is assigned to some tokens in a text.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/token-classification","line":109},{"title":"\n\nTranslation\n\nTranslation is the task of converting text from one language to another.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/translation","line":115},{"title":"\n\nZero Shot Classification\n\nZero shot classification is the task to classify text without specific training for the task.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/zero-shot-classification","line":121},{"title":"Update on GitHub","target":"https://github.com/huggingface/hub-docs/blob/main/docs/inference-providers/tasks/index.md","line":129}],"metadata":{"title":"API Reference · Hugging Face","source":"https://huggingface.co/docs/inference-providers/tasks/index","author":null,"published":null,"created":"2026-04-26","description":"We’re on a journey to advance and democratize artificial intelligence through open source and open science."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:- API Reference · Hugging Face.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"7eg67p","at":1785792234177},"key":"- API Reference · Hugging Face.md#---frontmatter---","lines":[1,8],"size":277,"outlinks":[],"class_name":"SmartBlock"},
