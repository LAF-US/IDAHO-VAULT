12488,-0.00880445,0.20703645,-0.06164629,0.02576535,0.00448983,-0.05717153,0.00863813,0.06352275,0.00134501,0.03408578,-0.00596965,0.0873671,0.01057697,-0.01787708,0.0605536,-0.02753117,-0.01825255,0.00617494,0.00352537,0.0510774,-0.00721379,0.00732792,-0.0189522,0.04498954,-0.00666448,0.01175747,-0.04019801,-0.08691686,0.02885542,-0.01202698,-0.02454452,-0.01813687,-0.02786799,0.02352575,0.05582078,0.01007295,-0.00329253,-0.03416849,0.00987135,0.03953235,-0.04991526,-0.00535128,0.08744507,0.00469618],"last_embed":{"hash":"111fbq3","tokens":500}}},"last_read":{"hash":"111fbq3","at":1779498219204},"class_name":"SmartSource","last_import":{"mtime":1777391300051,"size":4169,"at":1779498006663,"hash":"111fbq3"},"last_embed":{"hash":"111fbq3","at":1779498218773},"blocks":{"#---frontmatter---":[1,8],"##API Reference":[9,10],"##Popular tasks[Chat Completion](https://huggingface.co/docs/inference-providers/tasks/chat-completion)":[11,36],"##Popular tasks[Chat Completion](https://huggingface.co/docs/inference-providers/tasks/chat-completion)#{1}":[13,36],"##Other tasks[Audio Classification](https://huggingface.co/docs/inference-providers/tasks/audio-classification)":[37,129],"##Other tasks[Audio Classification](https://huggingface.co/docs/inference-providers/tasks/audio-classification)#{1}":[39,129]},"outlinks":[{"title":"Chat Completion","target":"https://huggingface.co/docs/inference-providers/tasks/chat-completion","line":11},{"title":"\n\nGenerate a response given a list of messages in a conversational context.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/chat-completion","line":13},{"title":"\n\nFeature Extraction\n\nConverting a text into a vector often called \"embedding\".\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/feature-extraction","line":17},{"title":"\n\nText to Image\n\nGenerate an image based on a given text prompt.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/text-to-image","line":23},{"title":"\n\nText to Video\n\nGenerate an video based on a given text prompt.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/text-to-video","line":29},{"title":"Audio Classification","target":"https://huggingface.co/docs/inference-providers/tasks/audio-classification","line":37},{"title":"\n\nAudio classification is the task of assigning a label or class to a given audio.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/audio-classification","line":39},{"title":"\n\nAutomatic Speech Recognition\n\nAutomatic Speech Recognition (ASR), also known as Speech to Text (STT), is the task of transcribing a given audio to text.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/automatic-speech-recognition","line":43},{"title":"\n\nFill Mask\n\nMask filling is the task of predicting the right word (token to be precise) in the middle of a sequence.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/fill-mask","line":49},{"title":"\n\nImage Classification\n\nImage classification is the task of assigning a label or class to an entire image. Images are expected to have only one class for each image.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/image-classification","line":55},{"title":"\n\nImage Segmentation\n\nImage Segmentation divides an image into segments where each pixel in the image is mapped to an object.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/image-segmentation","line":61},{"title":"\n\nImage to Image\n\nImage-to-image is the task of transforming a source image to match the characteristics of a target image or a target image domain.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/image-to-image","line":67},{"title":"\n\nObject Detection\n\nObject Detection models allow users to identify objects of certain defined classes.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/object-detection","line":73},{"title":"\n\nQuestion Answering\n\nQuestion Answering models can retrieve the answer to a question from a given text, which is useful for searching for an answer in a document.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/question-answering","line":79},{"title":"\n\nSummarization\n\nSummarization is the task of producing a shorter version of a document while preserving its important information.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/summarization","line":85},{"title":"\n\nTable Question Answering\n\nTable Question Answering (Table QA) is the answering a question about an information on a given table.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/table-question-answering","line":91},{"title":"\n\nText Classification\n\nText Classification is the task of assigning a label or class to a given text.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/text-classification","line":97},{"title":"\n\nText Generation\n\nGenerate text based on a prompt.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/text-generation","line":103},{"title":"\n\nToken Classification\n\nToken classification is a task in which a label is assigned to some tokens in a text.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/token-classification","line":109},{"title":"\n\nTranslation\n\nTranslation is the task of converting text from one language to another.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/translation","line":115},{"title":"\n\nZero Shot Classification\n\nZero shot classification is the task to classify text without specific training for the task.\n\n","target":"https://huggingface.co/docs/inference-providers/tasks/zero-shot-classification","line":121},{"title":"Update on GitHub","target":"https://github.com/huggingface/hub-docs/blob/main/docs/inference-providers/tasks/index.md","line":129}],"metadata":{"title":"API Reference · Hugging Face","source":"https://huggingface.co/docs/inference-providers/tasks/index","author":null,"published":null,"created":"2026-04-26","description":"We’re on a journey to advance and democratize artificial intelligence through open source and open science."},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"- API Reference · Hugging Face.md"},
