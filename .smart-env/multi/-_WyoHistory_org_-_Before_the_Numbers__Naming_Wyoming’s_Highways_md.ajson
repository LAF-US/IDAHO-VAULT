m \"(opens in a new window","line":11},{"title":"https://www.nps.gov/parkhistory/online\\_books/yell\\_roads/hrs1-5.htm","target":"https://www.nps.gov/parkhistory/online_books/yell_roads/hrs1-5.htm \"(opens in a new window","line":14},{"title":"https://iowadot.gov/autotrails/custerbattlefieldhighway","target":"https://iowadot.gov/autotrails/custerbattlefieldhighway \"(opens in a new window","line":16},{"title":"https://www.fhwa.dot.gov/publications/publicroads/06jul/03.cfm","target":"https://www.fhwa.dot.gov/publications/publicroads/06jul/03.cfm \"(opens in a new window","line":17},{"title":"https://archive.org/stream/officialrouteboo00yell/officialrouteboo00yell\\_djvu.txt","target":"https://archive.org/stream/officialrouteboo00yell/officialrouteboo00yell_djvu.txt \"(opens in a new window","line":18},{"title":"https://pavingtheway.tv/","target":"https://pavingtheway.tv/ \"(opens in a new window","line":21},{"title":"https://www.fhwa.dot.gov/publications/publicroads/16novdec/03.cfm","target":"https://www.fhwa.dot.gov/publications/publicroads/16novdec/03.cfm \"(opens in a new window","line":22},{"title":"https://www.fhwa.dot.gov/infrastructure/numbers.cfm","target":"https://www.fhwa.dot.gov/infrastructure/numbers.cfm \"(opens in a new window","line":23},{"title":"http://www.dot.state.wy.us/home/travel/scenic\\_byways.html","target":"http://www.dot.state.wy.us/home/travel/scenic_byways.html \"(opens in a new window","line":25},{"title":"http://www.dot.state.wy.us/files/live/sites/wydot/files/shared/Public%20Affairs/photos/Scenic%20Byways%20brochure%202013.pdf","target":"http://www.dot.state.wy.us/files/live/sites/wydot/files/shared/Public%20Affairs/photos/Scenic%20Byways%20brochure%202013.pdf \"(opens in a new window","line":26},{"title":"Park County Archives","target":"http://www.parkcounty.us/historicalarchives/historicalarchives.html \"(opens in a new window","line":30},{"title":"the Henry Ford museum","target":"https://www.thehenryford.org/collections-and-research