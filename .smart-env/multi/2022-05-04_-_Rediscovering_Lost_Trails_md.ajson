
"smart_sources:2022-05-04 - Rediscovering Lost Trails.md": {"path":"2022-05-04 - Rediscovering Lost Trails.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"139th1w","at":1785795028896},"class_name":"SmartSource","last_import":{"mtime":1783961414024,"size":10135,"at":1785795028920,"hash":"139th1w"},"blocks":{"#---frontmatter---":[1,9],"#":[10,39]},"outlinks":[{"title":"Kelly Hewes","target":"Kelly Hewes","line":5},{"title":"This year for Idaho Gives from May 2-5, ITA is raising funds to save lost trails. Learn more here!","target":"https://www.idahogives.org/organizations/idaho-trails-association","line":39}],"metadata":{"title":"Rediscovering Lost Trails","source":"https://idahotrailsassociation.org/2022/05/rediscovering-lost-trails/","author":["[[Kelly Hewes]]"],"published":"2022-05-04","created":"2026-07-13","description":"By ITA Volunteer and Board Member Liz BridgesIn the US, many of our most revered routes trace trails created by the native peoples of this continent. In Idaho, the Shoshone, Blackfoot, Paiute, Nez Perce and others had long established trails that connected spring foraging areas with summer hunting grounds, fall fishing stations with winter quarters."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},