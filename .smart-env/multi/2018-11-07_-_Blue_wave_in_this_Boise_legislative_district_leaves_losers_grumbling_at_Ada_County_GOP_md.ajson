
"smart_sources:2018-11-07 - Blue wave in this Boise legislative district leaves losers grumbling at Ada County GOP.md": {"path":"2018-11-07 - Blue wave in this Boise legislative district leaves losers grumbling at Ada County GOP.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"dhnzao","at":1785795015454},"class_name":"SmartSource","last_import":{"mtime":1783531225677,"size":7118,"at":1785795015537,"hash":"dhnzao"},"blocks":{"#---frontmatter---":[1,9],"#":[10,74]},"outlinks":[{"title":"Kate Talerico","target":"Kate Talerico","line":5},{"title":"Democrat Jim Bratnober challenged incumbent Fred Martin for the District 15 Senate seat in the Idaho state legislature. He is down by six votes, triggering a recount.","target":"https://www.idahostatesman.com/public/latest-news/ifmswn/picture221327585/alternates/LANDSCAPE_1200/Jim%20Bratnober","line":10,"embedded":true},{"title":"District 15 has long been controlled by Republicans in the state legislature, but both House seats were flipped in the midterm elections.","target":"https://www.idahostatesman.com/public/latest-news/m4o0zh/picture221328365/alternates/FREE_1200/District%2015","line":22,"embedded":true},{"title":"Democrat Jake Ellis defeated incumbent Republicant Rep. Patrick McDonald to win House Seat B for District 15.","target":"https://www.idahostatesman.com/public/latest-news/8yb32v/picture221327605/alternates/FREE_1200/Jake%20Ellis%20campaign%20poster","line":34,"embedded":true},{"title":"also lost their majority","target":"https://www.idahostatesman.com/news/politics-government/election/article221240480.html","line":40},{"title":"President Donald Trump holding Hillary Clinton","target":"https://www.idahostatesman.com/news/politics-government/state-politics/article217370825.html","line":46},{"title":"Republican incumbent Fred Martin, left, defeated Democratic challenger Jim Bratnober by six votes.","target":"https://www.idahostatesman.com/public/latest-news/l05e8/picture221414270/alternates/FREE_1200/Jim%20Bratnober-Fred%20Martin","line":48,"embedded":true}],"metadata":{"title":"Blue wave in this Boise legislative district leaves losers grumbling at Ada County GOP","source":"https://www.idahostatesman.com/news/politics-government/election/article221316170.html","author":["[[Kate Talerico]]"],"published":"2018-11-07","created":"2026-07-08","description":"GOP incumbents in Boise’s legislative District 15 say they expected a Medicaid proposition to bring out Democratic voters. But they say they need more help from the Ada County Republican Party."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:2018-11-07 - Blue wave in this Boise legislative district leaves losers grumbling at Ada County GOP.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"112sxga","at":1785795015454},"key":"2018-11-07 - Blue wave in this Boise legislative district leaves losers grumbling at Ada County GOP.md#---frontmatter---","lines":[1,9],"size":483,"outlinks":[{"title":"Kate Talerico","target":"Kate Talerico","line":5}],"class_name":"SmartBlock"},
