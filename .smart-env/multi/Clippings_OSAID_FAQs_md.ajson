0.18318084,-0.05539169,0.03434281,-0.02440565,-0.02358036,0.02963595,0.02449575,-0.07012104,0.02608185,-0.01274148,0.07211966,-0.02972111,0.01290672,0.0444904,-0.03201364,0.05294526,0.03004581,-0.02228854,-0.02750133,-0.03304245,0.01534092,0.03285289,0.08955333,-0.02568958,-0.02046494,-0.06016656,-0.02814778,0.06991488,-0.00624565,-0.03046858,0.00968169,-0.0071845,0.04826057,-0.03051816,0.03142389,0.06959995,-0.00399078,0.00715041,-0.0019176,-0.02501451,0.07144152,0.07169203,-0.00177062],"last_embed":{"hash":"17i55e0","tokens":440}}},"last_read":{"hash":"17i55e0","at":1777680495516},"class_name":"SmartSource","last_import":{"mtime":1777680409682,"size":19238,"at":1777680416413,"hash":"17i55e0"},"blocks":{"#---frontmatter---":[1,10],"##THE open source ai definition 1.0":[11,20],"##THE open source ai definition 1.0##We have released the first stable version of the Definition.":[13,16],"##THE open source ai definition 1.0##We have released the first stable version of the Definition.#{1}":[15,16],"##THE open source ai definition 1.0#Answers to Frequently Asked Questions":[17,20],"##THE open source ai definition 1.0#Answers to Frequently Asked Questions#{1}":[19,20],"##FAQs":[21,22],"##What Is an AI System?":[23,30],"##What Is an AI System?#{1}":[25,30],"##What is an Open Source AI?":[31,34],"##What is an Open Source AI?#{1}":[33,34],"##Why did you write the Open Source AI Definition?":[35,38],"##Why did you write the Open Source AI Definition?#{1}":[37,38],"##What’s the difference between the Open Source Definition and the Open Source AI Definition?":[39,42],"##What’s the difference between the Open Source Definition and the Open Source AI Definition?#{1}":[41,42],"##Isn’t training data required to program the AI system?":[43,54],"##Isn’t training data required to program the AI system?#{1}":[45,48],"##Isn’t training data required to program the AI system?#{2}":[49,49],"##Isn’t training data required to program the AI system?#{3}":[50,50],"##Isn’t training data required to program the AI system?#{4}":[51,52],"##Isn’t training data required to program the AI system?#{5}":[53,54],"##What is the role of training data in the Open Source AI Definition?":[55,62],"##What is the role of training data in the Open Source AI Definition?#{1}":[57,62],"##Why do you allow the exclusion of some training data?":[63,68],"##Why do you allow the exclusion of some training data?#{1}":[65,68],"##How did you arrive at this conclusion? Is it compromising Open Source ideals?":[69,76],"##How did you arrive at this conclusion? Is it compromising Open Source ideals?#{1}":[71,76],"##What kind of data should be required in the Open Source AI Definition?":[77,89],"##What kind of data should be required in the Open Source AI Definition?#{1}":[79,82],"##What kind of data should be required in the Open Source AI Definition?#{2}":[83,83],"##What kind of data should be required in the Open Source AI Definition?#{3}":[84,84],"##What kind of data should be required in the Open Source AI Definition?#{4}":[85,85],"##What kind of data should be required in the Open Source AI Definition?#{5}":[86,87],"##What kind of data should be required in the Open Source AI Definition?#{6}":[88,89],"##How do you fix a buggy AI system?":[90,104],"##How do you fix a buggy AI system?#{1}":[92,97],"##How do you fix a buggy AI system?#{2}":[98,98],"##How do you fix a buggy AI system?#{3}":[99,99],"##How do you fix a buggy AI system?#{4}":[100,100],"##How do you fix a buggy AI system?#{5}":[101,102],"##How do you fix a buggy AI system?#{6}":[103,104],"##What is a skilled person?":[105,108],"##What is a skilled person?#{1}":[107,108],"##Is the Open Source AI Definition covering models and weights and parameters?":[109,114],"##Is the Open Source AI Definition covering models and weights and parameters?#{1}":[111,114],"##Why do you require training code while OSD #2 doesn’t require compilers?":[115,118],"##Why do you require training code while OSD #2 doesn’t require compilers?#{1}":[117,118],"##Why is there no mention of safety and risk limitations in the Open Source AI Definition?":[119,122],"##Why is there no mention of safety and risk limitations in the Open Source AI Definition?#{1}":[121,122],"##Are model parameters copyrightable?":[123,126],"##Are model parameters copyrightable?#{1}":[125,126],"##Why will parameters be available under “OSI-approved terms” but the code will be under “OSI-approved licenses”? Are you going to allow restrictions on the terms for models?":[127,130],"##Why will parameters be available under “OSI-approved terms” but the code will be under “OSI-approved licenses”? Are you going to allow restrictions on the terms for models?#{1}":[129,130],"##Why is the “Preferred form to make modifications” limited to machine learning?":[131,134],"##Why is the “Preferred form to make modifications” limited to machine learning?#{1}":[133,134],"##Which AI systems comply with the Open Source AI Definition?":[135,138],"##Which AI systems comply with the Open Source AI Definition?#{1}":[137,138],"##What’s the next step?":[139,147],"##What’s the next step?#{1}":[141,147]},"outlinks":[{"title":"Read version 1.0","target":"https://opensource.org/ai/open-source-ai-definition","line":15},{"title":"The Open Source AI Definition (OSAID)","target":"https://opensource.org/ai","line":19},{"title":"co-design process","target":"https://opensource.org/deepdive/","line":37},{"title":"Open Source Definition (OSD)","target":"https://opensource.org/osd","line":37},{"title":"Open Source Definition (OSD)","target":"https://opensource.org/osd","line":41},{"title":"lacking legal certainty","target":"https://opensource.org/blog/copyright-law-makes-a-case-for-requiring-data-information-rather-than-open-datasets-for-open-source-ai","line":67},{"title":"“Validation phase”","target":"https://discuss.opensource.org/t/initial-report-on-definition-validation/368","line":71},{"title":"“System analysis” phase","target":"https://discuss.opensource.org/t/report-on-working-group-recommendations/247","line":71},{"title":"Digital Public Goods Standard","target":"https://digitalpublicgoods.net/standard/","line":73},{"title":"reproducible builds","target":"https://reproducible-builds.org/","line":73},{"title":"Free Systems Distribution Guidelines","target":"https://www.gnu.org/distros/free-system-distribution-guidelines.html","line":73},{"title":"Open Source Definition","target":"https://opensource.org/osd","line":92},{"title":"Wikipedia entry","target":"https://en.wikipedia.org/wiki/Person_having_ordinary_skill_in_the_art","line":107},{"title":"this article.","target":"https://opensource.org/ai/open-weights","line":113},{"title":"Section 1: Principles for responsible stewardship of trustworthy AI","target":"https://legalinstruments.oecd.org/en/instruments/oecd-legal-0449","line":121},{"title":"Join us today!","target":"https://join.opensource.org/join","line":147}],"metadata":{"title":"OSAID FAQs","source":"https://opensource.org/ai/faq","author":null,"published":"2025-01-21","created":"2026-05-01","description":"Answers to Frequently Asked Questions The Open Source AI Definition (OSAID) represents an important first step in defining Open Source in an AI context. Because AI systems differ fundamentally from...","tags":["#clippings"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"17i55e0","at":1777680492571}},"smart_blocks:Clippings/OSAID FAQs.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.05257352,-0.08039591,-0.00557432,-0.06476239,0.06873775,-0.04361731,0.01349402,0.01131405,0.03930878,-0.00795402,-0.00639001,-0.07832786,0.022183,0.01321004,0.04455446,0.01014662,-0.00621497,-0.00887206,-0.0188007,0.03335829,0.08261901,-0.0668429,0.00200451,-0.08016066,-0.01426897,0.08320377,-0.01942356,-0.09864514,-0.01978066,-0.16628802,-0.00571912,0.06460482,0.05993132,0.00960467,-0.01916412,0.03843999,0.03424849,0.02956051,0.01361061,0.11046437,0.07350045,-0.03518724,0.01678464,0.00421979,