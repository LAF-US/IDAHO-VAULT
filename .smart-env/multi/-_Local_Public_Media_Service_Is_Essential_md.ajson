
"smart_sources:- Local Public Media Service Is Essential.md": {"path":"- Local Public Media Service Is Essential.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"sdb0gz","at":1785794983307},"class_name":"SmartSource","last_import":{"mtime":1784826039985,"size":4790,"at":1785794983452,"hash":"sdb0gz"},"blocks":{"#---frontmatter---":[1,8],"#":[9,12],"##Our Impact So Far":[13,18],"##Our Impact So Far#{1}":[15,18],"##$26M":[19,22],"##$26M##Distributed":[21,22],"##30M":[23,26],"##30M##People Served":[25,26],"##74":[27,30],"##74##Grantee Organizations":[29,30],"##186":[31,40],"##186##Stations Secured":[33,40],"##186##Stations Secured#{1}":[35,40],"##The Bridge Fund is guiding local public media through a crisis moment to a more sustainable and impactful future.":[41,60],"##The Bridge Fund is guiding local public media through a crisis moment to a more sustainable and impactful future.#{1}":[43,60],"##Local public media organizations connect, inform, and inspire communities. They build trust and support democracy.":[61,79],"##Local public media organizations connect, inform, and inspire communities. They build trust and support democracy.#{1}":[63,66],"##Local public media organizations connect, inform, and inspire communities. They build trust and support democracy.#{2}":[67,67],"##Local public media organizations connect, inform, and inspire communities. They build trust and support democracy.#{3}":[68,68],"##Local public media organizations connect, inform, and inspire communities. They build trust and support democracy.#{4}":[69,69],"##Local public media organizations connect, inform, and inspire communities. They build trust and support democracy.#{5}":[70,70],"##Local public media organizations connect, inform, and inspire communities. They build trust and support democracy.#{6}":[71,71],"##Local public media organizations connect, inform, and inspire communities. They build trust and support democracy.#{7}":[72,72],"##Local public media organizations connect, inform, and inspire communities. They build trust and support democracy.#{8}":[73,73],"##Local public media organizations connect, inform, and inspire communities. They build trust and support democracy.#{9}":[74,79],"##Local stations. Real communities. Critical impact.":[80,84],"##Local stations. Real communities. Critical impact.#{1}":[82,84]},"outlinks":[{"title":"Learn More","target":"https://www.publicmediabridgefund.org/about","line":11},{"title":"Map of the United States and Alaska showing locations of radio and TV stations. Green circles indicate radio stations, larger circles represent more stations in that area. Darker green circles indicate TV stations. Alaska is shown with a few stations. The map includes state boundaries, with key for radio and TV stations.","target":"https://images.squarespace-cdn.com/content/v1/692deaa5fd363858d5e6888f/730c5a90-5251-4108-96dc-ad67a8693d5a/WebMap.png?format=2500w","line":17,"embedded":true},{"title":"Two men wearing headphones and microphones sitting at a table with electronic equipment and a laptop, broadcasting at a community event in a gymnasium with blue bleachers in the background.","target":"https://images.squarespace-cdn.com/content/v1/692deaa5fd363858d5e6888f/9ca20182-3147-44eb-94be-65b7ca1c2e52/WUVS-FM+01.png?format=2500w","line":35,"embedded":true},{"title":"A man sitting at a radio station or recording studio with headphones, smiling at the camera. There are microphones, computer monitors, and a stack of magazines or records on the desk.","target":"https://images.squarespace-cdn.com/content/v1/692deaa5fd363858d5e6888f/bcac07f0-2722-4c40-b197-6f3f85a33d2a/KSJD-FM+01.jpg?format=2500w","line":35,"embedded":true},{"title":"Blue icon of a video camera with a play button inside and an arrow pointing downward, indicating a download or recording feature.","target":"https://images.squarespace-cdn.com/content/v1/692deaa5fd363858d5e6888f/562a58e6-30e4-4ea9-9e78-d8c9f894ca37/money-receive-square.png?format=2500w","line":47,"embedded":true},{"title":"A blue icon of a vintage microphone","target":"https://images.squarespace-cdn.com/content/v1/692deaa5fd363858d5e6888f/7e4e0109-fbce-4939-8418-80280285f14d/mic-01.png?format=2500w","line":51,"embedded":true},{"title":"Blue icon of three people grouped together.","target":"https://images.squarespace-cdn.com/content/v1/692deaa5fd363858d5e6888f/16219411-65ae-41f2-95c9-6547be384a08/user-group.png?format=2500w","line":55,"embedded":true},{"title":"LEARN MORE","target":"https://www.publicmediabridgefund.org/about","line":57}],"metadata":{"title":"Local Public Media Service Is Essential","source":"https://www.publicmediabridgefund.org/?utm_source=npr_newsletter&utm_medium=email&utm_content=20260723&utm_term=10876368&utm_campaign=public-editor&utm_id=60971637&orgid=26&uniquet=NsHg9nGO_ERC4gXQ_2NGbQ&utm_att1=","author":null,"published":null,"created":"2026-07-23","description":"The Public Media Bridge Fund — an initiative of Public Media Company — exists to guide the system through this crisis by providing fast, flexible support to keep local stations on the air and moving toward a more sustainable future."},"task_lines":[],"tasks":{},"codeblock_ranges":[[37,39],[63,65],[76,78]]},"smart_blocks:- Local Public Media Service Is Essential.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"pxhso7","at":1785794983307},"key":"- Local Public Media Service Is Essential.md#---frontmatter---","lines":[1,8],"size":567,"outlinks":[],"class_name":"SmartBlock"},
