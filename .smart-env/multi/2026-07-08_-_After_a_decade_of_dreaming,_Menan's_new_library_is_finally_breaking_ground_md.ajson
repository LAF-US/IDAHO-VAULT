onaws.com/assets.eastidahonews.com/wp-content/uploads/2026/07/menan-library-drone-photo.jpg","line":108,"embedded":true},{"title":"Menan Annis Grant Public Library | Screenshot from documentary","target":"https://s3.us-west-2.amazonaws.com/assets.eastidahonews.com/wp-content/uploads/2026/07/menan-library-pic.jpg","line":112,"embedded":true},{"title":"SUBMIT A CORRECTION","target":"https://www.eastidahonews.com/submit-a-correction/?headline=After%20a%20decade%20of%20dreaming,%20Menan%E2%80%99s%20new%20library%20is%20finally%20breaking%20ground&url=https://www.eastidahonews.com/2026/07/after-a-decade-of-dreaming-menans-new-library-is-finally-breaking-ground/","line":116},{"title":"Click here","target":"https://www.eastidahonews.com/eastidahonews-com-code-of-ethics/#onlinecommenting","line":118}],"metadata":{"title":"After a decade of dreaming, Menan's new library is finally breaking ground","source":"https://www.eastidahonews.com/2026/07/after-a-decade-of-dreaming-menans-new-library-is-finally-breaking-ground/?utm_source=newsletters.idahocapitalsun.com&utm_medium=newsletter&utm_campaign=group-crowdsources-safe-bathrooms-sba-offers-storm-assistance-aca-premiums-surge-again&_bhlid=dd04dbbe9e97690904ed118d0dbaf5d234f1ea35","author":["[[Rett Nelson]]"],"published":"2026-07-08","created":"2026-07-09","description":"MENAN – A project 10 years in the making is finally moving forward. The Friends of the Menan Annis Grant Library — a nonprofit raising funds for the library’s construction — is breaking ground on the building on Aug. 1. The 7,500-square-foot building is being built in a one-acre field at 3550 East and 665 […]"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},