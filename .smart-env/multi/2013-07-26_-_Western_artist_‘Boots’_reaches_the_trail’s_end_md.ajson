
"smart_sources:2013-07-26 - Western artist ‘Boots’ reaches the trail’s end.md": {"path":"2013-07-26 - Western artist ‘Boots’ reaches the trail’s end.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1b7ef1m","at":1785795007324},"class_name":"SmartSource","last_import":{"mtime":1784755081198,"size":6247,"at":1785795007579,"hash":"1b7ef1m"},"blocks":{"#---frontmatter---":[1,9],"#":[10,54]},"outlinks":[{"title":"Shawn Vestal","target":"Shawn Vestal","line":5},{"title":"Artist Roy “Boots” Reynolds Jr. became famous among horse people for his comic spirit and colorful images. Reynolds died recently in his Bonner County home at age 78. (File)","target":"https://thumb.spokesman.com/HEgqs63l2hK9NhBX_EryZj9H8tY=/400x0/media.spokesman.com/photos/2013/07/26/cit26_REYNOLDS.jpg","line":10,"embedded":true},{"title":"Artist Roy “Boots” Reynolds Jr. became famous among horse people for his comic spirit and colorful images. Reynolds died recently in his Bonner County home at age 78. (File)","target":"https://thumb.spokesman.com/HEgqs63l2hK9NhBX_EryZj9H8tY=/400x0/media.spokesman.com/photos/2013/07/26/cit26_REYNOLDS.jpg","line":14,"embedded":true},{"title":"Idaho","target":"Idaho","line":40},{"title":"shawnv@ spokesman.com","target":"mailto:shawnv@spokesman.com","line":50}],"metadata":{"title":"Western artist ‘Boots’ reaches the trail’s end","source":"https://www.spokesman.com/stories/2013/jul/26/western-artist-boots-reaches-the-trails-end/","author":["[[Shawn Vestal]]"],"published":"2013-07-26","created":"2026-07-22","description":"Boots Reynolds got cowboys right. That’s how he made them laugh.  Over decades as a cartoonist and painter, he became famous among horse people for his comic spirit and colorful images. But his artwork thrived on a deep, lived sense of Western authenticity – from the droopy brim of a cowboy hat, to the drag and drape of chaps, to the sometimes cantankerous bond between horse and rider, to the effects of time and gravity on a face or a body. Boots got it right.","tags":["#idaho"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:2013-07-26 - Western artist ‘Boots’ reaches the trail’s end.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"eg0pvb","at":1785795007324},"key":"2013-07-26 - Western artist ‘Boots’ reaches the trail’s end.md#---frontmatter---","lines":[1,9],"size":717,"outlinks":[{"title":"Shawn Vestal","target":"Shawn Vestal","line":5}],"class_name":"SmartBlock"},
