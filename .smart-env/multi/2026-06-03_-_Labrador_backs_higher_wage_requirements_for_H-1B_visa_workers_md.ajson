
"smart_sources:2026-06-03 - Labrador backs higher wage requirements for H-1B visa workers.md": {"path":"2026-06-03 - Labrador backs higher wage requirements for H-1B visa workers.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"3td3ze","at":1785795033073},"class_name":"SmartSource","last_import":{"mtime":1783545584440,"size":3009,"at":1785795033165,"hash":"3td3ze"},"blocks":{"#---frontmatter---":[1,9],"#":[10,32]},"outlinks":[{"title":"Par Kermani","target":"Par Kermani","line":5},{"title":"Idaho","target":"https://localnews8.com/category/news/idaho/","line":32}],"metadata":{"title":"Labrador backs higher wage requirements for H-1B visa workers","source":"https://localnews8.com/news/idaho/2026/06/03/labrador-backs-higher-wage-requirements-for-h-1b-visa-workers/?utm_source=newsletters.idahocapitalsun.com&utm_medium=newsletter&utm_campaign=state-audit-confirms-ada-county-primary-election-results-us-house-passes-fulcher-s-bill-to-boost-geothermal-leasing-on-public-lands-nearly-60-idahoans-sick-after-raw-milk-outbreaks&_bhlid=dcaf28dfebbbccdb24b66972ffb569abd8f6df5d","author":["[[Par Kermani]]"],"published":"2026-06-03","created":"2026-07-08","description":"Idaho Attorney General Raúl Labrador is backing a proposal that would increase wage requirements for employers hiring workers through the H-1B visa program. Labrador joined attorneys general from 12 other states in submitting comments to the U.S. Department of Labor supporting a proposed rule that would raise the minimum wages employers must pay foreign workers under the program."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},