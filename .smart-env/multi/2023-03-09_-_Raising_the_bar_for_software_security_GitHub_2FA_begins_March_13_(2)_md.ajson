
"smart_sources:2023-03-09 - Raising the bar for software security GitHub 2FA begins March 13 (2).md": {"path":"2023-03-09 - Raising the bar for software security GitHub 2FA begins March 13 (2).md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1ktno4r","at":1785795029090},"class_name":"SmartSource","last_import":{"mtime":1783531338809,"size":9753,"at":1785795029109,"hash":"1ktno4r"},"blocks":{"#---frontmatter---":[1,12],"#":[14,17],"##From March 13, we will begin rolling out the 2FA requirement":[18,25],"##From March 13, we will begin rolling out the 2FA requirement#{1}":[20,25],"##We’ve made it much easier to secure your GitHub account with 2FA":[26,36],"##We’ve made it much easier to secure your GitHub account with 2FA#{1}":[28,29],"##We’ve made it much easier to secure your GitHub account with 2FA#{2}":[30,30],"##We’ve made it much easier to secure your GitHub account with 2FA#{3}":[31,31],"##We’ve made it much easier to secure your GitHub account with 2FA#{4}":[32,32],"##We’ve made it much easier to secure your GitHub account with 2FA#{5}":[33,34],"##We’ve made it much easier to secure your GitHub account with 2FA#{6}":[35,36],"##Reminder: what to expect if you are required to enable 2FA":[37,58],"##Reminder: what to expect if you are required to enable 2FA#{1}":[39,42],"##Reminder: what to expect if you are required to enable 2FA#{2}":[43,43],"##Reminder: what to expect if you are required to enable 2FA#{3}":[44,58],"##Securing the software supply chain is a team effort":[59,63],"##Securing the software supply chain is a team effort#{1}":[61,63]},"outlinks":[{"title":"Laura Paine","target":"Laura Paine","line":5},{"title":"Hirsch Singhal","target":"Hirsch Singhal","line":6},{"title":"announced our commitment","target":"https://github.blog/2022-05-04-software-security-starts-with-the-developer-securing-developer-accounts-with-2fa/","line":14},{"title":"securing the supply chain","target":"https://github.blog/2022-03-28-how-to-secure-your-end-to-end-supply-chain-on-github/","line":16},{"title":"groups of developers and administrators","target":"https://github.blog/2022-12-14-raising-the-bar-for-software-security-next-steps-for-github-com-2fa/","line":20},{"title":"Click here","target":"https://docs.github.com/en/authentication/securing-your-account-with-two-factor-authentication-2fa","line":24},{"title":"enhancing that experience","target":"https://github.blog/changelog/label/authentication/","line":28},{"title":"perform 2FA and confirm their second factor settings","target":"https://github.blog/changelog/2023-01-11-second-factor-validation-after-2fa-setup/","line":30},{"title":"we recommend","target":"https://github.blog/changelog/2022-11-21-updates-to-the-two-factor-authentication-setup-flow/","line":31},{"title":"both an authenticator app (TOTP) and an SMS number","target":"https://github.blog/changelog/2023-03-02-sms-and-totp-can-now-both-be-registered-2fa-methods/","line":31},{"title":"strongly recommend","target":"https://github.blog/changelog/2022-11-21-updates-to-the-two-factor-authentication-setup-flow/","line":32},{"title":"preferred option","target":"https://github.blog/changelog/2023-02-22-preferred-2fa-methods-and-settings-improvements/","line":32},{"title":"unlink your email address","target":"https://github.blog/changelog/2023-02-21-unlink-your-email-in-case-of-2fa-lockout/","line":33},{"title":"passkeys","target":"https://fidoalliance.org/passkeys/","line":35},{"title":"designed a rollout process","target":"https://github.blog/2022-12-14-raising-the-bar-for-software-security-next-steps-for-github-com-2fa/","line":39},{"title":"Timeline of the 2FA rollout process","target":"https://github.blog/wp-content/uploads/2023/03/2fa-1.png?w=1600","line":41,"embedded":true},{"title":"90 percent of companies reporting","target":"https://openuk.uk/wp-content/uploads/2021/10/openuk-state-of-open_final-version.pdf","line":61}],"metadata":{"title":"Raising the bar for software security: GitHub 2FA begins March 13","source":"https://github.blog/news-insights/product-news/raising-the-bar-for-software-security-github-2fa-begins-march-13/","author":["[[Laura Paine]]","[[Hirsch Singhal]]"],"published":"2023-03-09","created":"2026-04-20","description":"On March 13, we will officially begin rolling out our initiative to require all developers who contribute code on GitHub.com to enable one or more forms of two-factor authentication (2FA) by the end of 2023. Read on to learn about what the process entails and how you can help secure the software supply chain with 2FA.","date created":"Monday, April 20th 2026, 12:53:55 pm","date modified":"Monday, April 20th 2026, 1:04:46 pm"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},