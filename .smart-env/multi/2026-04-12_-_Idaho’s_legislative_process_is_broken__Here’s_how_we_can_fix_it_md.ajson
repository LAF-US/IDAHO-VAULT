
"smart_sources:2026-04-12 - Idaho’s legislative process is broken. Here’s how we can fix it.md": {"path":"2026-04-12 - Idaho’s legislative process is broken. Here’s how we can fix it.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"159e2n9","at":1785795032104},"class_name":"SmartSource","last_import":{"mtime":1783471285032,"size":7760,"at":1785795032194,"hash":"159e2n9"},"blocks":{"#---frontmatter---":[1,9],"#":[10,60],"##{1}":[22,22],"##{2}":[23,23],"##{3}":[24,24],"##{4}":[25,25],"##{5}":[26,26],"##{6}":[27,27],"##{7}":[28,28],"##{8}":[29,29],"##{9}":[30,60]},"outlinks":[{"title":"Idaho Statesman contributors","target":"Idaho Statesman contributors","line":5},{"title":"Rep. Bruce Skaug, R-Nampa, sponsored a bill requiring professionals to notify parents if their child seeks a social gender transition, with potential penalties of up to $100,000. He was also the chair of the House Judiciary Committee, which didn’t take testimony from at least two people opposed to his bill.","target":"https://www.idahostatesman.com/public/latest-news/35fxej/picture272507089/alternates/LANDSCAPE_1200/BOI_0214lgxhouseskaug","line":12,"embedded":true},{"title":"treating input as an inconvenience","target":"https://www.idahostatesman.com/opinion/from-the-opinion-editor/article257965208.html","line":18},{"title":"House Bill 822","target":"https://legislature.idaho.gov/sessioninfo/2026/legislation/H0822/","line":38},{"title":"one clinician came prepared","target":"https://idahocapitalsun.com/2026/03/17/idahoans-are-forced-to-suffer-in-silence-when-clinicians-arent-allowed-to-testify-on-bill/","line":40}],"metadata":{"title":"Idaho’s legislative process is broken. Here’s how we can fix it","source":"https://www.idahostatesman.com/opinion/readers-opinion/article315373195.html#campaignName=boise_politics_newsletter","author":["[[Idaho Statesman contributors]]"],"published":"2026-04-12","created":"2026-07-07","description":"It starts with leaders in the Legislature who genuinely value constituent input and are willing to address the most harmful practices. | Opinion"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},