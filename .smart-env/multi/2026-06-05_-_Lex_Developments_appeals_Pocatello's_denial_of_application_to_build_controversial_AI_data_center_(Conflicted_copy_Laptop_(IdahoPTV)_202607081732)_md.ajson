
"smart_sources:2026-06-05 - Lex Developments appeals Pocatello's denial of application to build controversial AI data center (Conflicted copy Laptop (IdahoPTV) 202607081732).md": {"path":"2026-06-05 - Lex Developments appeals Pocatello's denial of application to build controversial AI data center (Conflicted copy Laptop (IdahoPTV) 202607081732).md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"wzt00q","at":1785795033073},"class_name":"SmartSource","last_import":{"mtime":1783553537752,"size":11086,"at":1785795033166,"hash":"wzt00q"},"blocks":{"#---frontmatter---":[1,9],"#":[10,25],"###What criteria did the hearing examiner determine the application did not meet?":[26,38],"###What criteria did the hearing examiner determine the application did not meet?#{1}":[28,38],"###What has Lex Developments argued?":[39,80],"###What has Lex Developments argued?##I. No conditional use permit is required":[41,56],"###What has Lex Developments argued?##I. No conditional use permit is required#{1}":[43,56],"###What has Lex Developments argued?##II. Even if a CUP were require, the hearing examiner’s denial was arbitrary, capricious and legally deficient":[57,70],"###What has Lex Developments argued?##II. Even if a CUP were require, the hearing examiner’s denial was arbitrary, capricious and legally deficient#{1}":[59,70],"###What has Lex Developments argued?##III. The city’s refusal to conditionally approve the Lex CUP application is fundamentally unjust":[71,80],"###What has Lex Developments argued?##III. The city’s refusal to conditionally approve the Lex CUP application is fundamentally unjust#{1}":[73,80],"###What happens now?":[81,99],"###What happens now?#{1}":[83,99]},"outlinks":[{"title":"Logan Ramsey","target":"Logan Ramsey","line":5},{"title":"Local","target":"https://www.eastidahonews.com/news/local/","line":10},{"title":"Some sit as they wait for the public hearing to begin.","target":"https://s3.us-west-2.amazonaws.com/assets.eastidahonews.com/wp-conten