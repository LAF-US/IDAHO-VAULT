
"smart_sources:2026-06-22 - Investigation into ‘Pinecone Cowboys’ errors.md": {"path":"2026-06-22 - Investigation into ‘Pinecone Cowboys’ errors.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1ujwr5y","at":1785795033228},"class_name":"SmartSource","last_import":{"mtime":1783542891566,"size":4361,"at":1785795033322,"hash":"1ujwr5y"},"blocks":{"#---frontmatter---":[1,9],"#":[10,24]},"outlinks":[{"title":"Gretchen King","target":"Gretchen King","line":5},{"title":"annotated the original version with the results of our investigation","target":"https://www.hcn.org/issues/58-5/the-plight-of-the-pine-cone-cowboy/","line":22}],"metadata":{"title":"Investigation into ‘Pinecone Cowboys’ errors","source":"https://www.hcn.org/investigation-into-pinecone-cowboys-errors/","author":["[[Gretchen King]]"],"published":"2026-06-22","created":"2026-07-08","description":"NOTE TO READERS Following publication of our May 2026 cover story “Pinecone Cowboys,” we discovered that the author misrepresented details of his reporting, leading to significant errors in both the story’s framing and in its factuality. We learned that the author was never in the field with the main source; that the term “pinecone cowboys” […]"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},