
"smart_sources:- The Long Bridge_ The Bridge to Sandpoint.md": {"path":"- The Long Bridge_ The Bridge to Sandpoint.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1l7wi70","at":1785794996019},"class_name":"SmartSource","last_import":{"mtime":1783981935753,"size":6432,"at":1785794996628,"hash":"1l7wi70"},"blocks":{"#---frontmatter---":[1,9],"#":[10,21],"##Files":[22,43],"##Files#{1}":[24,43],"##Map":[44,48],"##Map#{1}":[46,48]},"outlinks":[{"title":"Mary Garrison","target":"Mary Garrison","line":5},{"title":"Sandpoint's Wagon Bridge","target":"https://spokanehistorical.org/files/fullsize/8e0efa70c822d417bbeef5e3faf95911.jpg","line":24,"embedded":true},{"title":"The second bridge to Sandpoint.","target":"https://spokanehistorical.org/files/fullsize/acd3bf8725a7d6391cfdd77f1ad92506.jpg","line":28,"embedded":true},{"title":"The third bridge to Sandpoint.","target":"https://spokanehistorical.org/files/fullsize/998060e1630fdd81ad41195263bc44a1.jpg","line":32,"embedded":true},{"title":"The current bridge to Sandpoint.","target":"https://spokanehistorical.org/files/fullsize/1645a8f8c78ccac5f69f4d8a404d302c.jpg","line":36,"embedded":true},{"title":"The bridges of Sandpoint","target":"https://spokanehistorical.org/files/fullsize/e18f3ee5c04869315592b807c63d9126.jpg","line":40,"embedded":true},{"title":"OpenStreetMap","target":"http://www.openstreetmap.org/about/","line":46},{"title":"CARTO","target":"https://carto.com/about-carto/","line":46}],"metadata":{"title":"The Long Bridge: The Bridge to Sandpoint","source":"https://spokanehistorical.org/items/show/584","author":["[[Mary Garrison]]"],"published":null,"created":"2026-07-13","description":"The Long BridgesSometime around 1900, Tom Craig’s 2 ½ year old son accidently chopped his toe off.  The family lived south of the Pend Oreille River and the only ways for the panicked father to get to the doctor in Sandpoint was by ferry, rowboat or the train trestle.  Tom started running with his son across the trestle but had to jump to the side on a water barrel platform when a train approached.  The train slowed, and Tom jumped on and rode into Sandpoint, where his son received treatment...."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:- The Long Bridge_ The Bridge to Sandpoint.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"j99io8","at":1785794996019},"key":"- The Long Bridge_ The Bridge to Sandpoint.md#---frontmatter---","lines":[1,9],"size":691,"outlinks":[{"title":"Mary Garrison","target":"Mary Garrison","line":5}],"class_name":"SmartBlock"},
