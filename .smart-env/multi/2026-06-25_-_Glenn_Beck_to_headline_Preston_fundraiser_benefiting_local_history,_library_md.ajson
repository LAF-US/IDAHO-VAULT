
"smart_sources:2026-06-25 - Glenn Beck to headline Preston fundraiser benefiting local history, library.md": {"path":"2026-06-25 - Glenn Beck to headline Preston fundraiser benefiting local history, library.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1vuybgl","at":1785795033325},"class_name":"SmartSource","last_import":{"mtime":1783538481880,"size":2354,"at":1785795033403,"hash":"1vuybgl"},"blocks":{"#---frontmatter---":[1,9],"#":[10,34]},"outlinks":[{"title":"Par Kermani","target":"Par Kermani","line":5},{"title":"**News**","target":"https://localnews8.com/category/news/","line":10},{"title":"Oneida Stake Academy Foundation's website","target":"http://oneidastakeacademy.org/events","line":30},{"title":"News","target":"https://localnews8.com/category/news/","line":32}],"metadata":{"title":"Glenn Beck to headline Preston fundraiser benefiting local history, library","source":"https://localnews8.com/news/2026/06/25/glenn-beck-to-headline-preston-fundraiser-benefiting-local-history-library/?utm_source=newsletters.idahocapitalsun.com&utm_medium=newsletter&utm_campaign=idaho-leads-nation-in-housing-growth-data-shows-it-s-still-not-enough-emergency-logging-project-coming-to-montana-idaho&_bhlid=38f29eae6c317e80e26d31a574429089e52dfabd","author":["[[Par Kermani]]"],"published":"2026-06-25","created":"2026-07-08","description":"A special fundraiser featuring Author Glenn Beck supporting two local nonprofits preserving history and expanding educational opportunities.  The fundraising event will benefit two local projects: the restoration of the historic Oneida Stake Academy, preserving an important piece of southeastern Idaho's history, and the construction of a new addition to the Larsen-Sant Public Library, expanding educational opportunities for future generations"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},