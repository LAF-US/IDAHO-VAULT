
"smart_sources:- Hayden’s Gaze.md": {"path":"- Hayden’s Gaze.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"qh4dbf","at":1785794973222},"class_name":"SmartSource","last_import":{"mtime":1784586823254,"size":29933,"at":1785794973446,"hash":"qh4dbf"},"blocks":{"#---frontmatter---":[1,8],"#":[9,110],"##Further Reading (and Viewing):":[111,119],"##Further Reading (and Viewing):#{1}":[113,119]},"outlinks":[{"title":"\"Members of the Hayden Survey near Red Buttes, Wyoming Territory, August 1870.\" Hayden is seated hatless in the center at the back of the table; Jackson stands at the right, left hand on his hip. W. H. Jackson photo, courtesy of the USGS archives.","target":"http://commonplace.online/wp-content/uploads/2015/12/6.2.Rea_.1-300x221.jpg","line":19,"embedded":true},{"title":"\"A rock near Green River Station, Wyoming, 1869.\" Note the man at the bottom. Hayden the geologist was drawn to Jackson's unique respect for rocks. W. H. Jackson photo, courtesy of the USGS archives.","target":"http://commonplace.online/wp-content/uploads/2015/12/6.2.Rea_.2-300x239.jpg","line":67,"embedded":true},{"title":"\"Sanford Robinson Gifford on horseback.\" He often painted looking directly into the light, like Turner, but without the turmoil. W. H. Jackson photo, courtesy of the USGS archives.","target":"http://commonplace.online/wp-content/uploads/2015/12/6.2.Rea_.3-300x172.jpg","line":77,"embedded":true},{"title":"\"Gifford painting a landscape of castellated rocks near Chugwater Creek.\" Guessing from the hat, the man standing is Ford, the mineralogist. (These are the same rocks in the Gifford oil sketch owned by the Amon Carter Museum in Fort Worth.) W. H. Jackson photo, courtesy of the USGS archives.","target":"http://commonplace.online/wp-content/uploads/2015/12/6.2.Rea_.4-300x204.jpg","line":85,"embedded":true},{"title":"\"Looking east down the Sweetwater from the top of Independence Rock.\" One knows without thinking that the rock is rough to the touch and warm from the sun. W. H. Jackson photo, courtesy of the USGS archives.","target":"http://commonplace.online/wp-content/uploads/2015/12/6.2.Rea_.5-300x221.jpg","line":95,"embedded":true},{"title":"\"Looking up the Sweetwater from the top of Devil's Gate.\" There are people here in the middle of nowhere, says the picture. W. H. Jackson photo, courtesy of the USGS archives.","target":"http://commonplace.online/wp-content/uploads/2015/12/6.2.Rea_.6-300x151.jpg","line":103,"embedded":true},{"title":"online photo archive","target":"http://libraryphoto.cr.usgs.gov/","line":113}],"metadata":{"title":"Hayden’s Gaze","source":"https://commonplace.online/article/haydens-gaze/?print=print","author":null,"published":null,"created":"2026-07-20","description":null},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:- Hayden’s Gaze.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"mfo9nr","at":1785794973222},"key":"- Hayden’s Gaze.md#---frontmatter---","lines":[1,8],"size":153,"outlinks":[],"class_name":"SmartBlock"},
