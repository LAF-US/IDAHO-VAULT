
"smart_sources:- tomrizzo.com - “RUBE ROBBINS_ ONE TOUGH HOMBRE” « Tom Rizzo.md": {"path":"- tomrizzo.com - “RUBE ROBBINS_ ONE TOUGH HOMBRE” « Tom Rizzo.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1jj5zss","at":1785794996020},"class_name":"SmartSource","last_import":{"mtime":1785183788998,"size":3222,"at":1785794996629,"hash":"1jj5zss"},"blocks":{"#---frontmatter---":[1,6],"##“RUBE ROBBINS: ONE TOUGH HOMBRE”":[7,8],"##— HE FEARED NO ONE —":[9,51],"##— HE FEARED NO ONE —#Scanning the horizon, Marshal Orlando “Rube” Robbins adjusted his bandana on the back of his neck, hoping for relief from the scorching sun. The 45-year-old lawman had spent two months in the saddle tracking an escaped prisoner across the Dakota and Oregon territories.":[11,16],"##— HE FEARED NO ONE —#Scanning the horizon, Marshal Orlando “Rube” Robbins adjusted his bandana on the back of his neck, hoping for relief from the scorching sun. The 45-year-old lawman had spent two months in the saddle tracking an escaped prisoner across the Dakota and Oregon territories.#{1}":[13,16],"##— HE FEARED NO ONE —#During his law enforcement career, Robbins achieved a reputation as the “man most responsible for bringing law and order to Idaho Territory.”":[17,24],"##— HE FEARED NO ONE —#During his law enforcement career, Robbins achieved a reputation as the “man most responsible for bringing law and order to Idaho Territory.”#{1}":[19,24],"##— HE FEARED NO ONE —#In 1865, Robbins won an appointment as a Deputy U.S. Marshal and spent the next twenty-five years bringing outlaws to justice.":[25,32],"##— HE FEARED NO ONE —#In 1865, Robbins won an appointment as a Deputy U.S. Marshal and spent the next twenty-five years bringing outlaws to justice.#{1}":[27,32],"##— HE FEARED NO ONE —#Robbins feared no one, a point illustrated by the editors of True West Magazine in True Tales and Amazing Legends of the Old West.":[33,40],"##— HE FEARED NO ONE —#Robbins feared no one, a point illustrated by the editors of True West Magazine in True Tales and Amazing Legends of the Old West.#{1}":[35,40],"##— HE FEARED NO ONE —#He glared at the crowd and sang the song in a loud voice, then holstered the pistols, jumped down to the floor, and left.":[41,51],"##— HE FEARED NO ONE —#He glared at the crowd and sang the song in a loud voice, then holstered the pistols, jumped down to the floor, and left.#{1}":[43,51]},"outlinks":[{"title":"He Feared No One","target":"https://tomrizzo.com/wp-content/uploads/2018/09/robbins.001-2.jpg","line":13,"embedded":true},{"title":"Idaho","target":"Idaho","line":21},{"title":"Idaho’s Territorial Prison","target":"http://newenglander.smugmug.com/Travel/Idaho-2011/Idaho-April-6-16-2011/16658305_r79mGx/1429113307_7CzwRzp#!i=1429113307&k=7CzwRzp","line":27},{"title":"Nez Perce","target":"http://www.rootsweb.ancestry.com/~idreserv/nphist.html","line":29}],"metadata":{"source":"https://tomrizzo.com/one-tough-hombre/","author":null,"published":null,"created":"2026-07-16","tags":["#idaho"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:- tomrizzo.com - “RUBE ROBBINS_ ONE TOUGH HOMBRE” « Tom Rizzo.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1i9teeh","at":1785794996020},"key":"- tomrizzo.com - “RUBE ROBBINS_ ONE TOUGH HOMBRE” « Tom Rizzo.md#---frontmatter---","lines":[1,6],"size":95,"outlinks":[],"class_name":"SmartBlock"},
