
"smart_sources:2026-07-23 - Idaho grain crops show resilience despite drought and pests.md": {"path":"2026-07-23 - Idaho grain crops show resilience despite drought and pests.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"pmpb38","at":1785795033888},"class_name":"SmartSource","last_import":{"mtime":1785188017978,"size":4326,"at":1785795033963,"hash":"pmpb38"},"blocks":{"#---frontmatter---":[1,9],"#":[10,46]},"outlinks":[{"title":"Kaelyn Blessinger","target":"Kaelyn Blessinger","line":5},{"title":"**News**","target":"https://localnews8.com/category/news/","line":10},{"title":"Idaho","target":"Idaho","line":18},{"title":"News","target":"https://localnews8.com/category/news/","line":42}],"metadata":{"title":"Idaho grain crops show resilience despite drought and pests","source":"https://localnews8.com/news/2026/07/23/idaho-grain-crops-show-resilience-despite-drought-and-pests/?utm_source=newsletters.idahocapitalsun.com&utm_medium=newsletter&utm_campaign=state-audits-kamiah-s-financial-procedures-bonneville-sheriff-urges-local-control-in-ice-agreements&_bhlid=0583d7175405b4ff87d5ca01756adfbff549865f","author":["[[Kaelyn Blessinger]]"],"published":"2026-07-23","created":"2026-07-24","description":"Grain farmers in southern and eastern Idaho faced a challenging growing season due to drought, spring frost, and pests. However, University of Idaho researcher Janet Marshall noted that crops proved more resilient than initially expected. While some regions experienced yield losses, others avoided severe damage thanks to fortunate planting schedules and unexpected recovery.","tags":["#idaho"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},