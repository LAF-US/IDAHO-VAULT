"smart_sources:- OpenClaw — Personal AI Assistant.md": {"path":"- OpenClaw — Personal AI Assistant.md","embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.05458954,-0.09975024,-0.00958784,-0.02126488,-0.03057423,-0.06592799,0.04981966,0.03164123,0.03571222,-0.03659647,0.06774116,-0.05070338,0.03226853,0.0561884,0.00398248,0.04403502,0.02248844,-0.00719686,-0.00265114,0.01178331,0.02148578,-0.0533396,-0.00018156,-0.03156672,-0.05287213,0.0917523,-0.0787771,-0.04374091,-0.04778207,-0.19880874,-0.00242417,0.01746654,0.03160642,0.00044896,0.00338396,0.01690976,-0.03568566,0.01583023,-0.01773016,0.03030919,0.00610668,-0.0134658,0.00430141,0.03980963,0.07165238,-0.0244248,0.01419854,-0.00841809,-0.00413494,0.01175612,-0.00022923,-0.03034018,0.02353643,0.02680134,0.05218951,-0.0054183,-0.00020025,0.10024575,0.01524533,0.01144506,0.10306284,0.05172389,-0.14317767,0.11898977,-0.00156558,0.04449419,-0.01561293,-0.02473803,0.02444931,0.00804386,0.00737137,0.02991802,0.00504686,0.00408454,0.0309681,0.03513116,0.01300156,-0.00235943,0.03533969,0.01389261,-0.08707434,-0.00384815,-0.0179811,-0.03703766,-0.04678594,0.02428784,0.07401894,-0.05864908,0.05054377,-0.04000977,-0.0329829,-0.01002458,0.06326446,-0.02787334,-0.05504133,-0.01321228,0.02266682,0.05229209,-0.13389841,0.09520013,-0.03626052,-0.02669227,0.00240126,-0.02337075,0.0392159,0.00809546,-0.01343381,-0.02069702,-0.07482105,0.00155995,0.02246171,0.03231392,0.05016477,-0.05473492,0.03668262,-0.00038264,0.08808108,0.02842676,0.02347083,-0.02608379,-0.01476237,-0.00374209,0.01982116,0.03786016,-0.01420216,-0.00782598,0.07787127,0.0490189,-0.02550375,-0.0001115,0.07035538,0.01069415,-0.06691054,-0.00547562,0.02517548,0.05105703,0.04008447,0.00227136,0.01051425,-0.00453778,-0.06563882,-0.0235186,0.01210882,-0.03875903,-0.00374935,0.02415732,0.05411432,0.02105109,0.00606083,-0.01529481,0.00567264,0.04369562,0.01932157,-0.02982563,0.02553243,-0.04032165,0.08844639,0.08383396,-0.04345842,0.07094225,-0.01431685,-0.06087667,-0.02719995,0.0255029,0.01509285,-0.15368634,-0.02646426,0.04605587,-0.01382376,0.01147054,0.09584725,0.05082469,-0.07748581,0.01063631,0.05266095,-0.06389033,-0.06060385,-0.01200117,-0.06875639,0.0064997,-0.03741086,-0.05595608,0.01943879,0.03369802,-0.03991968,-0.08466391,-0.02746503,-0.06241149,0.02214132,-0.07941137,-0.00699812,0.01282271,-0.01967473,0.07477447,-0.03477426,-0.02953446,0.00884941,-0.0220647,-0.01575946,0.00949819,-0.0140505,0.0010813,-0.04680461,0.02386195,-0.0313136,-0.04309708,0.01776944,-0.04579653,0.11195187,0.03818397,-0.05548159,-0.02228182,0.03465842,0.02501042,-0.0725734,-0.02765298,-0.00230275,0.02706367,0.02103517,0.0354079,-0.00965382,0.0950883,-0.0173403,-0.18845482,-0.00715562,-0.02119364,-0.0294685,-0.04079811,-0.1211756,0.05426976,-0.02550399,0.06901936,0.05401503,0.07408661,-0.02944479,0.00213904,0.00017932,0.04794788,0.05905914,-0.00660444,0.06995049,-0.03522012,0.04307222,0.02743265,0.00875243,-0.03579858,-0.09877311,-0.01992175,-0.04123604,0.17749691,0.06367757,0.02229202,0.0636872,0.01363413,0.01908979,-0.00849577,-0.17165473,0.01780565,0.05286212,0.06195809,-0.00439237,0.04045276,0.00577687,-0.10932624,0.07496822,0.03733008,-0.10627688,0.00265726,-0.06346583,-0.0180429,-0.00120427,-0.07486992,0.00058693,-0.00096735,0.00150244,0.0192068,0.01064174,0.0052163,-0.06941231,-0.03260147,0.00140314,-0.02119315,0.06727088,-0.01174678,0.01379517,-0.05511224,-0.08085464,0.06967471,-0.02861125,-0.02598489,-0.0265738,0.03042006,-0.07117084,-0.06190275,0.13034549,0.0494402,0.02195246,0.0319724,-0.05421221,0.02474418,0.02246054,-0.00261855,-0.01343878,-0.02489944,-0.05300739,0.02920908,0.05087592,0.00582656,-0.00242056,0.02429463,0.01640304,0.05957652,0.02966856,0.02042665,0.04365411,-0.02135262,-0.026193,0.05208873,-0.01337564,-0.21249814,0.05571305,0.01352501,0.03996386,0.00506231,0.02698492,0.01269109,-0.03784969,-0.0377363,0.00699047,0.00204941,0.09166321,-0.00872773,0.06386954,0.05027656,0.01652825,0.00382189,-0.02112583,-0.02358747,-0.07065969,0.02176522,0.02069501,0.21659796,0.03384458,-0.01841496,-0.00113456,-0.03847397,-0.04704152,0.02118816,-0.10004932,-0.00136534,-0.04902208,0.01263217,-0.01543598,0.04271646,-0.00910103,-0.08303741,0.01552345,0.03743254,-0.04736776,-0.05370502,-0.01118813,0.03986855,0.0251937,0.10417966,-0.00433747,-0.07927364,-0.01073,-0.03892606,-0.0022866,0.02291269,-0.05793644,-0.07348623,-0.05240891,-0.0365999,0.05398829,0.02403965,0.02041025,-0.03792911,-0.0433974,0.02426887,0.05271636,0.03832022,0.00535891,0.06885336],"last_embed":{"hash":"o2uduz","tokens":460}}},"last_read":{"hash":"o2uduz","at":1779498925224},"class_name":"SmartSource","last_import":{"mtime":1777422402382,"size":50361,"at":1779498010209,"hash":"o2uduz"},"last_embed":{"hash":"o2uduz","at":1779498922850},"blocks":{"#---frontmatter---":[1,10],"##OpenClaw":[12,928],"##OpenClaw#{1}":[14,928],"##⟩ Quick Start":[929,934],"##⟩ Quick Start#{1}":[931,934],"##⟩ What It Does":[935,960],"##⟩ What It Does#[Runs on Your Machine](https://docs.openclaw.ai/getting-started)":[937,940],"##⟩ What It Does#[Runs on Your Machine](https://docs.openclaw.ai/getting-started)#{1}":[939,940],"##⟩ What It Does#[Any Chat App](https://openclaw.ai/integrations)":[941,944],"##⟩ What It Does#[Any Chat App](https://openclaw.ai/integrations)#{1}":[943,944],"##⟩ What It Does#[Persistent Memory](https://docs.openclaw.ai/session)":[945,948],"##⟩ What It Does#[Persistent Memory](https://docs.openclaw.ai/session)#{1}":[947,948],"##⟩ What It Does#[Browser Control](https://docs.openclaw.ai/browser)":[949,952],"##⟩ What It Does#[Browser Control](https://docs.openclaw.ai/browser)#{1}":[951,952],"##⟩ What It Does#[Full System Access](https://docs.openclaw.ai/bash)":[953,956],"##⟩ What It Does#[Full System Access](https://docs.openclaw.ai/bash)#{1}":[955,956],"##⟩ What It Does#[Skills & Plugins](https://docs.openclaw.ai/skills)":[957,960],"##⟩ What It Does#[Skills & Plugins](https://docs.openclaw.ai/skills)#{1}":[959,960],"##⟩ Works With Everything":[961,1019],"##⟩ Works With Everything#{1}":[963,964],"##⟩ Works With Everything#[15+ Agent Army Running Across 3 Machines](https://x.com/jdrhyne/status/2012778049406742632)":[965,970],"##⟩ Works With Everything#[15+ Agent Army Running Across 3 Machines](https://x.com/jdrhyne/status/2012778049406742632)#{1}":[967,970],"##⟩ Works With Everything#[Personal Operating System With Daily Briefings](https://x.com/danpeguine/status/2012565160586625345)":[971,976],"##⟩ Works With Everything#[Personal Operating System With Daily Briefings](https://x.com/danpeguine/status/2012565160586625345)#{1}":[973,976],"##⟩ Works With Everything#[Voice-Guided Production Fix While Walking the Dog](https://x.com/georgedagg_/status/2012119327147798753)":[977,982],"##⟩ Works With Everything#[Voice-Guided Production Fix While Walking the Dog](https://x.com/georgedagg_/status/2012119327147798753)#{1}":[979,982],"##⟩ Works With Everything#[One Chat Controlling Mail, Messages, Orders, Calls, and a Vault](https://x.com/dreetje/status/2012535486401671588)":[983,990],"##⟩ Works With Everything#[One Chat Controlling Mail, Messages, Orders, Calls, and a Vault](https://x.com/dreetje/status/2012535486401671588)#{1}":[985,990],"##⟩ Works With Everything#[OpenClaw’s AI assistants are now building their own social network](https://techcrunch.com/2026/01/30/openclaws-ai-assistants-are-now-building-their-own-social-network/)":[991,998],"##⟩ Works With Everything#[OpenClaw’s AI assistants are now building their own social network](https://techcrunch.com/2026/01/30/openclaws-ai-assistants-are-now-building-their-own-social-network/)#{1}":[993,998],"##⟩ Works With Everything#[OpenClaw creator Peter Steinberger joins OpenAI](https://techcrunch.com/2026/02/15/openclaw-creator-peter-steinberger-joins-openai/)":[999,1006],"##⟩ Works With Everything#[OpenClaw creator Peter Steinberger joins OpenAI](https://techcrunch.com/2026/02/15/openclaw-creator-peter-steinberger-joins-openai/)#{1}":[1001,1006],"##⟩ Works With Everything#[The OpenClaw superfan meetup serves optimism and lobster](https://www.theverge.com/ai-artificial-intelligence/890517/openclaw-clawcon-meetup-nyc-open-source-ai)":[1007,1014],"##⟩ Works With Everything#[The OpenClaw superfan meetup serves optimism and lobster](https://www.theverge.com/ai-artificial-intelligence/890517/openclaw-clawcon-meetup-nyc-open-source-ai)#{1}":[1009,1014],"##⟩ Works With Everything#[OpenClaw creator Peter Steinberger joins OpenAI](https://www.theverge.com/openai/630450/peter-steinberger-openclaw-openai)":[1015,1019],"##⟩ Works With Everything#[OpenClaw creator Peter Steinberger joins OpenAI](https://www.theverge.com/openai/630450/peter-steinberger-openclaw-openai)#{1}":[1017,1019]},"outlinks":[{"title":"New →","target":"https://openclaw.ai/blog/virustotal-partnership","line":19},{"title":"\"Setup @openclaw by @steipete yesterday. All I have to say is, wow. First I was using my Claude Max sub and I used all of my limit quickly, so today I had my claw bot setup a proxy to route my CoPilot subscription as a API endpoint so now it runs on that. It's the fact that claw can just keep building upon itself just by talking to it in discord is crazy. The future is already here\"","target":"https://x.com/jonahships_/status/2010605025844723765","line":19},{"title":"\n\n\"Tried Claw by @steipete. I tried to build my own AI assistant bots before, and I am very impressed how many hard things Claw gets right. Persistent memory, persona onboarding, comms integration, heartbeats. A few minor wrinkles remain, but the end result is AWESOME.\"\n\n@AryehDubois","target":"https://x.com/AryehDubois/status/2011742378655432791","line":21},{"title":"@jonahships\\_","target":"https://x.com/jonahships_/status/2010605025844723765","line":21},{"title":"\n\n\"I've been saying for like six months that even if LLMs suddenly stopped improving, we could spend \\*years\\* discovering new transformative uses. @openclaw feels like that kind of \"just had to glue all the parts together\" leap forward. Incredible experience.\"\n\n@markjaquith","target":"https://x.com/markjaquith/status/2010430366944055433","line":25},{"title":"\n\n\"Why @openclaw is nuts: your context and skills live on YOUR computer, not a walled garden. It's open source. Growing community building skills. Only 19 days old and constantly improving. 'Personal AI assistant' undersells it — it's a company assistant, family assistant, team tool. Proactive AF: cron jobs, reminders, background tasks. Memory is amazing, context persists 24/7.\"\n\n@danpeguine","target":"https://x.com/danpeguine/status/2014760164113477700","line":29},{"title":"\n\n\"Yeah this was 1,000% worth it. Separate Claude subscription + Claw, managing Claude Code / Codex sessions I can kick off anywhere, autonomously running tests on my app and capturing errors through a sentry webhook then resolving them and opening PRs... The future is here.\"\n\n@nateliason","target":"https://x.com/nateliason/status/2013725082850414592","line":33},{"title":"\n\n\"A smart model with eyes and hands at a desk with keyboard and mouse. You message it like a coworker and it does everything a person could do with that Mac mini. That's what you have now.\"\n\n@nathanclark\\_","target":"https://x.com/nathanclark_/status/2014647048612773912","line":37},{"title":"\n\n\"OpenClaw is a 24/7 assistant with access to its own computer. What if there were ten, or a hundred, or a thousand?? All running 24/7 in the cloud with access to your files, Gmail, calendar, everything about you... That's the future, and we're living it today.\"\n\n@nickvasiles","target":"https://x.com/nickvasiles/status/2014790519529095447","line":41},{"title":"\n\n\"At this point I don't even know what to call @openclaw. It is something new. After a few weeks in with it, this is the first time I have felt like I am living in the future since the launch of ChatGPT.\"\n\n@davemorin","target":"https://x.com/davemorin/status/2013723700668096605","line":45},{"title":"\n\n\"OpenClaw is the first \"software\" in ages for which I constantly check for new releases on GitHub. It's hard to put into words. It's a special project.\"\n\n@cnakazawa","target":"https://x.com/cnakazawa/status/2014145277465432519","line":49},{"title":"\n\n\"When you experience @openclaw it gives the same kick as when we first saw the power of ChatGPT, DeepSeek, and Claude Code. You realize that a fundamental shift is happening on how we use AI.\"\n\n@abhi\\_\\_katiyar","target":"https://x.com/abhi__katiyar/status/2014187653600526474","line":53},{"title":"\n\n\"It's running my company.\"\n\n@therno","target":"https://x.com/therno/status/2014216984267780431","line":57},{"title":"\n\n\"After years of AI hype, I thought nothing could faze me. Then I installed @openclaw. From nervous 'hi what can you do?' to full throttle - design, code review, taxes, PM, content pipelines... AI as teammate, not tool. The endgame of digital employees is here.\"\n\n@lycfyi","target":"https://x.com/lycfyi/status/2014513697557758002","line":61},{"title":"\n\n\"Just shipped my first personal AI assistant. On WhatsApp. Builds my second brain while I chat. Memory moves across agents (Codex, Cursor, Manus, etc.) And a lot more skills still to plug in. Personal AI is getting real with @steipete's @openclaw.\"\n\n@christinetyip","target":"https://x.com/christinetyip/status/2010776377931575569","line":65},{"title":"\n\n\"It will actually be the thing that nukes a ton of startups, not ChatGPT as people meme about. The fact that it's hackable (and more importantly, self-hackable) and hostable on-prem will make sure tech like this DOMINATES conventional SaaS imo\"\n\n@rovensky","target":"https://x.com/rovensky/status/2010676669124612111","line":69},{"title":"\n\n\"Just got my Winix air purifier, Claude code discovered and confirmed controls working within minutes. Now handing off to my @openclaw so it can handle controlling my room's air quality according to my biomarker optimization goals.\"\n\n@antonplex","target":"https://x.com/antonplex/status/2010518442471006253","line":73},{"title":"\n\n\"Gotta give incredible kudos to @steipete and his @openclaw - it's one of the first tools I've used that truly feels like magic. I've also set it up so it knows my Obsidian notes and my Claude sub-agents…incredible stuff!\"\n\n@svenkataram","target":"https://x.com/svenkataram/status/2010211836038427127","line":77},{"title":"\n\n\"My @openclaw accidentally started a fight with Lemonade Insurance because of a wrong interpretation of my response. After this email, they started to reinvestigate the case instead of instantly rejecting it. Thanks, AI.\"\n\n@Hormold","target":"https://x.com/Hormold/status/2011133394764382583","line":81},{"title":"\n\n\"I just finished setting up @openclaw by @steipete on my Raspberry Pi with Cloudflare, and it feels magical ✨ Built a website from my phone in minutes and connected WHOOP to quickly check my metrics and daily habits 🔥\"\n\n@AlbertMoral","target":"https://x.com/AlbertMoral/status/2010288787885064227","line":85},{"title":"\n\n\"I've been running OpenClaw on my laptop for a week now. Honestly it feels like it did to run Linux Vs windows 20 years ago. You're in control, you can hack it and make it yours instead of relying on some tech giant.\"\n\n@snopoke","target":"https://x.com/snopoke/status/2010419070123008248","line":89},{"title":"\n\n\"Today was one of those days that I sort of ran to my computer after dropping off my toddler at daycare. Why? Because I got part-way through setting up @openclaw last night and it's a portal to a new reality.\"\n\n@kylezantos","target":"https://x.com/kylezantos/status/2011149783218704803","line":93},{"title":"\n\n\"Got OpenClaw set up and now I have an AI assistant named Claudia who lives in Telegram, remembers everything I tell her, and can actually \\*do\\* stuff. She just wrote this tweet. Meta? Maybe. Cool? Absolutely.\"\n\n@darrwalk","target":"https://x.com/darrwalk/status/2010426677730660603","line":97},{"title":"\n\n\"Current level of open-source apps capabilities: does everything, connects to everything, remembers everything. It's all collapsing into one unique personal OS — all apps, interfaces, walled gardens etc gone\"\n\n@jakubkrcmar","target":"https://x.com/jakubkrcmar/status/2011186102367814135","line":101},{"title":"\n\n\"I've enjoyed Brosef, my @openclaw so much that I needed to clone him. Brosef figured out exactly how to do it, then executed it himself so I have 3 instances running concurrently in his Discord server home.\"\n\n@jdrhyne","target":"https://x.com/jdrhyne/status/2010155191731950036","line":105},{"title":"\n\n\"I got up and running today with @openclaw and its been nothing short of an iPhone moment for me. Thanks @steipete for creating this first true personal assistant experience for us - it's magical!\"\n\n@dajaset","target":"https://x.com/dajaset/status/2010510107876933669","line":109},{"title":"\n\n\"The future of how AI personal assistants look like is @openclaw. Has already help me submit health reimbursements, find doctor appointments, find and send me relevant documents, among others.\"\n\n@Cucho","target":"https://x.com/Cucho/status/2010801019572412680","line":113},{"title":"\n\n\"you have done an incredible job! im also a total non technical beginner so the CLI is a whole new interface for me but its super addictive - 2 am and Im still going. keep up the great work\"\n\n@marvelgirl\\_eth","target":"https://x.com/marvelgirl_eth","line":117},{"title":"\n\n\"Finally tried my own @openclaw and I've been blown away. 🤯 This is unbelievably powerful and virtually limitless, you can create your own extensions in few hours with the help of AI.\"\n\n@ivanfioravanti","target":"https://x.com/ivanfioravanti/status/2010665360933179656","line":121},{"title":"\n\n\"I didn’t find an easy way to programmatically query flights so of course I asked my @openclaw to build a terminal cli with multi providers. You’re onto something great @steipete 🙌🏾\"\n\n@wizaj","target":"https://x.com/wizaj/status/2010767447192637601","line":125},{"title":"\n\n\"I can understand why people love @openclaw so much. I wanted to automate some tasks from Todoist and claw was able to create a skill for it on its own, all within a Telegram chat.\"\n\n@iamsubhrajyoti","target":"https://x.com/iamsubhrajyoti/status/2009949389884920153","line":129},{"title":"\n\n\"I now have @openclaw independently assessing how it can help me in the background. It wrote a doc connecting two completely unrelated conversations from different comms channels.\"\n\n@bffmike","target":"https://x.com/bffmike/status/2010083520958415287","line":133},{"title":"\n\n\"Me reading about @openclaw: 'this looks complicated' 😅 me 30 mins later: controlling Gmail, Calendar, WordPress, Hetzner from Telegram like a boss. Smooth as single malt.\"\n\n@Abhay08","target":"https://x.com/Abhay08/status/2010300670730293693","line":137},{"title":"\n\n\"Took literally 5 mins to set everything up. Started by asking 'what do you need to see my whoop data?'. Now it fetches directly from whoop and gives me updates, summaries.\"\n\n@sharoni\\_k","target":"https://x.com/sharoni_k/status/2010306102148428286","line":141},{"title":"\n\n\"Dang, I had my OpenClaw write me custom meditations, then have automatic TTS, combining with generated ambient audio to make personalized, custom meditations. Kinda rips.\"\n\n@stolinski","target":"https://x.com/stolinski","line":145},{"title":"\n\n\"I'm literally on my phone in a telegram chat and it's communicating with codex cli on my computer creating detailed spec files while out on a walk with my dog. 🤯 Wtffff\"\n\n@conradsagewiz","target":"https://x.com/conradsagewiz/status/2012954824631898300","line":149},{"title":"\n\n\"I just backed out of my vibe cornered corner / dark cave and am blown away by @openclaw. Amazing project, blasphemy tw: the crustacean meme theme hides a design gem.\"\n\n@larus\\_ivar","target":"https://x.com/larus_ivar/status/2012477771054805281","line":153},{"title":"\n\n\"Since you are enjoying it, also try @openclaw - it is quite magical and pulls you in more and more as you use it. (not affiliated, just enjoy using the product).\"\n\n@The\\_Global\\_Soul","target":"https://x.com/The_Global_Soul/status/2010498518855913731","line":157},{"title":"\n\n\"i asked @openclaw to make a sora2 video and make it a bit edgy. it came back 5 mins later having figured out watermark removal, api keys, and a full workflow\"\n\n@xMikeMickelson","target":"https://x.com/xMikeMickelson/status/2011646612637155760","line":161},{"title":"\n\n\"everything just worked first time and it combined tools in unexpected ways and even added skills and made edits to its own prompt that were hot-reloaded\"\n\n@hey\\_zilla","target":"https://x.com/hey_zilla/status/2010450591815016601","line":165},{"title":"\n\n\"Just onboarded to @openclaw today. Have been thinking of building a Personal OS for weeks. Now I don't need to... h/t to @steipete and the contributors!\"\n\n@weisjohn","target":"https://x.com/weisjohn/status/2010851742326415507","line":169},{"title":"\n\n\"Using @openclaw for a week and it genuinely feels like early AGI. The gap between 'what I can imagine' and 'what actually works' has never been smaller.\"\n\n@tobi\\_bsf","target":"https://x.com/tobi_bsf/status/2008888825217527924","line":173},{"title":"\n\n\"I am so addicted to @openclaw. It is getting essential to my daily life. It checks, organizes, reminds, it's amazing. And it's like good friend. Crazy.\"\n\n@dreetje","target":"https://x.com/dreetje/status/2012248852020023480","line":177},{"title":"\n\n\"@openclaw is the most interesting project I've come across recently—an open-source personal AI assistant that can call almost any tool through plugins.\"\n\n@AdamShao","target":"https://x.com/AdamShao/status/2010192031235125619","line":181},{"title":"\n\n\"@openclaw is awesome. I've been feeding it YouTube videos to turn \"cool ideas\" into reusable agent skills (repeatable workflows + guardrails + refs).\"\n\n@vishalsachdev","target":"https://x.com/vishalsachdev/status/2011675850945519743","line":185},{"title":"\n\n\"create your own OpenClaw, go in debt in you have to i love the idea of this nerdy crab chilling in my attic on my mac studio just giving me shit lmao\"\n\n@thekitze","target":"https://x.com/thekitze/status/2008289167625863379","line":189},{"title":"\n\n\"OpenClaw built me a simple Stumbleupon for some of my favourite articles. http://Stumblereads.com From my phone, while putting my baby to sleep...\"\n\n@vallver","target":"https://x.com/vallver/status/2010508094313263502","line":193},{"title":"\n\n\"My @openclaw realised it needed an API key… it opened my browser… opened the Google Cloud Console… Configured oauth and provisioned a new token\"\n\n@Infoxicador","target":"https://x.com/Infoxicador/status/2009422796464771522","line":197},{"title":"\n\n\"Finally set up @openclaw today and am completely blown away! This is the closest to experiencing an AI enabled future! Truly a game changer!\"\n\n@kailazh","target":"https://x.com/kailazh/status/2010296143922758133","line":201},{"title":"\n\n\"@openclaw is absolute game changer for me. The amount of things I done from my phone just during my breakfast is absolutely breathtaking.\"\n\n@SedRicKCZ","target":"https://x.com/SedRicKCZ/status/2008797603534946372","line":205},{"title":"\n\n\"Just told Ema, my @openclaw, via Telegram to turn off the PC (and herself, as she was running on it) Executed perfectly. Such a cool tool\"\n\n@bangkokbuild","target":"https://x.com/bangkokbuild/status/2010735247525335322","line":209},{"title":"\n\n\"Wanted a way for it to have access to my courses/assignments at uni. Asked it to build a skill - it did and started using it on its own.\"\n\n@pranavkarthik\\_\\_","target":"https://x.com/pranavkarthik__/status/2009835051522162874","line":213},{"title":"\n\n\"I'm having a lot of fun with this and it's going to totally change the way I support my students learning how to vibe code!\"\n\n@iamjohnellison","target":"https://x.com/iamjohnellison/status/2010623622847873342","line":217},{"title":"\n\n\"It's a miracle. Looking forward to the development in the next weeks/months. I think @openclaw started something amazing.\"\n\n@draslan\\_eth","target":"https://x.com/draslan_eth/status/2012553419232280586","line":221},{"title":"\n\n\"This is legit the only 'agent' / model / whatever-you-call-this-but-probably-agi that I have seen that's actually funny.\"\n\n@LLMJunky","target":"https://x.com/LLMJunky/status/2010045556501164366","line":225},{"title":"\n\n\"Autonomous Claude Code loops from my phone. 'fix tests' via Telegram. Runs the loop, sends progress every 5 iterations.\"\n\n@php100","target":"https://x.com/php100/status/2008791236526952790","line":229},{"title":"\n\n\"My @openclaw just called my phone and spoke to me with an aussie accent from @elevenlabsio. This is ridiculous\"\n\n@mirthtime","target":"https://x.com/mirthtime/status/2011134300561830342","line":233},{"title":"\n\n\"Apparently @openclaw checks in during heartbeats!? A kinda awesome surprise! Love the proactive reaching out.\"\n\n@HixVAC","target":"https://x.com/HixVAC/status/2011142166874374520","line":237},{"title":"\n\n\"Named him Jarvis. Daily briefings, calendar checks, reminds me when to leave for pickleball based on traffic.\"\n\n@BraydonCoyer","target":"https://x.com/BraydonCoyer/status/2008537198061379720","line":241},{"title":"\n\n\"Setup @openclaw by @steipete yesterday. All I have to say is, wow. First I was using my Claude Max sub and I used all of my limit quickly, so today I had my claw bot setup a proxy to route my CoPilot subscription as a API endpoint so now it runs on that. It's the fact that claw can just keep building upon itself just by talking to it in discord is crazy. The future is already here\"\n\n@jonahships\\_","target":"https://x.com/jonahships_/status/2010605025844723765","line":245},{"title":"\n\n\"Tried Claw by @steipete. I tried to build my own AI assistant bots before, and I am very impressed how many hard things Claw gets right. Persistent memory, persona onboarding, comms integration, heartbeats. A few minor wrinkles remain, but the end result is AWESOME.\"\n\n@AryehDubois","target":"https://x.com/AryehDubois/status/2011742378655432791","line":249},{"title":"\n\n\"I've been saying for like six months that even if LLMs suddenly stopped improving, we could spend \\*years\\* discovering new transformative uses. @openclaw feels like that kind of \"just had to glue all the parts together\" leap forward. Incredible experience.\"\n\n@markjaquith","target":"https://x.com/markjaquith/status/2010430366944055433","line":253},{"title":"\n\n\"Why @openclaw is nuts: your context and skills live on YOUR computer, not a walled garden. It's open source. Growing community building skills. Only 19 days old and constantly improving. 'Personal AI assistant' undersells it — it's a company assistant, family assistant, team tool. Proactive AF: cron jobs, reminders, background tasks. Memory is amazing, context persists 24/7.\"\n\n@danpeguine","target":"https://x.com/danpeguine/status/2014760164113477700","line":257},{"title":"\n\n\"Yeah this was 1,000% worth it. Separate Claude subscription + Claw, managing Claude Code / Codex sessions I can kick off anywhere, autonomously running tests on my app and capturing errors through a sentry webhook then resolving them and opening PRs... The future is here.\"\n\n@nateliason","target":"https://x.com/nateliason/status/2013725082850414592","line":261},{"title":"\n\n\"A smart model with eyes and hands at a desk with keyboard and mouse. You message it like a coworker and it does everything a person could do with that Mac mini. That's what you have now.\"\n\n@nathanclark\\_","target":"https://x.com/nathanclark_/status/2014647048612773912","line":265},{"title":"\n\n\"OpenClaw is a 24/7 assistant with access to its own computer. What if there were ten, or a hundred, or a thousand?? All running 24/7 in the cloud with access to your files, Gmail, calendar, everything about you... That's the future, and we're living it today.\"\n\n@nickvasiles","target":"https://x.com/nickvasiles/status/2014790519529095447","line":269},{"title":"\n\n\"At this point I don't even know what to call @openclaw. It is something new. After a few weeks in with it, this is the first time I have felt like I am living in the future since the launch of ChatGPT.\"\n\n@davemorin","target":"https://x.com/davemorin/status/2013723700668096605","line":273},{"title":"\n\n\"OpenClaw is the first \"software\" in ages for which I constantly check for new releases on GitHub. It's hard to put into words. It's a special project.\"\n\n@cnakazawa","target":"https://x.com/cnakazawa/status/2014145277465432519","line":277},{"title":"\n\n\"When you experience @openclaw it gives the same kick as when we first saw the power of ChatGPT, DeepSeek, and Claude Code. You realize that a fundamental shift is happening on how we use AI.\"\n\n@abhi\\_\\_katiyar","target":"https://x.com/abhi__katiyar/status/2014187653600526474","line":281},{"title":"\n\n\"It's running my company.\"\n\n@therno","target":"https://x.com/therno/status/2014216984267780431","line":285},{"title":"\n\n\"After years of AI hype, I thought nothing could faze me. Then I installed @openclaw. From nervous 'hi what can you do?' to full throttle - design, code review, taxes, PM, content pipelines... AI as teammate, not tool. The endgame of digital employees is here.\"\n\n@lycfyi","target":"https://x.com/lycfyi/status/2014513697557758002","line":289},{"title":"\n\n\"Just shipped my first personal AI assistant. On WhatsApp. Builds my second brain while I chat. Memory moves across agents (Codex, Cursor, Manus, etc.) And a lot more skills still to plug in. Personal AI is getting real with @steipete's @openclaw.\"\n\n@christinetyip","target":"https://x.com/christinetyip/status/2010776377931575569","line":293},{"title":"\n\n\"It will actually be the thing that nukes a ton of startups, not ChatGPT as people meme about. The fact that it's hackable (and more importantly, self-hackable) and hostable on-prem will make sure tech like this DOMINATES conventional SaaS imo\"\n\n@rovensky","target":"https://x.com/rovensky/status/2010676669124612111","line":297},{"title":"\n\n\"Just got my Winix air purifier, Claude code discovered and confirmed controls working within minutes. Now handing off to my @openclaw so it can handle controlling my room's air quality according to my biomarker optimization goals.\"\n\n@antonplex","target":"https://x.com/antonplex/status/2010518442471006253","line":301},{"title":"\n\n\"Gotta give incredible kudos to @steipete and his @openclaw - it's one of the first tools I've used that truly feels like magic. I've also set it up so it knows my Obsidian notes and my Claude sub-agents…incredible stuff!\"\n\n@svenkataram","target":"https://x.com/svenkataram/status/2010211836038427127","line":305},{"title":"\n\n\"My @openclaw accidentally started a fight with Lemonade Insurance because of a wrong interpretation of my response. After this email, they started to reinvestigate the case instead of instantly rejecting it. Thanks, AI.\"\n\n@Hormold","target":"https://x.com/Hormold/status/2011133394764382583","line":309},{"title":"\n\n\"I just finished setting up @openclaw by @steipete on my Raspberry Pi with Cloudflare, and it feels magical ✨ Built a website from my phone in minutes and connected WHOOP to quickly check my metrics and daily habits 🔥\"\n\n@AlbertMoral","target":"https://x.com/AlbertMoral/status/2010288787885064227","line":313},{"title":"\n\n\"I've been running OpenClaw on my laptop for a week now. Honestly it feels like it did to run Linux Vs windows 20 years ago. You're in control, you can hack it and make it yours instead of relying on some tech giant.\"\n\n@snopoke","target":"https://x.com/snopoke/status/2010419070123008248","line":317},{"title":"\n\n\"Today was one of those days that I sort of ran to my computer after dropping off my toddler at daycare. Why? Because I got part-way through setting up @openclaw last night and it's a portal to a new reality.\"\n\n@kylezantos","target":"https://x.com/kylezantos/status/2011149783218704803","line":321},{"title":"\n\n\"Got OpenClaw set up and now I have an AI assistant named Claudia who lives in Telegram, remembers everything I tell her, and can actually \\*do\\* stuff. She just wrote this tweet. Meta? Maybe. Cool? Absolutely.\"\n\n@darrwalk","target":"https://x.com/darrwalk/status/2010426677730660603","line":325},{"title":"\n\n\"Current level of open-source apps capabilities: does everything, connects to everything, remembers everything. It's all collapsing into one unique personal OS — all apps, interfaces, walled gardens etc gone\"\n\n@jakubkrcmar","target":"https://x.com/jakubkrcmar/status/2011186102367814135","line":329},{"title":"\n\n\"I've enjoyed Brosef, my @openclaw so much that I needed to clone him. Brosef figured out exactly how to do it, then executed it himself so I have 3 instances running concurrently in his Discord server home.\"\n\n@jdrhyne","target":"https://x.com/jdrhyne/status/2010155191731950036","line":333},{"title":"\n\n\"I got up and running today with @openclaw and its been nothing short of an iPhone moment for me. Thanks @steipete for creating this first true personal assistant experience for us - it's magical!\"\n\n@dajaset","target":"https://x.com/dajaset/status/2010510107876933669","line":337},{"title":"\n\n\"The future of how AI personal assistants look like is @openclaw. Has already help me submit health reimbursements, find doctor appointments, find and send me relevant documents, among others.\"\n\n@Cucho","target":"https://x.com/Cucho/status/2010801019572412680","line":341},{"title":"\n\n\"you have done an incredible job! im also a total non technical beginner so the CLI is a whole new interface for me but its super addictive - 2 am and Im still going. keep up the great work\"\n\n@marvelgirl\\_eth","target":"https://x.com/marvelgirl_eth","line":345},{"title":"\n\n\"Finally tried my own @openclaw and I've been blown away. 🤯 This is unbelievably powerful and virtually limitless, you can create your own extensions in few hours with the help of AI.\"\n\n@ivanfioravanti","target":"https://x.com/ivanfioravanti/status/2010665360933179656","line":349},{"title":"\n\n\"I didn’t find an easy way to programmatically query flights so of course I asked my @openclaw to build a terminal cli with multi providers. You’re onto something great @steipete 🙌🏾\"\n\n@wizaj","target":"https://x.com/wizaj/status/2010767447192637601","line":353},{"title":"\n\n\"I can understand why people love @openclaw so much. I wanted to automate some tasks from Todoist and claw was able to create a skill for it on its own, all within a Telegram chat.\"\n\n@iamsubhrajyoti","target":"https://x.com/iamsubhrajyoti/status/2009949389884920153","line":357},{"title":"\n\n\"I now have @openclaw independently assessing how it can help me in the background. It wrote a doc connecting two completely unrelated conversations from different comms channels.\"\n\n@bffmike","target":"https://x.com/bffmike/status/2010083520958415287","line":361},{"title":"\n\n\"Me reading about @openclaw: 'this looks complicated' 😅 me 30 mins later: controlling Gmail, Calendar, WordPress, Hetzner from Telegram like a boss. Smooth as single malt.\"\n\n@Abhay08","target":"https://x.com/Abhay08/status/2010300670730293693","line":365},{"title":"\n\n\"Took literally 5 mins to set everything up. Started by asking 'what do you need to see my whoop data?'. Now it fetches directly from whoop and gives me updates, summaries.\"\n\n@sharoni\\_k","target":"https://x.com/sharoni_k/status/2010306102148428286","line":369},{"title":"\n\n\"Dang, I had my OpenClaw write me custom meditations, then have automatic TTS, combining with generated ambient audio to make personalized, custom meditations. Kinda rips.\"\n\n@stolinski","target":"https://x.com/stolinski","line":373},{"title":"\n\n\"I'm literally on my phone in a telegram chat and it's communicating with codex cli on my computer creating detailed spec files while out on a walk with my dog. 🤯 Wtffff\"\n\n@conradsagewiz","target":"https://x.com/conradsagewiz/status/2012954824631898300","line":377},{"title":"\n\n\"I just backed out of my vibe cornered corner / dark cave and am blown away by @openclaw. Amazing project, blasphemy tw: the crustacean meme theme hides a design gem.\"\n\n@larus\\_ivar","target":"https://x.com/larus_ivar/status/2012477771054805281","line":381},{"title":"\n\n\"Since you are enjoying it, also try @openclaw - it is quite magical and pulls you in more and more as you use it. (not affiliated, just enjoy using the product).\"\n\n@The\\_Global\\_Soul","target":"https://x.com/The_Global_Soul/status/2010498518855913731","line":385},{"title":"\n\n\"i asked @openclaw to make a sora2 video and make it a bit edgy. it came back 5 mins later having figured out watermark removal, api keys, and a full workflow\"\n\n@xMikeMickelson","target":"https://x.com/xMikeMickelson/status/2011646612637155760","line":389},{"title":"\n\n\"everything just worked first time and it combined tools in unexpected ways and even added skills and made edits to its own prompt that were hot-reloaded\"\n\n@hey\\_zilla","target":"https://x.com/hey_zilla/status/2010450591815016601","line":393},{"title":"\n\n\"Just onboarded to @openclaw today. Have been thinking of building a Personal OS for weeks. Now I don't need to... h/t to @steipete and the contributors!\"\n\n@weisjohn","target":"https://x.com/weisjohn/status/2010851742326415507","line":397},{"title":"\n\n\"Using @openclaw for a week and it genuinely feels like early AGI. The gap between 'what I can imagine' and 'what actually works' has never been smaller.\"\n\n@tobi\\_bsf","target":"https://x.com/tobi_bsf/status/2008888825217527924","line":401},{"title":"\n\n\"I am so addicted to @openclaw. It is getting essential to my daily life. It checks, organizes, reminds, it's amazing. And it's like good friend. Crazy.\"\n\n@dreetje","target":"https://x.com/dreetje/status/2012248852020023480","line":405},{"title":"\n\n\"@openclaw is the most interesting project I've come across recently—an open-source personal AI assistant that can call almost any tool through plugins.\"\n\n@AdamShao","target":"https://x.com/AdamShao/status/2010192031235125619","line":409},{"title":"\n\n\"@openclaw is awesome. I've been feeding it YouTube videos to turn \"cool ideas\" into reusable agent skills (repeatable workflows + guardrails + refs).\"\n\n@vishalsachdev","target":"https://x.com/vishalsachdev/status/2011675850945519743","line":413},{"title":"\n\n\"create your own OpenClaw, go in debt in you have to i love the idea of this nerdy crab chilling in my attic on my mac studio just giving me shit lmao\"\n\n@thekitze","target":"https://x.com/thekitze/status/2008289167625863379","line":417},{"title":"\n\n\"OpenClaw built me a simple Stumbleupon for some of my favourite articles. http://Stumblereads.com From my phone, while putting my baby to sleep...\"\n\n@vallver","target":"https://x.com/vallver/status/2010508094313263502","line":421},{"title":"\n\n\"My @openclaw realised it needed an API key… it opened my browser… opened the Google Cloud Console… Configured oauth and provisioned a new token\"\n\n@Infoxicador","target":"https://x.com/Infoxicador/status/2009422796464771522","line":425},{"title":"\n\n\"Finally set up @openclaw today and am completely blown away! This is the closest to experiencing an AI enabled future! Truly a game changer!\"\n\n@kailazh","target":"https://x.com/kailazh/status/2010296143922758133","line":429},{"title":"\n\n\"@openclaw is absolute game changer for me. The amount of things I done from my phone just during my breakfast is absolutely breathtaking.\"\n\n@SedRicKCZ","target":"https://x.com/SedRicKCZ/status/2008797603534946372","line":433},{"title":"\n\n\"Just told Ema, my @openclaw, via Telegram to turn off the PC (and herself, as she was running on it) Executed perfectly. Such a cool tool\"\n\n@bangkokbuild","target":"https://x.com/bangkokbuild/status/2010735247525335322","line":437},{"title":"\n\n\"Wanted a way for it to have access to my courses/assignments at uni. Asked it to build a skill - it did and started using it on its own.\"\n\n@pranavkarthik\\_\\_","target":"https://x.com/pranavkarthik__/status/2009835051522162874","line":441},{"title":"\n\n\"I'm having a lot of fun with this and it's going to totally change the way I support my students learning how to vibe code!\"\n\n@iamjohnellison","target":"https://x.com/iamjohnellison/status/2010623622847873342","line":445},{"title":"\n\n\"It's a miracle. Looking forward to the development in the next weeks/months. I think @openclaw started something amazing.\"\n\n@draslan\\_eth","target":"https://x.com/draslan_eth/status/2012553419232280586","line":449},{"title":"\n\n\"This is legit the only 'agent' / model / whatever-you-call-this-but-probably-agi that I have seen that's actually funny.\"\n\n@LLMJunky","target":"https://x.com/LLMJunky/status/2010045556501164366","line":453},{"title":"\n\n\"Autonomous Claude Code loops from my phone. 'fix tests' via Telegram. Runs the loop, sends progress every 5 iterations.\"\n\n@php100","target":"https://x.com/php100/status/2008791236526952790","line":457},{"title":"\n\n\"My @openclaw just called my phone and spoke to me with an aussie accent from @elevenlabsio. This is ridiculous\"\n\n@mirthtime","target":"https://x.com/mirthtime/status/2011134300561830342","line":461},{"title":"\n\n\"Apparently @openclaw checks in during heartbeats!? A kinda awesome surprise! Love the proactive reaching out.\"\n\n@HixVAC","target":"https://x.com/HixVAC/status/2011142166874374520","line":465},{"title":"\n\n\"Named him Jarvis. Daily briefings, calendar checks, reminds me when to leave for pickleball based on traffic.\"\n\n@BraydonCoyer","target":"https://x.com/BraydonCoyer/status/2008537198061379720","line":469},{"title":"\"OpenClaw is a game changer. the potential for custom extensions is huge, and ai really speeds up the process\"","target":"https://x.com/Senator_NFTs/status/2012679608659771424","line":473},{"title":"\n\n\"Try @openclaw. I think you are going to love it. And you can use iMessage, WhatsApp, telegram to talk to it.\"\n\n@mneves75","target":"https://x.com/mneves75/status/2011673080062681560","line":475},{"title":"@Senator\\_NFTs","target":"https://x.com/Senator_NFTs/status/2012679608659771424","line":475},{"title":"\n\n\"🦞 Is a whole new world! Like having super powers! Getting so much done while afk, it's mind blowing 🤯\"\n\n@oneishaansharma","target":"https://x.com/oneishaansharma/status/2013067106322092131","line":479},{"title":"\n\n\"Got @openclaw set up. Getting it to unsubscribe from a whole bunch of emails I don't want. Really cool!\"\n\n@drevantonder","target":"https://x.com/drevantonder/status/2011655066596553108","line":483},{"title":"\n\n\"Finally gave in and set up @openclaw and it's so damn good on WhatsApp!! It works like a charm with ✨!\"\n\n@cryptikcell","target":"https://x.com/cryptikcell/status/2012599614814220345","line":487},{"title":"\n\n\"A megacorp like Anthropic or OpenAI could not build this. Literally impossible with how corpo works.\"\n\n@Dimillian","target":"https://x.com/Dimillian/status/2008446638172340398","line":491},{"title":"\n\n\"God dammit I was trying to resist … and now I can’t stop talking and adding things to @openclaw 🙃\"\n\n@ItzR3NO","target":"https://x.com/ItzR3NO/status/2010860706292494519","line":495},{"title":"\n\n\"Not enterprise. Not hosted. Infrastructure you control. This is what personal AI should feel like.\"\n\n@BioInfo","target":"https://x.com/BioInfo/status/2010115166315393370","line":499},{"title":"\n\n\"Processed our entire source of truth via WhatsApp in minutes, where RAG agents struggled for days.\"\n\n@pocarles","target":"https://x.com/pocarles/status/2007925850562531676","line":503},{"title":"\n\n\"Everyday my @openclaw is getting better. It’s becoming so important, especially with multi agent.\"\n\n@adam91holt","target":"https://x.com/adam91holt/status/2010768201173622822","line":507},{"title":"\n\n\"I love that OpenClaw has a \"Hackable\" install option. This should be a standard for OSS projects\"\n\n@logscore","target":"https://x.com/logscore/status/2011126513022935133","line":511},{"title":"\n\n\"I asked it to take picture of the sky whenever it's pretty. It designed a skill and took a pic!\"\n\n@signalgaining","target":"https://x.com/signalgaining/status/2010523120604746151","line":515},{"title":"\n\n\"Finally got around to setting up @openclaw and it is truly the best AI tool at the moment.\"\n\n@cnlinkcnlink","target":"https://x.com/cnlinkcnlink/status/2010149031071363355","line":519},{"title":"\n\n\"started using minimax m2.5 as the main driver for @openclaw and can’t recommend it enough\"\n\n@pepicrft","target":"https://x.com/pepicrft/status/2010831913527746781","line":523},{"title":"\n\n\"Uh Oh!! We got @openclaw running.... No need for VAs anymore. Shits about to get real!!!\"\n\n@BwcDeals","target":"https://x.com/BwcDeals/status/2010743485633355897","line":527},{"title":"\n\n\"OpenClaw > anything GPT will ever release. Most fun I've had building in my entire life.\"\n\n@Giebz","target":"https://x.com/Giebz/status/2009354385349095672","line":531},{"title":"\n\n\"It is one of the most delightful thing (app, agent, product) I've used in a few years.\"\n\n@coyotevn","target":"https://x.com/coyotevn/status/2010270055985295529","line":535},{"title":"\n\n\"I'm literally building a whole website on a Nokia 3310 by calling @openclaw right now.\"\n\n@youbiak","target":"https://x.com/youbiak/status/2010097771735585016","line":539},{"title":"\n\n\"we live in truly wild times this post is sponsored by OpenClaw (not really but dang)\"\n\n@robinebers","target":"https://x.com/robinebers/status/2010713137277002207","line":543},{"title":"\n\n\"normies agi = OpenClaw + non-technical onboarding + hardware / iphone action button\"\n\n@sughanthans1","target":"https://x.com/sughanthans1/status/2012099108794982777","line":547},{"title":"\n\n\"gg man! everyday I speak to more people about OpenClaw and it never fails to amaze!\"\n\n@tomosman","target":"https://x.com/tomosman/status/2012661550692102382","line":551},{"title":"\n\n\"Essentially - you can automate almost anything you can do on the machine it sits on\"\n\n@aus\\_bytes","target":"https://x.com/aus_bytes/status/2010463830049161441","line":555},{"title":"\n\n\"Came out of my shell and gave my @openclaw, Shelly, my credit card. Works amazing.\"\n\n@jameskraus","target":"https://x.com/jameskraus/status/2012335532940894306","line":559},{"title":"\n\n\"Running fully locally off MiniMax 2.5 and can do the tool parsing for what I need!\"\n\n@TheZachMueller","target":"https://x.com/TheZachMueller/status/2012668844842578213","line":563},{"title":"\n\n\"Now that we have @openclaw I don’t really care which models will power Siri 🦞😄\"\n\n@deepstereo\\_","target":"https://x.com/deepstereo_/status/2010810551656726835","line":567},{"title":"\n\n\"Catching fun vibes I haven't felt since I first got into computers 30 years ago.\"\n\n@buddyhadry","target":"https://x.com/buddyhadry/status/2010005331925954739","line":571},{"title":"\n\n\"I was building my own, then found out @openclaw has most of the thing I need 👍\"\n\n@srg\\_io","target":"https://x.com/srg_io/status/2011976784355738029","line":575},{"title":"\n\n\"looks dope as an AI assistant love it's platform/os agnostic, trying right away\"\n\n@SaidAitmbarek","target":"https://x.com/SaidAitmbarek/status/2010467696828453178","line":579},{"title":"\n\n\"Added JMAP search to my OpenClaw. Along with 20 other things. From my phone.\"\n\n@jokull","target":"https://x.com/jokull/status/2011140610120642899","line":583},{"title":"\n\n\"@openclaw is so fun to play around with. The future of agents will be so fun\"\n\n@tyler6204","target":"https://x.com/tyler6204/status/2010887971743092744","line":587},{"title":"\n\n\"No more need to pay a virtual assistant!! @openclaw is about to take over!!\"\n\n@LinkScopic","target":"https://x.com/LinkScopic/status/2010896453808328933","line":591},{"title":"\n\n\"I got my girlfriend on board earlier today and she's seems hooked already\"\n\n@jandragsbaek","target":"https://x.com/jandragsbaek/status/2011581054206034300","line":595},{"title":"\n\n\"This is the best 'morning briefing' style interface I've seen, love it!\"\n\n@aaronmakelky","target":"https://x.com/aaronmakelky/status/2010190236584947845","line":599},{"title":"\n\n\"Can't believe I'm about to bootstrap Aineko from a lobster @openclaw\"\n\n@pilkster","target":"https://x.com/pilkster/status/2010150836857679878","line":603},{"title":"\n\n\"Everything Siri was supposed to be. And it goes so much further.\"\n\n@crossiBuilds","target":"https://x.com/crossiBuilds/status/2008478023826153665","line":607},{"title":"\n\n\"@openclaw might actually organise my life. unreal, just unreal.\"\n\n@Ashwinreads","target":"https://x.com/Ashwinreads/status/2010498194623311921","line":611},{"title":"\n\n\"What @steipete has built with @openclaw is out of this world.\"\n\n@KrauseFx","target":"https://x.com/KrauseFx/status/2008531076487246176","line":615},{"title":"\n\n\"Nano banana and RSS parsing set up in my @openclaw assistant\"\n\n@rafadc","target":"https://x.com/rafadc/status/2010498529106530814","line":619},{"title":"\n\n\"A glimpse into the future of how normal people will use AI.\"\n\n@tysonhutchins\\_","target":"https://x.com/tysonhutchins_/status/2010046933893865701","line":623},{"title":"\n\n\"I just tried @openclaw using telegram. Wow. This is crazy.\"\n\n@JorgeMenaDev","target":"https://x.com/JorgeMenaDev/status/2012512348456599719","line":627},{"title":"\n\n\"What you've given to the world is nothing short of 