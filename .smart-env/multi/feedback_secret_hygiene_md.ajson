
"smart_sources:feedback_secret_hygiene.md": {"path":"feedback_secret_hygiene.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1hqeytk","at":1785795040992},"class_name":"SmartSource","last_import":{"mtime":1783568376740,"size":4809,"at":1785795041005,"hash":"1hqeytk"},"blocks":{"#---frontmatter---":[1,8],"#":[10,40],"##{1}":[12,12],"##{2}":[13,13],"##{3}":[14,14],"##{4}":[15,28],"##{5}":[29,29],"##{6}":[30,30],"##{7}":[31,31],"##{8}":[32,32],"##{9}":[33,33],"##{10}":[34,34],"##{11}":[35,35],"##{12}":[36,36],"##{13}":[37,40]},"outlinks":[{"title":"agent-infrastructure","target":"agent-infrastructure","line":39},{"title":"claude-vault-address","target":"claude-vault-address","line":39},{"title":"records-vs-doctrine","target":"records-vs-doctrine","line":39}],"metadata":{"name":"feedback-secret-hygiene","description":"Never publish ANY derived fingerprint of a real secret value in chat output — not raw, not truncated, not hashed. Hashing is an internal comparison primitive only. User-facing reports surface boolean/categorical outcomes (matches/doesn't match, present/missing, rotated/not), never derived fingerprints. Applies even when the local repo has secret scanners (IDAHO-VAULT does); the agent layer must practice hygiene independently.","metadata":{"node_type":"memory","type":"feedback","originSessionId":"4f03d270-3e64-41cc-b325-30871ab76d55"}},"task_lines":[],"tasks":{},"codeblock_ranges":[]},