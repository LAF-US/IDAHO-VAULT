
"smart_sources:2026-06-15 - Portneuf hospital, Regence split leaves patients out of network.md": {"path":"2026-06-15 - Portneuf hospital, Regence split leaves patients out of network.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"19knbfg","at":1785795033226},"class_name":"SmartSource","last_import":{"mtime":1785775282130,"size":3593,"at":1785795033321,"hash":"19knbfg"},"blocks":{"#---frontmatter---":[1,9],"#":[10,38]},"outlinks":[{"title":"Logan Ramsey","target":"Logan Ramsey","line":5},{"title":"Business & Money","target":"https://www.eastidahonews.com/business/","line":10},{"title":"Portneuf Medical Center","target":"https://s3.us-west-2.amazonaws.com/assets.eastidahonews.com/wp-content/uploads/2023/11/Portneuf-Medical.jpg","line":12,"embedded":true},{"title":"Visit the website","target":"https://www.portneuf.org/network-update/","line":34},{"title":"SUBMIT A CORRECTION","target":"https://www.eastidahonews.com/submit-a-correction/?headline=Portneuf%20hospital,%20Regence%20split%20leaves%20patients%20out%20of%20network&url=https://www.eastidahonews.com/2026/06/portneuf-hospital-regence-split-leaves-patients-out-of-network/","line":36},{"title":"Click here","target":"https://www.eastidahonews.com/eastidahonews-com-code-of-ethics/#onlinecommenting","line":38}],"metadata":{"title":"Portneuf hospital, Regence split leaves patients out of network","source":"https://www.eastidahonews.com/2026/06/portneuf-hospital-regence-split-leaves-patients-out-of-network/","author":["[[Logan Ramsey]]"],"published":"2026-06-15","created":"2026-08-03","description":"POCATELLO — A major insurance provider ended its contract with the largest hospital in southeastern Idaho. In a Monday afternoon news release, Portneuf Health announced that it is now out of network with Regence BlueShield of Idaho. The contract expired on June 15 after months of “good faith negotiations.” The dispute revolves around several issues. […]"},"task_lines":[],"tasks":{},"codeblock_ranges":[]