
"smart_sources:2017-09-25 - “You, Sir, Have a Noble Head Throughout”_.md": {"path":"2017-09-25 - “You, Sir, Have a Noble Head Throughout”_.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"d9h9fl","at":1785795013635},"class_name":"SmartSource","last_import":{"mtime":1785514680810,"size":8057,"at":1785795013699,"hash":"d9h9fl"},"blocks":{"#---frontmatter---":[1,8],"#":[9,48]},"outlinks":[{"title":"William Henry Jackson posing in a studio, his hat in his right hand, his left hand gripping a chair. ","target":"https://www.historycolorado.org/sites/default/files/media/images/2017/10035170.jpg","line":9,"embedded":true},{"title":"Phrenology report","target":"https://www.historycolorado.org/sites/default/files/media/images/2017/1027161558.jpg","line":19,"embedded":true}],"metadata":{"title":"“You, Sir, Have a Noble Head Throughout”:","source":"https://www.historycolorado.org/story/collections-library/2017/09/25/you-sir-have-noble-head-throughout","author":null,"published":"2017-09-25","created":"2026-07-31","description":"“You, Sir, Have a Noble Head Throughout”: - William Henry Jackson is one of the American West’s best-known photographers, and History Colorado is fortunate to hold a large portion of his photographic oeuvre as well as a manuscript collection (MSS #341) containing correspondence, diaries, and other records of Jackson’s remarkable life. One of the more unusual items in our Jackson manuscript collection is a full report of a phrenological examination performed on Jackson when he was 18 years old by “Professor” O.S. Fowler. The pseudoscience of phrenology was popular in the 19th century and posited that the size and shape of a person’s head revealed information about that individual’s personality, character, and capabilities. While the practice has been thoroughly debunked, Fowler at least seems to have hit on something when he described Jackson’s capacity for artistic genius."},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:2017-09-25 - “You, Sir, Have a Noble Head Throughout”_.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"g2vi8o","at":1785795013635},"key":"2017-09-25 - “You, Sir, Have a Noble Head Throughout”_.md#---frontmatter---","lines":[1,8],"size":1123,"outlinks":[],"class_name":"SmartBlock"},
"smart_blocks:2017-09-25 - “You, Sir, Have a Noble Head Throughout”_.md#": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1bc9h0t","at":1785795013635},"key":"2017-09-25 - “You, Sir, Have a Noble Head Throughout”_.md#","lines":[9,48],"size":6889,"outlinks":[{"title":"William Henry Jackson posing in a studio, his hat in his right hand, his left hand gripping a chair. ","target":"https://www.historycolorado.org/sites/default/files/media/images/2017/10035170.jpg","line":1,"embedded":true},{"title":"Phrenology report","target":"https://www.historycolorado.org/sites/default/files/media/images/2017/1027161558.jpg","line":11,"embedded":true}],"class_name":"SmartBlock"},
