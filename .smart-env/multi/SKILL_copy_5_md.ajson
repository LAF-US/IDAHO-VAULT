n Skill#Reference map#{7}":[356,357]},"outlinks":[],"metadata":{"name":"imagegen","description":"Generate or edit raster images when the task benefits from AI-created bitmap visuals such as photos, illustrations, textures, sprites, mockups, or transparent-background cutouts. Use when Codex should create a brand-new image, transform an existing image, or derive visual variants from references, and the output should be a bitmap asset rather than repo-native code or vector. Do not use when the task is better handled by editing existing SVG/vector/code-native assets, extending an established icon or logo system, or building the visual directly in HTML/CSS/canvas."},"task_lines":[],"tasks":{},"codeblock_ranges":[[128,137],[143,149],[155,157],[214,229],[245,253],[256,261],[319,321],[324,326]]},