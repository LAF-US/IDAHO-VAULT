
"smart_sources:2006-09-02 - Risch turns down debate invitation.md": {"path":"2006-09-02 - Risch turns down debate invitation.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"8tuovh","at":1785795005915},"class_name":"SmartSource","last_import":{"mtime":1785184295037,"size":2778,"at":1785795006203,"hash":"8tuovh"},"blocks":{"#---frontmatter---":[1,9],"#":[10,30]},"outlinks":[{"title":"John Miller","target":"John Miller","line":5},{"title":"Idaho","target":"Idaho","line":12}],"metadata":{"title":"Risch turns down debate invitation","source":"https://www.spokesman.com/stories/2006/sep/02/risch-turns-down-debate-invitation/","author":["[[John Miller]]"],"published":"2006-09-02","created":"2026-07-20","description":"BOISE – Republican Gov. Jim Risch on Friday rejected an invitation from Idaho Public Television and the League of Women voters to appear in a Nov. 1 statewide televised debate with Larry LaRocco, his Democratic rival in the lieutenant governor's race. Instead, Risch, who had expressed concern over the format of the league event, has agreed to square off against LaRocco during an Oct. 10 debate, to be televised by NBC-TV affiliate KTVB, which broadcasts in the Boise region.","tags":["#idaho"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:2006-09-02 - Risch turns down debate invitation.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"d3roch","at":1785795005915},"key":"2006-09-02 - Risch turns down debate invitation.md#---frontmatter---","lines":[1,9],"size":708,"outlinks":[{"title":"John Miller","target":"John Miller","line":5}],"class_name":"SmartBlock"},
