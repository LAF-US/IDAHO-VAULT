
"smart_sources:2026-03-30 - Tools_ User Stories.md": {"path":"2026-03-30 - Tools_ User Stories.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1gv6hsx","at":1785795031879},"class_name":"SmartSource","last_import":{"mtime":1783528311849,"size":8397,"at":1785795031994,"hash":"1gv6hsx"},"blocks":{"#---frontmatter---":[1,9],"#":[10,11],"##USER STORIES":[12,15],"##USER STORIES#{1}":[14,15],"##Yvonne – AV archivist at human rights organization":[16,21],"##Yvonne – AV archivist at human rights organization#{1}":[18,21],"##Phil – Cataloger and Researcher at a stock footage archive":[22,25],"##Phil – Cataloger and Researcher at a stock footage archive#{1}":[24,25],"##Greg – Librarian at a university":[26,31],"##Greg – Librarian at a university#{1}":[28,31],"##Jennifer – Restoration and Preservation Manager":[32,35],"##Jennifer – Restoration and Preservation Manager#{1}":[34,35],"##Amber – AV Preservation Librarian":[36,39],"##Amber – AV Preservation Librarian#{1}":[38,39],"##Margaret – Film Archivist":[40,43],"##Margaret – Film Archivist#{1}":[42,43],"##Danica – Archivist":[44,47],"##Danica – Archivist#{1}":[46,47],"##Ilana – Archival Producer":[48,51],"##Ilana – Archival Producer#{1}":[50,51],"##Nicole – Processing Archivist":[52,63],"##Nicole – Processing Archivist#{1}":[54,59],"##Nicole – Processing Archivist#{2}":[60,60],"##Nicole – Processing Archivist#{3}":[61,63]},"outlinks":[{"title":"trustarchives","target":"trustarchives","line":5},{"title":"C2PA","target":"https://c2pa.org/","line":14},{"title":"user stories","target":"https://docs.google.com/document/d/1f6-cN7G4ZF66VXThy8Bdl4UZD_GXn5vldROAyRAscIk/edit?tab=t.0#heading=h.uumamraw2ovf","line":14},{"title":"We continue to seek and welcome new submissions","target":"https://forms.gle/chLc26FDx9N6YdLz6","line":14},{"title":"![","target":"https://www.trustarchives.org/wp-content/uploads/2026/03/Download-PDF-copy.jpg","line":56},{"title":"![","target":"https://www.trustarchives.org/wp-content/uploads/2026/03/PDF-Download.jpg","line":56},{"title":"![","target":"https://www.trustarchives.org/wp-content/uploads/2026/03/Submit-User-Story.jpg","line":58}],"metadata":{"title":"Tools: User Stories","source":"https://www.trustarchives.org/tools-user-stories/","author":["[[trustarchives]]"],"published":"2026-03-30","created":"2026-07-08","description":"USER STORIES Over the past year, conversations within the TAI Authenticity working group have revealed that the exponential growth of generative AI is affecting archives, archivists, and their moving image collections. Inspired by the Library of Congress’ user stories for C2PA implementation in Government and Libraries, Archives, and Museums, the TAI Authenticity working group […]"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},