,{"title":"![Hiking up Mount Fraught.","target":"https://static.wikia.nocookie.net/snicket/images/2/27/Snowscout_hike.png/revision/latest/scale-to-width-down/185?cb=20190927230141 \"Snowscout hike.png (6.75 MB","line":31},{"title":"![Snow Scouts with Brucie.","target":"https://static.wikia.nocookie.net/snicket/images/3/39/Brucie_is_done%E2%84%A2.png/revision/latest/scale-to-width-down/185?cb=20190927230323 \"Brucie is done™.png (4.5 MB","line":35},{"title":"Brucie","target":"https://snicket.fandom.com/wiki/Brucie \"Brucie\"","line":37},{"title":"![YES LET'S ABANDON HER.","target":"https://static.wikia.nocookie.net/snicket/images/a/a6/Snowscouts_clap.png/revision/latest/scale-to-width-down/185?cb=20190927230352 \"Snowscouts clap.png (4.52 MB","line":39},{"title":"![March!","target":"https://static.wikia.nocookie.net/snicket/images/c/c0/Abandoning_brucie.png/revision/latest/scale-to-width-down/185?cb=20190927230428 \"Abandoning brucie.png (6.64 MB","line":43},{"title":"![On Mount Fraught.","target":"https://static.wikia.nocookie.net/snicket/images/9/97/Snowscoutspecialday.png/revision/latest/scale-to-width-down/185?cb=20190927230509 \"Snowscoutspecialday.png (4.86 MB","line":47},{"title":"![In formation.","target":"https://static.wikia.nocookie.net/snicket/images/1/18/Snowscout_squad.png/revision/latest/scale-to-width-down/185?cb=20190927230537 \"Snowscout squad.png (4.67 MB","line":51},{"title":"![False Spring.","target":"https://static.wikia.nocookie.net/snicket/images/f/f3/CarmelitaWithScouts.png/revision/latest/scale-to-width-down/185?cb=20190101060220 \"CarmelitaWithScouts.png (1.44 MB","line":55},{"title":"![Confused.","target":"https://static.wikia.nocookie.net/snicket/images/8/87/Snowscoutsconfused.png/revision/latest/scale-to-width-down/185?cb=20191130192824 \"Snowscoutsconfused.png (5.17 MB","line":59},{"title":"![About to get kidnapped by eagles.","target":"https://static.wikia.nocookie.net/snicket/images/7/76/Snowscouts_net.png/revision/latest/scale-to-wid