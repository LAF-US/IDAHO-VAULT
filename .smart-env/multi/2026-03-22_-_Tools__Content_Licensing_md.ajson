
"smart_sources:2026-03-22 - Tools_ Content Licensing.md": {"path":"2026-03-22 - Tools_ Content Licensing.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1yn7jhn","at":1785795031673},"class_name":"SmartSource","last_import":{"mtime":1783528297466,"size":3044,"at":1785795031785,"hash":"1yn7jhn"},"blocks":{"#---frontmatter---":[1,9],"#":[10,11],"##CONTENT LICENSING LANGUAGE":[12,30],"##CONTENT LICENSING LANGUAGE#{1}":[14,30]},"outlinks":[{"title":"trustarchives","target":"trustarchives","line":5},{"title":"please let us know","target":"mailto:info@trustarchives.org","line":20},{"title":"![","target":"https://www.trustarchives.org/wp-content/uploads/2026/03/Language-Limited.png","line":24},{"title":"![","target":"https://www.trustarchives.org/wp-content/uploads/2026/03/Language-Prohibited.png","line":24},{"title":"![","target":"https://www.trustarchives.org/wp-content/uploads/2026/03/Feedback2.jpg","line":27},{"title":"![","target":"https://www.trustarchives.org/wp-content/uploads/2026/03/Webinar.jpg","line":27}],"metadata":{"title":"Tools: Content Licensing","source":"https://www.trustarchives.org/tools-content-licensing/","author":["[[trustarchives]]"],"published":"2026-03-22","created":"2026-07-08","description":"CONTENT LICENSING LANGUAGE These templates are designed to ensure the preservation, integrity, and authenticity of the archival content. In cases where Artificial Intelligence (AI) manipulation is used, the template helps ensure that these changes are flagged, and a review is conducted to ensure compliance with standards established by the Archive. Consideration was given to […]"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},