
"smart_sources:- Photo Gallery (U.S. National Park Service)-20260731-132156-d6a746bab4a7651e.md": {"path":"- Photo Gallery (U.S. National Park Service)-20260731-132156-d6a746bab4a7651e.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1sfgfqn","at":1785794992489},"class_name":"SmartSource","last_import":{"mtime":1785525246276,"size":13713,"at":1785794992779,"hash":"1sfgfqn"},"blocks":{"#---frontmatter---":[1,8],"####Contact Us":[9,20],"####Contact Us#{1}":[11,12],"####Contact Us#{2}":[13,20],"##SCBL 14 - Smith - Jackson - S...":[21,27],"##SCBL 14 - Smith - Jackson - S...#{1}":[23,27],"##SCBL 17 - Fur Trader's Caravan...":[28,34],"##SCBL 17 - Fur Trader's Caravan...#{1}":[30,34],"##SCBL 18 - Rendezvous":[35,41],"##SCBL 18 - Rendezvous#{1}":[37,41],"##SCBL 19 - Westport Landing":[42,48],"##SCBL 19 - Westport Landing#{1}":[44,48],"##SCBL 20 - Alcove Springs":[49,55],"##SCBL 20 - Alcove Springs#{1}":[51,55],"##SCBL 21 - Rock Creek":[56,62],"##SCBL 21 - Rock Creek#{1}":[58,62],"##SCBL 22 - Fort Kearny":[63,69],"##SCBL 22 - Fort Kearny#{1}":[65,69],"##SCBL 23 - Crossing the South P...":[70,76],"##SCBL 23 - Crossing the South P...#{1}":[72,76],"##SCBL 24 - Chimney Rock":[77,83],"##SCBL 24 - Chimney Rock#{1}":[79,83],"##SCBL 25 - Approaching Chimney...":[84,90],"##SCBL 25 - Approaching Chimney...#{1}":[86,90],"##SCBL 26 - Scotts Bluff":[91,97],"##SCBL 26 - Scotts Bluff#{1}":[93,97],"##SCBL 27 - Mitchell Pass":[98,104],"##SCBL 27 - Mitchell Pass#{1}":[100,104],"##SCBL 28 - Fort Mitchell":[105,111],"##SCBL 28 - Fort Mitchell#{1}":[107,111],"##SCBL 29 - Fort Laramie":[112,118],"##SCBL 29 - Fort Laramie#{1}":[114,118],"##SCBL 30 - Labonte Creek":[119,125],"##SCBL 30 - Labonte Creek#{1}":[121,125],"##SCBL 31 - Independence Rock":[126,132],"##SCBL 31 - Independence Rock#{1}":[128,132],"##SCBL 32 - Along the Sweetwater...":[133,139],"##SCBL 32 - Along the Sweetwater...#{1}":[135,139],"##SCBL 33 - Three Crossings Stat...":[140,146],"##SCBL 33 - Three Crossings Stat...#{1}":[142,146],"##SCBL 34 - St. Mary's Station":[147,153],"##SCBL 34 - St. Mary's Station#{1}":[149,153],"##SCBL 35 - Wind River Mountains...":[154,160],"##SCBL 35 - Wind River Mountains...#{1}":[156,160],"##Tags":[161,163],"##Tags#{1}":[163,163]},"outlinks":[{"title":"Return to The Civil War","target":"#","line":11},{"title":"Photo & Multimedia Search","target":"https://www.nps.gov/media/multimedia-search.htm","line":13},{"title":"![About a hundred of mounted men with a dozen mule-drawn wagons snaking through a low prairie environment.  They pass a small cabin with two people.","target":"https://www.nps.gov/npgallery/GetAsset/e4815195-1cea-41c2-abb6-f341d6b2f819/proxy/lores \"About a hundred of mounted men with a dozen mule-drawn wagons snaking through a low prairie environment.  They pass a small cabin with two people.\"","line":19},{"title":"![A watercolor depicts a long train of wagons, stagecoaches, and men on horseback snaking along a flat plain. ","target":"https://www.nps.gov/npgallery/GetAsset/d2f9fb92-5855-4163-9b86-6ee262fd4b9a/proxy/lores \"A watercolor depicts a long train of wagons, stagecoaches, and men on horseback snaking along a flat plain. \"","line":26},{"title":"![A watercolor painting of Native Americans and traders doing business in a broad, green valley with scattered trees.  Native American tipis/lodges are scattered around.  Many riders travel through the camp.","target":"https://www.nps.gov/npgallery/GetAsset/538749e5-dbcb-464c-9ab0-bd79a8bbe0f3/proxy/lores \"A watercolor painting of Native Americans and traders doing business in a broad, green valley with scattered trees.  Native American tipis/lodges are scattered around.  Many riders travel through the camp.\"","line":33},{"title":"![A large, white riverboat offloading wagons.  In the foreground are tents and unhitched covered wagons, while in the distance stretches a vast, flat green landscape.","target":"https://www.nps.gov/npgallery/GetAsset/21a98952-2b2d-4bb2-8f28-696ed7a3c149/proxy/lores \"A large, white riverboat offloading wagons.  In the foreground are tents and unhitched covered wagons, while in the distance stretches a vast, flat green landscape.\"","line":40},{"title":"![A wagon train near a small, rocky creek and waterfall the drops over a small cliff.  A few men, women, and children are in the foreground.  The small, shallow draw is flanked by trees.","target":"https://www.nps.gov/npgallery/GetAsset/e9568bc2-b2c5-4912-8496-3f97e25a650f/proxy/lores \"A wagon train near a small, rocky creek and waterfall the drops over a small cliff.  A few men, women, and children are in the foreground.  The small, shallow draw is flanked by trees.\"","line":47},{"title":"![Covered wagons and ox teams passing two log buildings.   One man drives the oxen from the front, left while another man is on the rear right hand side of the wagon.  A stagecoach approaches the buildings.  Rolling hills form the horizon.","target":"https://www.nps.gov/npgallery/GetAsset/6fb3f5f7-2384-42c3-a36f-147c0b5184e7/proxy/lores \"Covered wagons and ox teams passing two log buildings.   One man drives the oxen from the front, left while another man is on the rear right hand side of the wagon.  A stagecoach approaches the buildings.  Rolling hills form the horizon.\"","line":54},{"title":"![A broad green valley with a wide, island dotted river.  A two column line of wagons moves up the valley as a massive buffalo herd crosses the river and road towards the viewer.  Fort Kearney sits on the right side of the frame.","target":"https://www.nps.gov/npgallery/GetAsset/0919999d-5bcb-4ac2-96af-e90332c71eaf/proxy/lores \"A broad green valley with a wide, island dotted river.  A two column line of wagons moves up the valley as a massive buffalo herd crosses the river and road towards the viewer.  Fort Kearney sits on the right side of the frame.\"","line":61},{"title":"![Ox-drawn wagons crossing a wide, muddy river in a wide, green valley.  An Indian tipi in the left foreground.  Mountain ridges in the far distance.","target":"https://www.nps.gov/npgallery/GetAsset/f16182e7-9dc2-4597-9f8d-8575d23e0db0/proxy/lores \"Ox-drawn wagons crossing a wide, muddy river in a wide, green valley.  An Indian tipi in the left foreground.  Mountain ridges in the far distance.\"","line":68},{"title":"![A watercolor painting of a tall, sandstone pillar with green vegetation at its base and fluffy clouds  in a blue sky above.","target":"https://www.nps.gov/npgallery/GetAsset/0f725f64-1fc8-4ddb-9786-bdd49e2d9b48/proxy/lores \"A watercolor painting of a tall, sandstone pillar with green vegetation at its base and fluffy clouds  in a blue sky above.\"","line":75},{"title":"![Wagons descending into a sage-covered valley as the lead wagons form a circle of the night.  The wagon's cover is torn.  A thin, chimney-like rock highlights the horizon in the background as cliff=like hills extend into the distance and Scotts Bluff on the far right.  The sunset shows vibrant yellow and orange colors.","target":"https://www.nps.gov/npgallery/GetAsset/e5def3f0-e9b6-4e94-9edb-8ee928f31dc9/proxy/lores \"Wagons descending into a sage-covered valley as the lead wagons form a circle of the night.  The wagon's cover is torn.  A thin, chimney-like rock highlights the horizon in the background as cliff=like hills extend into the distance and Scotts Bluff on the far right.  The sunset shows vibrant yellow and orange colors.\"","line":82},{"title":"![A dusty wagon train snakes its way through a narrow pass overlooked by two prominent rock features.","target":"https://www.nps.gov/npgallery/GetAsset/5241a281-4436-420f-96b0-0559cc93a35e/proxy/lores \"A dusty wagon train snakes its way through a narrow pass overlooked by two prominent rock features.\"","line":89},{"title":"![A watercolor painting of a long wagon train passing through a narrow pass between two sandstone bluffs. ","target":"https://www.nps.gov/npgallery/GetAsset/988d0d98-ab97-47d6-b8e5-87235dc9a16c/proxy/lores \"A watercolor painting of a long wagon train passing through a narrow pass between two sandstone bluffs. \"","line":96},{"title":"![A small, abode and sod, white-washed fort with a wooden stockade for a corral.  Several mounted soldiers ride towards a string of pack mules as they travel away towards Mitchell Pass.  A shallow, broad river and Indian tipis are seen to the left.","target":"https://www.nps.gov/npgallery/GetAsset/25626a95-b0e7-40e1-85db-c4c8cb1956a8/proxy/lores \"A small, abode and sod, white-washed fort with a wooden stockade for a corral.  Several mounted soldiers ride towards a string of pack mules as they travel away towards Mitchell Pass.  A shallow, broad river and Indian tipis are seen to the left.\"","line":103},{"title":"![Wagons cross a small river on their approach to a small adobe fort.  Trees flank the structure and some Indian tipis are seen on both sides of the river.  A large, dark mountain dominates the background.","target":"https://www.nps.gov/npgallery/GetAsset/d03d4d16-96dd-4dd9-812f-8876763db7b6/proxy/lores \"Wagons cross a small river on their approach to a small adobe fort.  Trees flank the structure and some Indian tipis are seen on both sides of the river.  A large, dark mountain dominates the background.\"","line":110},{"title":"![A dark, imposing mountain and deep canyon witnesses the train of wagons descending.  Pine trees in the foreground.","target":"https://www.nps.gov/npgallery/GetAsset/98f4c9e6-a355-46e3-9d11-ac2724b4b051/proxy/lores \"A dark, imposing mountain and deep canyon witnesses the train of wagons descending.  Pine trees in the foreground.\"","line":117},{"title":"![A wagon train snakes between a narrow, shallow river on the left and a large, rounded granite rock.  A narrow, V-shaped notch looms in a distant ridge. ","target":"https://www.nps.gov/npgallery/GetAsset/ff94f812-72c7-4c57-8945-875d42669411/proxy/lores \"A wagon train snakes between a narrow, shallow river on the left and a large, rounded granite rock.  A narrow, V-shaped notch looms in a distant ridge. \"","line":124},{"title":"![A two-building compound of wooden buildings in a shallow, sage-covered plain.  The Sweetwater River runs down the valley.  Wagons pulled by mules and oxen, stagecoaches, pack trains, donkeys and carts are seen.","target":"https://www.nps.gov/npgallery/GetAsset/efa2a9e8-1cbc-41b8-aed9-0e56171cd79b/proxy/lores \"A two-building compound of wooden buildings in a shallow, sage-covered plain.  The Sweetwater River runs down the valley.  Wagons pulled by mules and oxen, stagecoaches, pack trains, donkeys and carts are seen.\"","line":131},{"title":"![A rider approaches a three-building compound that is manned by several soldiers carrying out their daily activities.  The valley and high hills are covered in sage.  A distant mountain peeks out from a gap in the hills.","target":"https://www.nps.gov/npgallery/GetAsset/b4da0a16-d51b-445c-85d7-4b725a346c61/proxy/lores \"A rider approaches a three-building compound that is manned by several soldiers carrying out their daily activities.  The valley and high hills are covered in sage.  A distant mountain peeks out from a gap in the hills.\"","line":138},{"title":"![A man on horseback rides a road that passes a cluster of three cabins and then continues on in the distance through a line of mountains. ","target":"https://www.nps.gov/npgallery/GetAsset/cf468f55-65ef-48a2-87d7-b62434beeda3/proxy/lores \"A man on horseback rides a road that passes a cluster of three cabins and then continues on in the distance through a line of mountains. \"","line":145},{"title":"![A river meanders through a meadow in the foreground while snow-capped mountains loom in the background. ","target":"https://www.nps.gov/npgallery/GetAsset/48c24965-a34d-40f1-b810-780c46234368/proxy/lores \"A river meanders through a meadow in the foreground while snow-capped mountains loom in the background. \"","line":152},{"title":"art","target":"https://www.nps.gov/media/article-search.htm?q=art","line":163},{"title":"Scotts Bluff","target":"https://www.nps.gov/media/article-search.htm?q=Scotts%20Bluff","line":163},{"title":"watercolors","target":"https://www.nps.gov/media/article-search.htm?q=watercolors","line":163},{"title":"William Henry Jackson","target":"https://www.nps.gov/media/article-search.htm?q=William%20Henry%20Jackson","line":163},{"title":"William Henry Jackson Collection","target":"https://www.nps.gov/media/article-search.htm?q=William%20Henry%20Jackson%20Collection","line":163}],"metadata":{"title":"Photo Gallery (U.S. National Park Service)","source":"https://www.nps.gov/media/photo/gallery.htm?id=A20386E0-9025-42CE-B0EA-A01D414A0319","author":null,"published":null,"created":"2026-07-31","description":"Photo Gallery"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:- Photo Gallery (U.S. National Park Service)-20260731-132156-d6a746bab4a7651e.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1mcb8dk","at":1785794992489},"key":"- Photo Gallery (U.S. National Park Service)-20260731-132156-d6a746bab4a7651e.md#---frontmatter---","lines":[1,8],"size":221,"outlinks":[],"class_name":"SmartBlock"},
