
"smart_sources:2026-07-23 - ‘Do people even want this_’_ McCall to rethink July 4 celebration, fireworks.md": {"path":"2026-07-23 - ‘Do people even want this_’_ McCall to rethink July 4 celebration, fireworks.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"gje1t","at":1785795033888},"class_name":"SmartSource","last_import":{"mtime":1785169758438,"size":6988,"at":1785795033964,"hash":"gje1t"},"blocks":{"#---frontmatter---":[1,9],"#":[10,39],"##Rising crowd control costs":[40,71],"##Rising crowd control costs#{1}":[42,71],"##‘It’s all still going to happen’":[72,100],"##‘It’s all still going to happen’#{1}":[74,100]},"outlinks":[{"title":"Drew Dodson - Valley Lookout Editor","target":"Drew Dodson - Valley Lookout Editor","line":5},{"title":"ICCU","target":"https://static-v2.boisedev.com/assets/748dce9e-e5ec-4fa6-9c85-f6cbe0db4a73.png","line":14,"embedded":true},{"title":"Valley Lookout house - Drew","target":"https://static-v2.boisedev.com/assets/12c5b6ba-e344-4f74-a83b-fe4af9ea9df5.gif","line":22,"embedded":true},{"title":"Western States - Lookout creative - 4:1","target":"https://static-v2.boisedev.com/assets/115c0cfa-e547-4a5c-8f4e-7ea7e16f8bde.png","line":32,"embedded":true},{"title":"St. Luke's Health Plan - 2026 2:1","target":"https://static-v2.boisedev.com/assets/3cffa70b-bd30-43bc-8a9e-62008bbc7dff.png","line":44,"embedded":true},{"title":"the city hired a 15-member security team","target":"https://valleylookout.com/2026/07/01/mccall-beefs-up-security-enforcement-measures-for-july-4-celebration/","line":48},{"title":"St. Luke's Health Plan - 2026 2:1","target":"https://static-v2.boisedev.com/assets/3cffa70b-bd30-43bc-8a9e-62008bbc7dff.png","line":54,"embedded":true},{"title":"St. Luke's Health Plan - 2026 2:1","target":"https://static-v2.boisedev.com/assets/3cffa70b-bd30-43bc-8a9e-62008bbc7dff.png","line":64,"embedded":true},{"title":"St. Luke's Health Plan - 2026 2:1","target":"https://static-v2.boisedev.com/assets/3cffa70b-bd30-43bc-8a9e