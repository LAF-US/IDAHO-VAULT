#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || { printf >&2 '%s\n' 'pre-push: cannot find repository root.'; exit 2; }
cd "$repo_root" || { printf >&2 '%s\n' "pre-push: cannot enter repository root: $repo_root"; exit 2; }
git lfs version >/dev/null 2>&1 || { printf >&2 '%s\n' 'git hook: Git LFS is required for this repository.'; exit 2; }
PYTHON=${PYTHON:-python}

# Pre-push safety plus stock Git LFS upload. Do not read stdin in this hook
# before calling `git lfs pre-push`; Git passes ref updates there, and LFS uses
# that stream to decide which objects to upload.

upstream=$(git rev-parse --verify '@{u}' 2>/dev/null || true)
if [ -z "$upstream" ]; then
  printf >&2 '%s\n' 'pre-push: no upstream configured; checking all files reachable from HEAD'
fi

git_diff_names_for_push() {
  if [ -n "$upstream" ]; then
    git diff --name-only -z --diff-filter=ACMR "$upstream"...HEAD --
  else
    empty_tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904
    git diff --name-only -z --diff-filter=ACMR "$empty_tree" HEAD --
  fi
}

push_paths=$(mktemp "${TMPDIR:-/tmp}/idaho-vault-pre-push.XXXXXX") || { printf >&2 '%s\n' 'pre-push: cannot create temp file.'; exit 2; }
cleanup() {
  rm -f "$push_paths"
}
trap cleanup EXIT HUP INT TERM
git_diff_names_for_push >"$push_paths"

printf >&2 '%s\n' 'pre-push: checking secret patterns for commits not on upstream'
"$PYTHON" .github/scripts/check_secret_patterns.py --paths-from-stdin --git-ref HEAD <"$push_paths"

printf >&2 '%s\n' 'pre-push: checking large-file policy for commits not on upstream'
"$PYTHON" .github/scripts/check_large_files.py --paths-from-stdin --git-ref HEAD <"$push_paths"

if [ -z "${GIT_LFS_SKIP_PUSH:-}" ]; then
  remote_name=${1:-origin}
  printf >&2 '%s\n' "pre-push: making sure LFS objects reachable from HEAD are uploaded to $remote_name"
  git lfs push "$remote_name" HEAD
fi

printf >&2 '%s\n' 'pre-push: delegating LFS upload to stock git lfs pre-push'
exec git lfs pre-push "$@"
