[gitflow]
	version = 1.0
	initialized = true
[gitflow "branch.release"]
	type = topic
	parent = main
	startPoint = logan/obsidian/main
	upstreamStrategy = merge
	downstreamStrategy = merge
	prefix = logan/vault/main/
	autoUpdate = false
	tag = true
	tagprefix = v
[gitflow "branch.hotfix"]
	type = topic
	parent = main
	startPoint = main
	upstreamStrategy = merge
	downstreamStrategy = rebase
	prefix = logan/vault/fix/
	autoUpdate = false
	tag = true
	tagprefix = v
[gitflow "branch.support"]
	type = topic
	parent = main
	startPoint = main
	upstreamStrategy = none
	downstreamStrategy = none
	prefix = v.
	autoUpdate = false
	tag = false
[gitflow "branch.main"]
	type = base
	upstreamStrategy = none
	downstreamStrategy = none
	autoUpdate = false
	tag = false
[gitflow "branch.logan/obsidian/main"]
	type = base
	parent = main
	upstreamStrategy = merge
	downstreamStrategy = merge
	autoUpdate = true
	tag = false
[gitflow "branch.feature"]
	type = topic
	parent = logan/obsidian/main
	startPoint = logan/obsidian/main
	upstreamStrategy = merge
	downstreamStrategy = rebase
	prefix = logan/obsidian/
	autoUpdate = false
	tag = false
[gitflow "branch.bugfix"]
	type = topic
	parent = logan/obsidian/main
	startPoint = logan/obsidian/main
	upstreamStrategy = merge
	downstreamStrategy = rebase
	prefix = logan/was/here/
	autoUpdate = false
	tag = false
