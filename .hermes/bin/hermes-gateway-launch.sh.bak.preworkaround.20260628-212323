#!/bin/sh
# Hermes gateway launcher: bootstraps OP_SERVICE_ACCOUNT_TOKEN from the
# mode-600 ~/.hermes/.env, then exec's the gateway through `op run` so all
# op://... references in the env file are resolved at process start.
set -eu
ENV_FILE="$HOME/.hermes/.env"
if [ ! -r "$ENV_FILE" ]; then
  echo "hermes-gateway-launch: missing $ENV_FILE" >&2
  exit 78
fi
TOKEN=$(grep -E '^[[:space:]]*(export[[:space:]]+)?OP_SERVICE_ACCOUNT_TOKEN=' "$ENV_FILE" \
  | head -1 \
  | sed -E 's/^[[:space:]]*(export[[:space:]]+)?OP_SERVICE_ACCOUNT_TOKEN=//; s/^["'\'']//; s/["'\'']$//')
if [ -z "$TOKEN" ]; then
  echo "hermes-gateway-launch: OP_SERVICE_ACCOUNT_TOKEN not found in $ENV_FILE" >&2
  exit 78
fi
export OP_SERVICE_ACCOUNT_TOKEN="$TOKEN"
exec /usr/local/bin/op run --env-file="$ENV_FILE" -- "$@"
