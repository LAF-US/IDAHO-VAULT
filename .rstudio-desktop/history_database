1512438682266:# 2 sample proportion CI
1512438682269:# you must run the whole function from ci.2prop through the last } for this to work
1512438682269:ci.2prop=function(x1,x2,n1,n2,alpha){
1512438682270:phat1=x1/n1; qhat1=1-phat1; phat2=x2/n2; qhat2=1-phat2
1512438682271:pt.est=phat1-phat2; alpha=alpha; zstar=qnorm(1-alpha/2)
1512438682271:se=sqrt((phat1*qhat1/n1)+(phat2*qhat2/n2)); moe=zstar*se
1512438682272:lower=pt.est-moe; upper=pt.est+moe
1512438682272:lowerpct=sprintf("%.2f%%",lower*100); upperpct=sprintf("%.2f%%",upper*100)
1512438682273:print("Results of the Confidence Interval of the Difference of 2 Proportions")
1512438682274:cat(" Critical Value of Z* =",zstar,"\n","SE =",se,"\n","Point Estimate of p1-p2 =",
1512438682275:pt.est,"\n","Margin of Error =",moe,"\n","Lower Bound =",lower,
1512438682275:"Upper Bound =",upper,"\n","Lower Bound (%) =",lowerpct,
1512438682276:"Upper Bound (%) =",upperpct,"\n")
1512438682276:results=list(zstar=zstar,se=se,pt.est=pt.est,moe=moe,lower=lower,upper=upper,
1512438682276:lowerpct=lowerpct,upperpct=upperpct)
1512438682277:}
