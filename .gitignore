# ---------------------------------------------------------------
# THE VAULT tracks everything by default. Two narrow exceptions are gitignored:
#
#   SECRETS — credential material. NON-.md ONLY: Markdown is force-tracked at
#             the bottom, so a secret pasted into prose is the scanner's job.
#             Use exact secret filenames or filepaths — NOT by unanchored globs.
#
#   EXHAUST — machine-generated files that never held human authorship AND
#             regenerate if deleted: OS droppings, build output, runtime
#             state. For a dir that may hold prose, ignore its contents 
#             not the dir, e.g. `dir/**` + `!dir/**/` + `!dir/**/*.md`.
# ---------------------------------------------------------------
._*
Icon?
~*
.fuse_hidden*
.directory
.Trash-*
.nfs*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
.stackdump
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.AppleDB
.AppleDesktop
.LSOverride
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.apdisk
*.icloud
Network Trash Folder
Temporary Items

# ---------------------------------------------------------------
# Build Packages
# ---------------------------------------------------------------
/build/**
/cache/**
/dist/**
/env/**
/node_modules/**
/vendor/**
/venv/**
.venv

# ---------------------------------------------------------------
# Large Stores
# ---------------------------------------------------------------
.ollama/models/blobs/**
/.cache/codex-runtimes/codex-primary-runtime/**
/.claude/plugins/marketplaces/**
/.claude/file-history/**
/.codex/.tmp/bundled-marketplaces/**
/.codex/plugins/.remote-plugin-install-staging/**
/.codex/plugins/cache/**
/.codex/skills/.system/**

# ---------------------------------------------------------------
# Plaintext Secrets
# ---------------------------------------------------------------
.aikido/config
.cache_ggshield
.env
.env.*
*.pem
id_ed25519
id_ed25519.pub
known_hosts
.claude/.credentials.json
.obsidian/plugins/ai-templater/data.json
.obsidian/plugins/ai-image-analyzer/data.json
.obsidian/plugins/obsidian-local-rest-api/data.json
.obsidian/plugins/phone-to-roam-to-obsidian/data.json
.obsidian/plugins/todoist-context-bridge/data.json
.obsidian/plugins/mcp-tools/bin/mcp-server.exe

# ---------------------------------------------------------------
# Ignore Exceptions
# ---------------------------------------------------------------
!.gitignore
!/.*/stub.txt
!/**.md

