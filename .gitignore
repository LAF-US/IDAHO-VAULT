# THE VAULT tracks everything by default. Two narrow exceptions are gitignored:
#
#   SECRETS — credential material. NON-.md ONLY: Markdown is force-tracked at
#             the bottom, so a secret pasted into prose is the scanner's job.
#
#   CHURNS — machine-generated material. Never holds human authorship AND
#             regenerates automatically: OS, build, runtime state, et cetera.
#

# ---------------------------------------------------------------
# OS Duff
# ---------------------------------------------------------------
._*
Icon?
.fuse_hidden*
.directory
.Trash-*
.nfs*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
.stackdump
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.AppleDB
.AppleDesktop
.LSOverride
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.apdisk
*.icloud
Network Trash Folder
Temporary Items

# ---------------------------------------------------------------
# Large Stores
# ---------------------------------------------------------------
.obsidian/plugins/mcp-tools/bin/mcp-server.exe
.ollama/models/blobs/**

# ---------------------------------------------------------------
# Plaintext Secrets
# ---------------------------------------------------------------
.aikido/config
.cache_ggshield
.claude/.credentials.json
.codex/auth.json
.env
.env.*
.gsutil/credstore*
.obsidian/plugins/ai-image-analyzer/data.json
.obsidian/plugins/ai-templater/data.json
.obsidian/plugins/obsidian-local-rest-api/data.json
.obsidian/plugins/phone-to-roam-to-obsidian/data.json
.obsidian/plugins/todoist-context-bridge/data.json
credstore*
id_ed*
pubring*
*.pem

# ---------------------------------------------------------------
# Gitignore Exceptions
# ---------------------------------------------------------------
!.gitignore
!/.*/stub.txt
!/**.md

# ---------------------------------------------------------------
# THE WORLD IS QUIET HERE．ESTO PERPETUA!
# ---------------------------------------------------------------
/.cache
/.codex
