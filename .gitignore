# IDAHO-VAULT gitignore
#
# First principle: the vault is the record. Markdown notes, structured
# registries, scripts, source documents, media, attachments, and durable agent
# memory stay visible to git by default.
#
# This file exists mainly to shield secrets and suppress machine churn. It
# excludes local runtime state, dependency installs, caches, logs, credentials,
# editor/workspace noise, and NETWEB-invalid names. Existing tracked files are
# not untracked by these rules; use explicit git index cleanup when Logan
# decides a tracked artifact is no longer part of the record.

# ---------------------------------------------------------------------------
# Secrets and credentials
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
.envrc

.op/openrouter.env
.op/reports/
.mcp-auth/
secrets/
vault-courier-key.json
*-key.json
*service-account.json
archive-secrets-*.json
application_default_credentials.json
credentials.json
token.json
tokens.json
oauth*.json
client_secret*.json

# Private key material and local certificate/key stores.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
known_hosts

# Tool/package manager auth files commonly containing tokens.
.npmrc
.pypirc
.netrc
.aws/
.azure/
.config/gcloud/
.gsutil/
.config/rclone/
rclone.conf
*.rclone.conf

# Credential exports and recovery codes must never enter the public record.
Google Passwords.csv
**/Google Passwords*.csv
**/passwords*.csv
*recovery-codes*
*recovery_codes*

# Tool auth state
.claude/.credentials.json
.codex/auth.json
.codex/.codex-global-state.json
.pi/agent/auth.json
.gemini/oauth_creds.json
.gemini/google_accounts.json
.factory/auth.v2.*
.factory/certs/
.openclaw/credentials/
.ollama/id_ed25519
.ollama/id_ed25519.pub

# Agent memory-provider API key configs (contain live credentials)
honcho.json

# Local agent bridges and exported sessions are not live vault surfaces.
.mcp.json
session-export-*/
gpg-agent.conf
package copy.json
package-lock copy.json

# ---------------------------------------------------------------------------
# Python, JavaScript, and package runtime infrastructure
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
.python_history
!.python/
!.python/**

.venv/
venv/
env/
ENV/
.uv-cache/
.pip-cache/
*.egg-info/
build/
dist/

# coverage.py local run artifacts — CI generates and uploads coverage.xml to
# Codacy, never commits it.
.coverage
.coverage.*
coverage.xml
htmlcov/

node_modules/
**/node_modules/
.npm-cache/

# External SDK/runtime installs parked locally are not vault content.
google-cloud-sdk/
LFPython/
feed-generator/
.local/share/claude/versions/
.ollama/models/blobs/
.ollama/models/manifests/

# Backup/build artifacts of thegemstone.org quartz site. THE-GEMSTONE/
# (markdown content) is the vault-facing record. The sibling /go/ tree is the
# Go module cache used by gemstone build tooling and the sibling /quartz/ tree
# is the quartz checkout — both are reproducible/vendored and churned back
# repeatedly across 2026-05 commits ("Why do these Go packages keep churning,
# I thought we fixed that already"). Anchor the ignore at the repo root so the
# nested THE-GEMSTONE/ content tree stays tracked.
/go/
/quartz/

# ---------------------------------------------------------------------------
# Local caches, temp, state, and generated databases
# ---------------------------------------------------------------------------
.cache/
.tmp/
.state/
!-dotfolder-hashcache.json
.pycache/
.smart-env/
.makemd/
.space/
BMO/
Tags/

tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*-backup*.json
data-backup*
*.bundle
*.download
.rsync-partial/
**/.rsync-partial/
*.partial
*.part

*.log
*.pid
*.lock
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

logs/
**/logs/
**/cache/
**/.cache/
**/tool-results/
**/shared_proto_db/

# Local media-app cache artifacts, not source documents.
*.cfa
*.pek

# ---------------------------------------------------------------------------
# Agent and tool runtime internals
# ---------------------------------------------------------------------------
# Preserve agent dotfolders and durable memory by default; ignore only volatile
# runtime/auth/cache surfaces. Each agent dot-dir declares its own policy;
# root .gitignore entries here are the floor.
.agent-home/

# User runtime dotfolders (imported_software persona chambers) —
# track anchor stubs only; ignore runtime/install/cache contents.
# Dotfolder salvage safety: conflict-preserved `.home` copies, hash-suffixed
# `.home.<sha>` copies, and Windows GUI duplicate names like `name (2).json`
# inherit the privacy/runtime class of their source path unless Logan promotes
# them explicitly.
.claude/*.home*
.claude/**/*.home*
.claude/* ([0-9]*)*
.claude/**/* ([0-9]*)*
.codex/*.home*
.codex/**/*.home*
.codex/* ([0-9]*)*
.codex/**/* ([0-9]*)*
.codex/*.bak-*
.codex/**/*.bak-*
.codex/.app-server-state*
.codex/sqlite/
.config/scoop/config*.json*
.ollama/id_ed25519*
.sbx-denybin/* ([0-9]*)*


# SSH identity material — keys, known hosts, signing config, auth state.
.ssh/auth.json
.ssh/1Password/
.ssh/known_hosts*
.ssh/authorized_keys
.ssh/id_*
.ssh/*_signing*
.ssh/allowed_signers*

# npm cache — opaque content-addressed store; can embed credential blobs.
.npm/_cacache/

# .local/ per-user runtime — tool installs, agent auth/SQLite dbs, signal keys.
.local/bin/
.local/share/opencode/
.local/share/opentui/
.local/share/signal-cli/
.local/state/
.local/state/opencode/
.local/state/lesshst

# VS Code shared storage — local editor state DBs, not vault content.
.vscode-shared/sharedStorage/

# OpenCode CLI config, Continue.dev IDE state, GPG keyring —
# tool-specific infrastructure, not vault content.
.config/opencode/
.continue/
.gnupg/

# Claude Code runtime internals. CLAUDE.md + stub.txt are tracked;
# everything below is local session or install state.
.claude/settings.local*.json
.claude/backups/
.claude/cache/
.claude/debug/
.claude/file-history/
.claude/projects/
.claude/shell-snapshots/
.claude/worktrees/
# marketplace installs + cache — re-downloadable, not vault content
.claude/plugins/
**/.claude/worktrees/
.claude/*.last-cleanup
.claude/history*.jsonl*
.claude/mcp-needs-auth-cache*.json
# clipboard snapshots — ephemeral, not documents
.claude/paste-cache/
# LLM-generated plan drafts (random-named). Promote to a named vault surface
# only if a plan becomes durable; these are session-ephemeral by default.
.claude/plans/
# per-task state tracking, telemetry — machine-runtime
.claude/tasks/
.claude/usage-data/

