# THE VAULT tracks *everything* by default. Only one exception is gitignored:
#
#   SECRETS — credential material. NON-MARKDOWN ONLY: Markdown is force-tracked
#             at the bottom, so a secret pasted into prose is the scanner's job.
# ---------------------------------------------------------------
*.pem
*.secret
.aikido/config
.cache_ggshield
.credentials.json
.copilot/data.db*
.copilot/repos
.copilot/run/ws.*
.copilot/session-store.db*
.codex/*.sqlite*
.codex/.codex-global-state.json*
.codex/models_cache.json*
.env
.env.*
.gsutil/credstore*
.obsidian/plugins/ai-image-analyzer/data.json
.obsidian/plugins/ai-templater/data.json
.obsidian/plugins/obsidian-local-rest-api/data.json
.obsidian/plugins/phone-to-roam-to-obsidian/data.json
.obsidian/plugins/todoist-context-bridge/data.json
.ollama/models/blobs/**/*
.openclaw/memory/main.sqlite
.openclaw/openclaw.json*
.openclaw/secrets/
.vscode/cli/*tunnel*.*
.vscode-shared/sharedStorage/state.vscdb
.vscode-shared/sharedStorage/state.vscdb.backup
adbkey*
auth.json
credstore*
honcho.json
hostkeys*
id_ed*
pubring*

