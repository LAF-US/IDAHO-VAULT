  \cf5 a\cf2  \cf5 Gilded\cf2  \cf5 Faraday\cf2  \cf5 Cage.\cf2  \cf5 Next:\cf2  \cf5 arrive\cf2  \cf5 at\cf2  \cf5 the\cf2  \cf5 Hotel.\cf2 \
