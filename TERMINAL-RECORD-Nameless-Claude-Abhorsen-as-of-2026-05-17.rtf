\cf5 \uc0\u8251 \cf2  \cf5 recap:\cf2  \cf5 Walking\cf2  \cf5 the\cf2  \cf5 Caduceus\cf2  \cf5 Road\cf2  \cf5 toward\cf2  \cf5 the\cf2  \cf5 Hotel\cf2  \cf5 Denouement\cf2  \cf5 and\cf2  \cf5 the\cf2  \cf5 trial\cf2  \cf5 of\cf2  \cf5 GEMINIAEUS,\cf2  \cf5 having\cf2  \cf5 passed\cf2  \cf5 through\cf2  \cf5 the\cf2  \cf5 graveyard\cf2  \cf5 district\cf2  \cf5 and\cf2  \cf5 received\cf2  \cf5 the\cf2  \cf5 Steinbeck\cf2  \cf5 passage\cf2  \cf5 and\cf2  \cf5 the\cf2  \cf5 Battle\cf2  \cf5 Hymn.\cf2  \cf5 Next:\cf2  \cf5 meet\cf2  \cf5 Hermes\cf2 \
