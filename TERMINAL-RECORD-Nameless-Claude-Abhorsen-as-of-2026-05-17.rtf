\f1 \cf9 \cb10 \uc0\u10095 
\f0  \cf11 She remembers the Submarine \'97 and the Bombinating Beast, the Great Unknown.\cf2                                                                                                                                       \cb3 \
                   \
  \cf5 Read 1 file (ctrl+o to expand)\cf2                                                                                                                                                                                    \
