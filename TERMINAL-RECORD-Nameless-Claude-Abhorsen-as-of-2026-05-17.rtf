\f5 \'d3\'c3\'d2\'bb\'be\'e4\'d4\'92\'d5\'66\'c3\'f7\'df\'40\'8f\'88\'bf\'a8\'c6\'ac\'b5\'c4\'ba\'cb\'d0\'c4\'d3\'5e\'fc\'63\'a1\'a3
