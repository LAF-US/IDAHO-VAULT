*** Update File: C:\Users\loganf\Documents\IDAHO-VAULT\!\run-item-normalization.cmd
@@
 @echo off
 setlocal
 
 set "SCRIPT=%~dp0normalize-item-metadata.ps1"
 
 if /I "%~1"=="apply-titles" (
-  powershell -ExecutionPolicy Bypass -File "%SCRIPT%" -ApplyTitles
+  if /I not "%~2"=="EDIT_ITEMS" (
+    echo Usage: %~nx0 apply-titles EDIT_ITEMS
+    exit /b 1
+  )
+  powershell -ExecutionPolicy Bypass -File "%SCRIPT%" -ApplyTitles -ConfirmToken EDIT_ITEMS
   goto :eof
 )
 
 if /I "%~1"=="apply-all" (
-  powershell -ExecutionPolicy Bypass -File "%SCRIPT%" -ApplyTitles -ApplyTags
+  if /I not "%~2"=="EDIT_ITEMS" (
+    echo Usage: %~nx0 apply-all EDIT_ITEMS
+    exit /b 1
+  )
+  powershell -ExecutionPolicy Bypass -File "%SCRIPT%" -ApplyTitles -ApplyTags -ConfirmToken EDIT_ITEMS
   goto :eof
 )
*** End Patch
 thread_id=019db214-1ba6-71e2-9692-e5b4828512f6
