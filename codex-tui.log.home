*** Add File: .gitignore
+# IDAHO-VAULT gitignore
+#
+# First principle: the vault is the record. Markdown notes, structured
+# registries, scripts, source documents, media, attachments, and durable agent
+# memory stay visible to git by default.
+#
+# This file excludes only local runtime state, dependency installs, caches,
+# logs, secrets, editor/workspace noise, and NETWEB-invalid names. Existing
+# tracked files are not untracked by these rules; use explicit git index
+# cleanup when Logan decides a tracked artifact is no longer part of the record.
+
+# ---------------------------------------------------------------------------
+# Secrets and credentials
+# ---------------------------------------------------------------------------
+.env
+.env.*
+!.env.example
+!.env.template
+
+.op/openrouter.env
+.op/reports/
+.mcp-auth/
+secrets/
+vault-courier-key.json
+*-key.json
+*service-account.json
+
+# Credential exports and recovery codes must never enter the public record.
+Google Passwords.csv
+**/Google Passwords*.csv
+**/passwords*.csv
+*recovery-codes*
+*recovery_codes*
+
+# Tool auth state
+.claude/.credentials.json
+.codex/auth.json
+.codex/.codex-global-state.json
+.pi/agent/auth.json
+.gemini/oauth_creds.json
+.gemini/google_accounts.json
+.factory/auth.v2.*
+.openclaw/credentials/
+
+# ---------------------------------------------------------------------------
+# Python, JavaScript, and package runtime infrastructure
+# ---------------------------------------------------------------------------
+__pycache__/
+*.py[cod]
+*$py.class
+.Python
+.python_history
+
+.venv/
+venv/
+env/
+ENV/
+.uv-cache/
+.pip-cache/
+*.egg-info/
+build/
+dist/
+
+node_modules/
+**/node_modules/
+.npm-cache/
+
+# External SDK/runtime installs parked locally are not vault content.
+google-cloud-sdk/
+LFPython/
+feed-generator/
+
+# ---------------------------------------------------------------------------
+# Local caches, temp, state, and generated databases
+# ---------------------------------------------------------------------------
+.cache/
+.tmp/
+.state/
+.pycache/
+.smart-env/
+.makemd/
+.space/
+BMO/
+Tags/
+
+tmp/
+temp/
+*.tmp
+*.temp
+*.bak
+*.backup
+*.bundle
+*.download
+
+*.log
+*.pid
+*.lock
+*.sqlite
+*.sqlite-shm
+*.sqlite-wal
+*.db
+
+logs/
+**/logs/
+**/cache/
+**/.cache/
+**/tool-results/
+**/shared_proto_db/
+
+# Local media-app cache artifacts, not source documents.
+*.cfa
+*.pek
+
+# ---------------------------------------------------------------------------
+# Agent and tool runtime internals
+# ---------------------------------------------------------------------------
+# Preserve agent dotfolders and durable memory by default; ignore only volatile
+# runtime/auth/cache surfaces.
+.agent-home/
+
+.claude/settings.local.json
+.claude/backups/
+.claude/cache/
+.claude/debug/
+.claude/file-history/
+.claude/projects/
+.claude/worktrees/
+.claude/plugins/cache/
+**/.claude/worktrees/
+
+.codex/.personality_migration
+.codex/.sandbox/
+.codex/cache/
+.codex/cap_sid
+.codex/home/
+.codex/installation_id
+.codex/log/
+.codex/logs_*.sqlite*
+.codex/models_cache.json
+.codex/plugins/cache/
+.codex/sandbox.log
+.codex/state_*.sqlite*
+.codex/tmp/
+.codex/version.json
+
+.copilot/session-state/
+.cursor/projects/
+.cursor/extensions/
+.cursor/plugins/cache/
+.cursor/ai-tracking/
+.cursor/debug-logs/
+.cursor/argv.json
+.cursor/ide_state.json
+.gemini/antigravity/
+.gemini/antigravity-browser-profile/
+.gemini/history/
+.gemini/installation_id
+.gemini/projects*.json
+.gemini/policies/auto-saved.toml
+.gemini/settings*.json
+.gemini/state.json
+.gemini/tmp/
+.gemini/trustedFolders.json
+.openclaw/agents/
+.openclaw/canvas/
+.openclaw/completions/
+.openclaw/devices/
+.openclaw/flows/
+.openclaw/identity/
+.openclaw/logs/
+.openclaw/openclaw.json*
+.openclaw/tasks/
+.openclaw/update-check.json
+.openclaw/workspace/
+.pi/agent/sessions/
+
+# CrewAI runtime layer: durable doctrine and source stay tracked.
+.crewai_cache/
+.crewai/logs/
+
+# ---------------------------------------------------------------------------
+# Obsidian local state and plugin runtime data
+# ---------------------------------------------------------------------------
+# Track vault-facing interface state and plugin manifests. Do not track private
+# plugin data, caches, indexes, or machine-local workspace state.
+.obsidian/workspace.json
+.obsidian/workspace*.json
+.obsidian/graph.json
+.obsidian/types.json
+.obsidian/backlink.json
+.obsidian/file-recovery.json
+.obsidian/page-preview.json
+.obsidian/switcher.json
+.obsidian/webviewer.json
+.obsidian/note-composer.json
+.obsidian/app.json
+.obsidian/appearance.json
+
+.obsidian/plugins/*/data.json
+.obsidian/plugins/*/cache/
+.obsidian/plugins/smart-connections/.smart-env/
+.obsidian/plugins/mcp-tools/bin/
+.obsidian/plugins/obsidianclaw/
+.obsidian/plugins/fit/debug.log
+.obsidian/**(2)*.json
+
+!.obsidian/community-plugins.json
+!.obsidian/core-plugins.json
+!.obsidian/plugins/*/manifest.json
+
+# ---------------------------------------------------------------------------
+# Editor, OS, and sync noise
+# ---------------------------------------------------------------------------
+.vscode/*
+!.vscode/settings.json
+!.vscode/extensions.json
+!.vscode/tasks.json
+!.vscode/launch.json
+!.vscode/mcp.json
+
+.idea/
+*.swp
+*.swo
+*~
+
+.DS_Store
+Thumbs.db
+desktop.ini
+ehthumbs.db
+._*
+
+# Office temporary lock files, not documents.
+~$*.doc
+~$*.docx
+~$*.xls
+~$*.xlsx
+~$*.ppt
+~$*.pptx
+
+# Obsidian/cloud conflict duplicates and temporary placeholders.
+* (Conflicted copy *)*
+tempfolder.txt
+
+# ---------------------------------------------------------------------------
+# Local intake/runtime holding areas
+# ---------------------------------------------------------------------------
+tmp-minidata-msg/
+tmp-msg-extract/
+INBOX/PHONE-LINK/*
+DAILYNOTES/
+
+_phone-link-sweep.log
+_phone-link-watcher.log
+_phone-link-watcher.pid
+
+# Swarm runtime state; durable reports should be promoted to markdown/json
+# surfaces intentionally.
+!/swarm/logs/*
+!!/swarm/logs/*
+!/sbp-blackboard.json
+.github/swarm/state/archive/
+
+# ---------------------------------------------------------------------------
+# NETWEB: Windows reserved device names
+# ---------------------------------------------------------------------------
+# These names are invalid on Windows regardless of extension. Use the vault
+# alias convention instead, e.g. _AUX.md with aliases: [AUX].
+[Aa][Uu][Xx]
+[Aa][Uu][Xx].*
+[Cc][Oo][Nn]
+[Cc][Oo][Nn].*
+[Nn][Uu][Ll]
+[Nn][Uu][Ll].*
+[Pp][Rr][Nn]
+[Pp][Rr][Nn].*
+[Cc][Oo][Mm][0-9]
+[Cc][Oo][Mm][0-9].*
+[Ll][Pp][Tt][0-9]
+[Ll][Pp][Tt][0-9].*
+
+# ---------------------------------------------------------------------------
+# Explicit non-rules
+# ---------------------------------------------------------------------------
+# Do not blanket-ignore media, PDFs, Office files, email files, archives, or
+# production source formats here. In this vault those may be source documents.
+# Exclude a specific sensitive or draft artifact only by explicit path, a
+# separate local exclude rule, or an approved metadata-driven workflow.
*** End Patch
