*** Update File: C:\Users\loganf\Documents\IDAHO-VAULT\!\duplicate-credential-triage.ps1
@@
 function Build-DupeKey {
     param(
         [string]$Title,
         [string]$Username,
         [string]$Category,
+        [string]$Site,
         [string]$Mode
     )
 
     $t = Normalize-Value $Title
     $u = Normalize-Value $Username
     $c = Normalize-Value $Category
+    $s = Normalize-Value $Site
+
+    if ($t -eq "login" -and $s) {
+        $t = $s
+    }
 
     if ($Mode -eq "strict") {
         return "$c|$t|$u"
@@
 foreach ($item in $items) {
@@
     $username = [string]$item.additional_information
-    $key = Build-DupeKey -Title $item.title -Username $username -Category $item.category -Mode $Mode
+    $site = ""
+    if ($item.urls -and $item.urls.Count -gt 0) {
+        $href = [string]$item.urls[0].href
+        if ($href) {
+            try {
+                if ($href -match '^[a-z]+://') {
+                    $uri = [System.Uri]$href
+                    $site = $uri.Host
+                }
+            } catch {
+                $site = $href
+            }
+        }
+    }
+
+    $key = Build-DupeKey -Title $item.title -Username $username -Category $item.category -Site $site -Mode $Mode
 
     $rows.Add([pscustomobject]@{
         key        = $key
@@
         username   = $username
         category   = $item.category
+        site       = $site
         updated_at = [datetime]$item.updated_at
     })
 }
*** End Patch
