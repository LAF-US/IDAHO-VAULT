     ".github/scripts/daily_rollover.py",
     "TO DO LIST.md",
 )
@@
 def _normalize_relpath(relpath: str) -> str:
     return Path(relpath).as_posix()
 
 
+def _flattened_relpath(relpath: str) -> str:
+    return relpath.replace("/", "-")
+
+
+def _relpath_candidates(relpath: str) -> tuple[str, ...]:
+    normalized = _normalize_relpath(relpath)
+    if normalized.startswith("!/"):
+        return (normalized, _flattened_relpath(normalized))
+    return (normalized,)
+
+
 def _tracked_files(root: Path) -> set[str] | None:
@@
 def _surface_status(root: Path, relpath: str, tracked_files: set[str] | None) -> SurfaceStatus:
     normalized = _normalize_relpath(relpath)
-    path = root / Path(normalized)
-    tracked = None if tracked_files is None else normalized in tracked_files
-    return SurfaceStatus(relpath=normalized, exists=path.exists(), tracked=tracked)
+    candidates = _relpath_candidates(normalized)
+    exists = any((root / Path(candidate)).exists() for candidate in candidates)
+    tracked = None if tracked_files is None else any(candidate in tracked_files for candidate in candidates)
+    return SurfaceStatus(relpath=normalized, exists=exists, tracked=tracked)
@@
-        path = root_path / Path(relpath)
-        tracked = None if resolved_tracked is None else relpath in resolved_tracked
+        candidates = _relpath_candidates(relpath)
+        path_exists = any((root_path / Path(candidate)).exists() for candidate in candidates)
+        tracked = None if resolved_tracked is None else any(
+            candidate in resolved_tracked for candidate in candidates
+        )
         results.append(
             EvidenceStatus(
                 ref=ref,
                 relpath=relpath,
