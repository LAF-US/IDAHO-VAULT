*** Update File: C:\Users\loganf\Documents\IDAHO-VAULT\!\SimpleStabilization.ps1
@@
 # Simple LEVELSET check
 function Check-LEVELSETCompliance {
+    $vaultRoot = (Resolve-Path (Join-Path $PSScriptRoot "..")).Path
+    $bangRoot = Join-Path $vaultRoot "!"
+
     $checks = @{
-        Constitution = Test-Path "$PSScriptRoot\..\CONSTITUTION.md"
-        Levelset = Test-Path "$PSScriptRoot\..\!\LEVELSET-STEP-0-EXTERNAL-AGENT.md"
-        Agents = Test-Path "$PSScriptRoot\..\!\AGENTS.md"
-        StateDir = Test-Path "$PSScriptRoot\..\!\STATE"
-        CrevaiDir = Test-Path "$PSScriptRoot\..\!\CREWAI"
+        Constitution = Test-Path (Join-Path $vaultRoot "CONSTITUTION.md")
+        Levelset = Test-Path (Join-Path $vaultRoot "LEVELSET.md")
+        Agents = Test-Path (Join-Path $vaultRoot "AGENTS.md")
+        StateDir = Test-Path (Join-Path $bangRoot "STATE")
+        CrevaiDir = Test-Path (Join-Path $bangRoot "CREWAI")
     }
*** Update File: C:\Users\loganf\Documents\IDAHO-VAULT\!\VaultStabilization.psm1
@@
 function Perform-LEVELSETCheck {
@@
-    $checkResults = @{
+    $bangRoot = Join-Path $script:VaultRoot "!"
+
+    $checkResults = @{
         Timestamp = Get-Date -Format "o"
         Governance = @{
             Constitution = Test-Path (Join-Path $script:VaultRoot "CONSTITUTION.md")
-            Levelset = Test-Path (Join-Path $script:VaultRoot "!" "LEVELSET-STEP-0-EXTERNAL-AGENT.md")
-            Agents = Test-Path (Join-Path $script:VaultRoot "!" "AGENTS.md")
+            Levelset = Test-Path (Join-Path $script:VaultRoot "LEVELSET.md")
+            Agents = Test-Path (Join-Path $script:VaultRoot "AGENTS.md")
         }
         Infrastructure = @{
-            StateDirectory = Test-Path (Join-Path $script:VaultRoot "!" "STATE")
-            CrevaiDirectory = Test-Path (Join-Path $script:VaultRoot "!" "CREWAI")
+            StateDirectory = Test-Path (Join-Path $bangRoot "STATE")
+            CrevaiDirectory = Test-Path (Join-Path $bangRoot "CREWAI")
         }
         Valid = $true
*** End Patch
