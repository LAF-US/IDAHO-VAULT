-function Get-BuiltInFieldValue {
-    param($Fields, [string]$Id)
-    $field = $Fields | Where-Object { $_.id -eq $Id } | Select-Object -First 1
-    if ($null -eq $field) { return "" }
-    return [string]$field.value
-}
-
 function New-MarkdownReport {
@@
 $rows = New-Object System.Collections.Generic.List[object]
 
 foreach ($item in $items) {
     if ($item.category -notin @("LOGIN", "API_CREDENTIAL", "SSH_KEY", "PASSWORD")) {
         continue
     }
 
-    $full = op item get $item.id --format json | ConvertFrom-Json
-    $username = Get-BuiltInFieldValue -Fields $full.fields -Id "username"
-    $key = Build-DupeKey -Title $full.title -Username $username -Category $full.category -Mode $Mode
+    $username = [string]$item.additional_information
+    $key = Build-DupeKey -Title $item.title -Username $username -Category $item.category -Mode $Mode
 
     $rows.Add([pscustomobject]@{
         key        = $key
-        id         = $full.id
-        vault      = $full.vault.name
-        title      = $full.title
+        id         = $item.id
+        vault      = $item.vault.name
+        title      = $item.title
         username   = $username
-        category   = $full.category
-        updated_at = [datetime]$full.updated_at
+        category   = $item.category
+        updated_at = [datetime]$item.updated_at
     })
