tion -Encoding UTF8 -Path (Join-Path $outDir \"$name-all.csv\")\n  $unique | Sort-Object RelativePath | Export-Csv -NoTypeInformation -Encoding UTF8 -Path (Join-Path $outDir \"$name-unique-vs-pushable.csv\")\n  [pscustomobject]@{ Name=$name; All=$all.Count; UniqueVsPushable=($unique | Measure-Object).Count; Root=$root }\n} | Format-Table -AutoSize","workdir":"C:\\Users\\loganf","timeout_ms":180000} thread_id=019e046d-ea5f-7461-b868-9e56dd36a4b5
