@@
 param(
     [string]$OutDir = "",
-    [switch]$IncludeAllItems
+    [switch]$IncludeAllItems
 )
@@
 function Get-ServiceHints {
@@
     return ($hints | Select-Object -Unique)
 }
+
+function Get-ManagedServices {
+    return @(
+        "openrouter",
+        "anthropic",
+        "claude",
+        "openai",
+        "gpt",
+        "vertex",
+        "google",
+        "github",
+        "linear",
+        "what3words",
+        "mistral",
+        "huggingface",
+        "slack",
+        "figma",
+        "gmail",
+        "drive",
+        "discord",
+        "xai",
+        "grok"
+    )
+}
+
+function Get-CleanupRecommendation {
+    param($Row)
+
+    if ($Row.category -eq "API_CREDENTIAL") {
+        if ($Row.title -eq "API Credentials" -and $Row.username) {
+            return "Rename item to service-specific title; keep credential field stable."
+        }
+        return "API credential looks in-scope."
+    }
+
+    if ($Row.category -eq "LOGIN" -and $Row.service_hints.Count -gt 0) {
+        return "Check whether this should stay a login item or be replaced by a dedicated API credential item."
+    }
+
+    if ($Row.category -eq "SSH_KEY") {
+        return "SSH key item; verify intended repo/service coverage."
+    }
+
+    return "Review."
+}
@@
 function New-MarkdownReport {
@@
     $lines.Add("## High-Signal Credentials")
     $lines.Add("")
-    $lines.Add("| Vault | Title | Category | Username | Hints | Concealed Refs | Item ID |")
-    $lines.Add("|---|---|---|---|---|---|---|")
+    $lines.Add("| Vault | Title | Category | Username | Hints | Concealed Refs | Item ID | Action |")
+    $lines.Add("|---|---|---|---|---|---|---|---|")
 
     foreach ($row in $Rows) {
         $refs = if ($row.concealed_refs.Count -gt 0) {
             ($row.concealed_refs | ForEach-Object { $_.reference }) -join "<br>"
         } else {
             ""
         }
 
         $hints = ($row.service_hints -join ", ")
-        $lines.Add("| $($row.vault) | $($row.title) | $($row.category) | $($row.username) | $hints | $refs | $($row.id) |")
+        $lines.Add("| $($row.vault) | $($row.title) | $($row.category) | $($row.username) | $hints | $refs | $($row.id) | $($row.action) |")
     }
@@
