+@echo off
+setlocal
+
+set "REPO_ROOT=%~dp0.."
+set "ENV_FILE=%REPO_ROOT%\.op\openrouter.env"
+
+if not exist "%ENV_FILE%" (
+  echo [error] Missing %ENV_FILE%
+  echo Create it from .op\openrouter.env.template first.
+  exit /b 1
+)
+
+op run --env-file="%ENV_FILE%" -- codex --profile openrouter
