prefix_rule(pattern=["/bin/zsh", "-lc", "set -a; source /Users/logan/.hermes/.env; set +a; curl --max-time 30 -sS https://openrouter.ai/api/v1/chat/completions -H \"Authorization: Bearer $OPENROUTER_API_KEY\" -H \"Content-Type: application/json\" -d \"{\\\"model\\\":\\\"mistralai/mistral-small-2603\\\",\\\"messages\\\":[{\\\"role\\\":\\\"user\\\",\\\"content\\\":\\\"Reply with exactly: RAW_OPENROUTER_OK\\\"}],\\\"max_tokens\\\":16}\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "set -a; source /Users/logan/.hermes/.env; set +a; curl --max-time 30 -sS https://openrouter.ai/api/v1/chat/completions -H \"Authorization: Bearer $OPENROUTER_API_KEY\" -H \"Content-Type: application/json\" -d \"{\\\"model\\\":\\\"anthropic/claude-haiku-4.5\\\",\\\"messages\\\":[{\\\"role\\\":\\\"user\\\",\\\"content\\\":\\\"Reply with exactly: RAW_CLAUDE_HAIKU_OK\\\"}],\\\"max_tokens\\\":16}\""], decision="allow")
