prefix_rule(pattern=["/bin/zsh", "-lc", "set -a; source /Users/logan/.hermes/.env; set +a; for model in mistralai/mistral-small-2603 mistralai/mistral-medium-3-5 anthropic/claude-sonnet-4.6 openai/gpt-5.3-codex; do echo \"MODEL=$model\"; curl --max-time 30 -sS https://openrouter.ai/api/v1/chat/completions -H \"Authorization: Bearer $OPENROUTER_API_KEY\" -H \"Content-Type: application/json\" -d \"{\\\"model\\\":\\\"$model\\\",\\\"messages\\\":[{\\\"role\\\":\\\"user\\\",\\\"content\\\":\\\"Reply with exactly: RAW_MAC_OK\\\"}],\\\"max_tokens\\\":16}\" | /usr/bin/python3 -c \"import sys,json; data=json.load(sys.stdin); print(\\\"ERROR\\\", data.get(\\\"error\\\",{}).get(\\\"message\\\", data.get(\\\"error\\\"))) if \\\"error\\\" in data else print(\\\"OK\\\", data.get(\\\"model\\\"), data.get(\\\"choices\\\", [{}])[0].get(\\\"message\\\", {}).get(\\\"content\\\", \\\"\\\").strip())\"; done"], decision="allow")
prefix_rule(pattern=["openclaw", "agent"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "set -a; source /Users/logan/.hermes/.env; set +a; failures=0; total=0; for round in 1 2 3; do for model in mistralai/mistral-small-2603 mistralai/mistral-medium-3-5 anthropic/claude-sonnet-4.6 openai/gpt-5.3-codex; do total=$((total+1)); start=$(date +%s); out=$(curl --max-time 30 -sS https://openrouter.ai/api/v1/chat/completions -H \"Authorization: Bearer $OPENROUTER_API_KEY\" -H \"Content-Type: application/json\" -d \"{\\\"model\\\":\\\"$model\\\",\\\"messages\\\":[{\\\"role\\\":\\\"user\\\",\\\"content\\\":\\\"Reply with exactly: RAW_MAC_STABLE\\\"}],\\\"max_tokens\\\":16}\" 2>&1); rc=$?; elapsed=$(( $(date +%s) - start )); if [ $rc -ne 0 ]; then failures=$((failures+1)); echo \"RAW round=$round model=$model FAIL curl_rc=$rc elapsed=${elapsed}s\"; echo \"$out\" | head -c 240; echo; else parsed=$(printf \"%s\" \"$out\" | /usr/bin/python3 -c \"import sys,json; data=json.load(sys.stdin); print(\\\"ERROR::\\\"+str(data.get(\\\"error\\\",{}).get(\\\"message\\\",data.get(\\\"error\\\")))) if \\\"error\\\" in data else print(data.get(\\\"choices\\\",[{}])[0].get(\\\"message\\\",{}).get(\\\"content\\\",\\\"\\\").strip())\" 2>&1); if [ \"$parsed\" = \"RAW_MAC_STABLE\" ]; then echo \"RAW round=$round model=$model OK elapsed=${elapsed}s\"; else failures=$((failures+1)); echo \"RAW round=$round model=$model FAIL elapsed=${elapsed}s parsed=$parsed\"; fi; fi; done; done; echo \"RAW_SUMMARY total=$total failures=$failures\"; exit $failures"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "set -a; source /Users/logan/.hermes/.env; set +a; failures=0; total=0; model=openai/gpt-5.3-codex; for round in 1 2 3 4 5; do total=$((total+1)); start=$(date +%s); out=$(curl --max-time 30 -sS https://openrouter.ai/api/v1/chat/completions -H \"Authorization: Bearer $OPENROUTER_API_KEY\" -H \"Content-Type: application/json\" -d \"{\\\"model\\\":\\\"$model\\\",\\\"messages\\\":[{\\\"role\\\":\\\"user\\\",\\\"content\\\":\\\"Reply with exactly: RAW_MAC_STABLE\\\"}],\\\"max_tokens\\\":64}\" 2>&1); rc=$?; elapsed=$(( $(date +%s) - start )); if [ $rc -ne 0 ]; then failures=$((failures+1)); echo \"RAW_GPT round=$round FAIL curl_rc=$rc elapsed=${elapsed}s\"; echo \"$out\" | head -c 300; echo; else parsed=$(printf \"%s\" \"$out\" | /usr/bin/python3 -c \"import sys,json; data=json.load(sys.stdin); err=data.get(\\\"error\\\");\\nif err: print(\\\"ERROR::\\\"+str(err.get(\\\"message\\\",err))); sys.exit(0)\\nchoice=(data.get(\\\"choices\\\") or [{}])[0]; msg=choice.get(\\\"message\\\") or {}; print((msg.get(\\\"content\\\") or \\\"\\\").strip()+\\\" ::finish=\\\"+str(choice.get(\\\"finish_reason\\\")))\" 2>&1); case \"$parsed\" in RAW_MAC_STABLE*) echo \"RAW_GPT round=$round OK elapsed=${elapsed}s $parsed\" ;; *) failures=$((failures+1)); echo \"RAW_GPT round=$round FAIL elapsed=${elapsed}s parsed=$parsed\" ;; esac; fi; done; echo \"RAW_GPT_SUMMARY total=$total failures=$failures\"; exit $failures"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "set -a; source /Users/logan/.hermes/.env; set +a; failures=0; total=0; model=openai/gpt-5.3-codex; for round in 1 2 3 4 5; do total=$((total+1)); start=$(date +%s); out=$(curl --max-time 30 -sS https://openrouter.ai/api/v1/chat/completions -H \"Authorization: Bearer $OPENROUTER_API_KEY\" -H \"Content-Type: application/json\" -d \"{\\\"model\\\":\\\"$model\\\",\\\"messages\\\":[{\\\"role\\\":\\\"user\\\",\\\"content\\\":\\\"Reply with exactly: RAW_MAC_STABLE\\\"}],\\\"max_tokens\\\":64}\" 2>&1); rc=$?; elapsed=$(( $(date +%s) - start )); if [ $rc -ne 0 ]; then failures=$((failures+1)); echo \"RAW_GPT round=$round FAIL curl_rc=$rc elapsed=${elapsed}s\"; echo \"$out\" | head -c 300; echo; else parsed=$(printf \"%s\" \"$out\" | /usr/bin/python3 -c \"import sys,json; d=json.load(sys.stdin); e=d.get(\\\"error\\\"); c=(d.get(\\\"choices\\\") or [{}])[0]; m=c.get(\\\"message\\\") or {}; print((\\\"ERROR::\\\"+str(e.get(\\\"message\\\",e))) if e else ((m.get(\\\"content\\\") or \\\"\\\").strip()+\\\" ::finish=\\\"+str(c.get(\\\"finish_reason\\\"))))\" 2>&1); case \"$parsed\" in RAW_MAC_STABLE*) echo \"RAW_GPT round=$round OK elapsed=${elapsed}s $parsed\" ;; *) failures=$((failures+1)); echo \"RAW_GPT round=$round FAIL elapsed=${elapsed}s parsed=$parsed\" ;; esac; fi; done; echo \"RAW_GPT_SUMMARY total=$total failures=$failures\"; exit $failures"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "set -a; source /Users/logan/.hermes/.env; set +a; curl --max-time 20 -sS https://openrouter.ai/api/v1/chat/completions -H \"Authorization: Bearer $OPENROUTER_API_KEY\" -H \"Content-Type: application/json\" -d \"{\\\"model\\\":\\\"mistralai/mistral-medium-3-5\\\",\\\"messages\\\":[{\\\"role\\\":\\\"user\\\",\\\"content\\\":\\\"Reply with exactly: RAW_AFTER_HERMES_OK\\\"}],\\\"max_tokens\\\":32}\" | /usr/bin/python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get(\\\"error\\\") or (d.get(\\\"choices\\\") or [{}])[0].get(\\\"message\\\",{}).get(\\\"content\\\"))\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "failures=0; total=0; for round in 2 3; do total=$((total+1)); expected=\"OPENCLAW_STABLE_$round\"; start=$(date +%s); out=$(openclaw agent --agent main --message \"Reply with exactly: $expected\" --json --timeout 120 2>&1); rc=$?; elapsed=$(( $(date +%s) - start )); parsed=$(printf \"%s\" \"$out\" | /usr/bin/python3 -c \"import sys,json; s=sys.stdin.read();\\ntry:\\n d=json.loads(s); text=(d.get(\\\"result\\\",{}).get(\\\"payloads\\\") or [{}])[0].get(\\\"text\\\"); meta=d.get(\\\"result\\\",{}).get(\\\"meta\\\",{}).get(\\\"agentMeta\\\",{}); print(str(d.get(\\\"status\\\"))+\\\"|\\\"+str(meta.get(\\\"provider\\\"))+\\\"|\\\"+str(meta.get(\\\"model\\\"))+\\\"|\\\"+str(text))\\nexcept Exception as e:\\n print(\\\"PARSE_FAIL|\\\"+s[-500:])\" 2>&1); case \"$parsed\" in \"ok|openrouter|\"*\"|$expected\") echo \"OPENCLAW round=$round OK elapsed=${elapsed}s $parsed\" ;; *) failures=$((failures+1)); echo \"OPENCLAW round=$round FAIL rc=$rc elapsed=${elapsed}s parsed=$parsed\" ;; esac; done; echo \"OPENCLAW_SUMMARY total=$total failures=$failures\"; exit $failures"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "failures=0; total=0; for round in 2 3; do total=$((total+1)); expected=\"OPENCLAW_STABLE_$round\"; start=$(date +%s); out=$(openclaw agent --agent main --message \"Reply with exactly: $expected\" --json --timeout 120 2>&1); rc=$?; elapsed=$(( $(date +%s) - start )); if [ $rc -ne 0 ]; then failures=$((failures+1)); echo \"OPENCLAW round=$round FAIL rc=$rc elapsed=${elapsed}s tail=$(printf \"%s\" \"$out\" | tail -c 300)\"; continue; fi; parsed=$(printf \"%s\" \"$out\" | /usr/bin/python3 -c \"import sys,json; d=json.load(sys.stdin); text=(d.get(\\\"result\\\",{}).get(\\\"payloads\\\") or [{}])[0].get(\\\"text\\\"); meta=d.get(\\\"result\\\",{}).get(\\\"meta\\\",{}).get(\\\"agentMeta\\\",{}); print(str(d.get(\\\"status\\\"))+\\\"|\\\"+str(meta.get(\\\"provider\\\"))+\\\"|\\\"+str(meta.get(\\\"model\\\"))+\\\"|\\\"+str(text))\" 2>&1); case \"$parsed\" in \"ok|openrouter|\"*\"|$expected\") echo \"OPENCLAW round=$round OK elapsed=${elapsed}s $parsed\" ;; *) failures=$((failures+1)); echo \"OPENCLAW round=$round FAIL rc=$rc elapsed=${elapsed}s parsed=$parsed\" ;; esac; done; echo \"OPENCLAW_SUMMARY total=$total failures=$failures\"; exit $failures"], decision="allow")
