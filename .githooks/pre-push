#!/usr/bin/env sh
# .githooks/pre-push — secret range-gate (gitleaks + trufflehog) then LFS
# transfer. Fails CLOSED: missing engine, scan error, or findings all block.
#
# Protocol: git feeds lines "<local ref> <local oid> <remote ref> <remote oid>"
# on stdin. `git lfs pre-push` consumes the SAME stdin format, so stdin is
# buffered once here and replayed for LFS at the end. A remote oid of all
# zeros means the remote ref is being created.
set -u

ZERO=0000000000000000000000000000000000000000
fail() { printf >&2 'pre-push: %s\n' "$*"; exit 1; }

command -v gitleaks   >/dev/null 2>&1 || fail 'gitleaks not on PATH - secret gate fails closed; push blocked.'
command -v trufflehog >/dev/null 2>&1 || fail 'trufflehog not on PATH - secret gate fails closed; push blocked.'
command -v git-lfs    >/dev/null 2>&1 || fail 'git-lfs not on PATH - LFS transfer gate fails closed; push blocked.'

refs=$(cat)
[ -n "$refs" ] || exit 0    # nothing to push

blocked=0
while IFS=' ' read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "$local_ref" ] || continue
  [ "$local_oid" = "$ZERO" ] && continue   # deleting a remote ref: nothing to scan

  if [ "$remote_oid" = "$ZERO" ] || ! git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
    # New remote ref (or remote tip unknown locally): bound by origin refs.
    logopts="$local_oid --not --remotes=origin"
    default=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || echo refs/remotes/origin/main)
    base=$(git merge-base "$local_oid" "$default" 2>/dev/null || echo "$default")
  else
    logopts="$remote_oid..$local_oid"
    base=$remote_oid
  fi

  # --- Gate 1: gitleaks scans the full outgoing commit RANGE (offline) ---
  if ! gitleaks git --log-opts "$logopts" --redact --verbose --no-color --no-banner; then
    printf >&2 'pre-push: gitleaks flagged %s (range: %s). Values redacted above.\n' "$local_ref" "$logopts"
    blocked=1
  fi

  # --- Gate 2: trufflehog verified, FILESYSTEM mode over the changed files -
  # `trufflehog git` clones this 84k-file/13GB repo per run (5 min+, proven
  # non-viable); filesystem mode scans the CHANGED files' tip content in ~1s
  # and still verifies against provider APIs. Gate 1 already covers the full
  # history, so a secret that appeared then vanished mid-range is still caught
  # by gitleaks. We gate on verified (live) + unknown (verification errored /
  # offline = fail closed). Findings are detected by emitted JSON (not exit
  # code); --fail-on-scan-errors makes only genuine scan errors non-zero,
  # which we treat as fail-closed. -z/xargs -0 keeps space/unicode paths safe.
  th_out=$(git diff -z --name-only --diff-filter=ACMRT "$base" "$local_oid" 2>/dev/null \
    | xargs -0 -r trufflehog filesystem --results=verified,unknown --json \
        --no-update --fail-on-scan-errors 2>/dev/null)
  th_rc=$?
  if [ "$th_rc" -ne 0 ]; then
    printf >&2 'pre-push: trufflehog scan error (exit %s) on %s - fail closed.\n' "$th_rc" "$local_ref"
    blocked=1
  elif printf '%s' "$th_out" | grep -q '"DetectorName"'; then
    printf >&2 'pre-push: trufflehog found verified/unknown secret(s) on %s:\n' "$local_ref"
    printf '%s\n' "$th_out" | grep -oiE '"file":"[^"]*"' | sort -u | sed 's/^/  /' >&2
    blocked=1
  fi
done <<EOF
$refs
EOF

[ "$blocked" -eq 0 ] || fail 'secret gate(s) failed - push blocked. Fix findings; do not bypass hooks.'

# --- Gate 3: LFS object transfer (replay the original stdin) ------------
printf '%s\n' "$refs" | git lfs pre-push "$@"
exit $?
