#!/bin/sh
set -eu

# Pre-push safety plus explicit LFS object upload. This avoids GitHub Desktop's
# stock LFS pre-push /dev/stdin path on Windows while still ensuring objects exist upstream.

upstream=$(git rev-parse --verify '@{u}' 2>/dev/null || true)
if [ -z "$upstream" ]; then
  printf >&2 '%s\n' 'pre-push: no upstream ref; cannot run push-range safety checks.'
  printf >&2 '%s\n' 'Set the upstream or push once from a controlled terminal after running the guards manually.'
  exit 1
fi

printf >&2 '%s\n' 'pre-push: checking secret patterns for commits not on upstream'
git diff --name-only -z --diff-filter=ACMR "$upstream"...HEAD | python .github/scripts/check_secret_patterns.py --paths-from-stdin

printf >&2 '%s\n' 'pre-push: checking large-file policy for commits not on upstream'
git diff --name-only -z --diff-filter=ACMR "$upstream"...HEAD | python .github/scripts/check_large_files.py --paths-from-stdin

printf >&2 '%s\n' "pre-push: uploading LFS objects for HEAD to $1"
git lfs push "$1" HEAD
