#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || { printf >&2 '%s\n' 'pre-commit: cannot find repository root.'; exit 2; }
cd "$repo_root" || { printf >&2 '%s\n' "pre-commit: cannot enter repository root: $repo_root"; exit 2; }
PYTHON=python

"$PYTHON" .github/scripts/check_secret_patterns.py --staged
"$PYTHON" .github/scripts/check_large_files.py --staged

nbs=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ipynb')
if [ -n "$nbs" ]; then
  if ! "$PYTHON" -c "import jupytext" >/dev/null 2>&1; then
    printf >&2 '%s\n' 'jupytext is required to validate staged paired notebooks.'
    printf >&2 '%s\n' 'Install jupytext, then run jupytext --sync for the staged notebook(s) and stage the results.'
    exit 1
  fi

  oldifs=$IFS
  IFS='
'
  set -f
  # shellcheck disable=SC2086
  set -- $nbs
  set +f
  IFS=$oldifs

  twins=$("$PYTHON" .github/scripts/jupytext_sync_paired.py "$@") || exit 1
  if [ -n "$twins" ]; then
    printf >&2 '%s\n' 'Paired notebook sync produced or touched twin files. Stage the notebook and twin files, then commit again:'
    printf >&2 '%s\n' "$twins"
    exit 1
  fi
fi
