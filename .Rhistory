#Comparing Woodwinds and Brass 2 sample proportion test
test.2prop=function(x1,x2,n1,n2,alt,alpha) {
phat1=x1/n1; qhat1=1-phat1; phat2=x2/n2; qhat2=1-phat2; pt.est=phat1-phat2
pooled.phat=(x1+x2)/(n1+n2); pooled.qhat=1-pooled.phat
se=sqrt((pooled.phat*pooled.qhat)*(1/n1+1/n2)); zcalc=pt.est/se
alpha=alpha; alt=alt; sig=sprintf("%.0f%%",alpha*100)
if(alt=='g'){
pvalue=pnorm(zcalc,lower.tail=F)
}    else if(alt=='l'){
pvalue=pnorm(zcalc)
}    else if(alt=='ne'){
pvalue=2*pnorm(-abs(zcalc))
}
cat(" ","\n","Hypothesis Test for 2-sample proportion of Woodwinds and Brass","\n","p1 =",phat1,"p2 =",phat2,"\n","Point Estimate of p1-p2 =",pt.est,"\n",
"Pooled p =",pooled.phat,"SE =",se,"\n","Alternative hypothesis =",alt,"Significance Level =",sig,"\n",
"\n","Zcalc =",zcalc,"\n","pvalue =",pvalue,"\n")
results=list(phat1=phat1,n1=n1,phat2=phat2,n2=n2,pt.est=pt.est,pooled.phat=pooled.phat,
se=se,alt=alt,zcalc=zcalc,pvalue=pvalue)
}
# a
# H0: p1=p2 Ha: p1>p2
test.2prop(x1=5,x2=8,n1=30,n2=30,alt='g',0.05)
chisq.test(VMB)
test.2prop(x1=5,x2=8,n1=30,n2=30,alt='g',0.05)
VMB
chisq.test(table(VMB))
band <- as.table(rbind(c(5,25), c(8,22),c(9,21)))
instrument=c("Woodwind","Brass","Percussion"); major=c("Music Major","Non-Music Major")
dimnames(band) <- list(Instrument.Type=instrument,Academic.Major=major)
band
naame=as.matrix(band)
# row totals
n1j=sum(band[1,]); n2j=sum(band[2,]); n3j=sum(band[3,]); n123j=c(n1j,n2j,n3j)
# column totals
ni1=sum(band[,1]); ni2=sum(band[,2]); ni3=sum(band[,3]); ni123=c(ni1,ni2,ni3)
# grand total
n=sum(band)
# Expected value for row1,col1
exp11 <- round((n1j*ni1)/n,2); exp11
exp=round((ni123 %*% t(n123j))/n,2)
dimnames(exp) <- list(Instrument.Type=instrument,Academic.Major=major)
expt=matrix(exp,ncol=3,byrow=T)
# barplot of data (barplot since data is categorical)
barplot(band,names.arg=rownames(band),col=rainbow(9),ylab="Observed",ylim=c(0,225))
title('Condition by Pricing (obs)')
barplot(exp,names.arg=rownames(band),col=rainbow(9),ylab="Expected",ylim=c(0,225))
title('Condition by Pricing (exp)')
# barplot with obs and exp
counts <- rbind(naame,expt)
barplot(counts,legend=rownames(band),beside=T,ylim=c(0,225))
title('Condition by Pricing Obs and Exp')
# long way without chisq.test()
chisq.calc <- round(sum((naame-expt)^2/expt),3); chisq.calc
pvalue <- 1-pchisq(chisq.calc,4); pvalue
# with chisq.test()
indep=chisq.test(band); indep
indep$expected
gas <- as.table(rbind(c(5,25), c(8,22),c(9,21)))
cond=c("Substandard","Standard","Modern"); price=c("Aggressive","Neutral", "Nonaggressive")
dimnames(gas) <- list(Condition=cond,Pricing.Policy=price)
gas
gaspr=as.matrix(gas)
# row totals
n1j=sum(gas[1,]); n2j=sum(gas[2,]); n3j=sum(gas[3,]); n123j=c(n1j,n2j,n3j)
# column totals
ni1=sum(gas[,1]); ni2=sum(gas[,2]); ni3=sum(gas[,3]); ni123=c(ni1,ni2,ni3)
# grand total
n=sum(gas)
# Expected value for row1,col1
exp11 <- round((n1j*ni1)/n,2); exp11
exp=round((ni123 %*% t(n123j))/n,2)
dimnames(exp) <- list(Condition=cond,Pricing.Policy=price)
expt=matrix(exp,ncol=3,byrow=T)
# barplot of data (barplot since data is categorical)
barplot(gas,names.arg=rownames(gas),col=rainbow(9),ylab="Observed",ylim=c(0,225))
title('Condition by Pricing (obs)')
barplot(exp,names.arg=rownames(gas),col=rainbow(9),ylab="Expected",ylim=c(0,225))
title('Condition by Pricing (exp)')
# barplot with obs and exp
counts <- rbind(gaspr,expt)
barplot(counts,legend=rownames(gas),beside=T,ylim=c(0,225))
