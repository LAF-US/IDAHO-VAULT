eys by surface with Logan-approved caps and audit logging.\n","numLines":237,"startLine":1,"totalLines":237}},"sourceToolAssistantUUID":"7849c794-f4a6-4779-b411-f4834caefea1","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/logan","sessionId":"4f03d270-3e64-41cc-b325-30871ab76d55","version":"2.1.202","gitBranch":"HEAD","slug":"your-18-entry-list-is-cached-gadget"}
